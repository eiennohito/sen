import { AuthPhase, DetailAction, NotificationPreview, Section, SettingsSection, AuthState, ConversationState, DetailState, SettingsState, ShellState, ViewerState } from "globals.slint";
import { Dialog, FocusRing, Button } from "button.slint";
import { FocusOpener } from "types.slint";
import { RowText } from "list-row.slint";
import { ComboBox, CheckBox } from "preferences.slint";
import { ScrollView } from "std-widgets.slint";
import { Tokens } from "tokens.slint";
import { Detail } from "detail.slint";
import { IconButton } from "icon-button.slint";

component SettingsSections inherits FocusScope {
    in-out property <SettingsSection> current;
    property <[SettingsSection]> pages: [SettingsSection.chats, SettingsSection.notifications, SettingsSection.background, SettingsSection.shortcuts, SettingsSection.about, SettingsSection.account];
    property <int> index: root.current == SettingsSection.chats ? 0 : root.current == SettingsSection.notifications ? 1 : root.current == SettingsSection.background ? 2 : root.current == SettingsSection.shortcuts ? 3 : root.current == SettingsSection.about ? 4 : 5;
    property <length> row-height: max(36px, Tokens.small * 1.5 + 16px);
    preferred-height: 6 * root.row-height;
    accessible-role: tab-list; accessible-label: "Settings section";
    key-pressed(event) => {
        if event.text == Key.UpArrow || event.text == Key.LeftArrow { root.current = root.pages[max(0, root.index - 1)]; return accept; }
        if event.text == Key.DownArrow || event.text == Key.RightArrow { root.current = root.pages[min(5, root.index + 1)]; return accept; }
        if event.text == Key.Home { root.current = SettingsSection.chats; return accept; }
        if event.text == Key.End { root.current = SettingsSection.account; return accept; }
        reject
    }
    for section[i] in ["Chats", "Notifications", "Background", "Shortcuts", "About", "Account"]: Rectangle {
        x: 0px;
        y: i * root.row-height;
        width: root.width; height: root.row-height - 4px;
        border-radius: 8px; background: root.current == root.pages[i] ? Tokens.surface-selected : touch.has-hover ? Tokens.surface-hover : transparent;
        FocusRing { focused: root.has-focus && root.current == root.pages[i]; border-radius: 8px; border-color: Tokens.accent; }
        accessible-role: tab; accessible-label: section;
        accessible-item-selectable: true; accessible-item-selected: root.current == root.pages[i];
        accessible-action-default => { root.current = root.pages[i]; root.focus(); }
        RowText { x: 8px; width: parent.width - 16px; height: parent.height; text: section; font-size: Tokens.small; color: Tokens.text; vertical-alignment: center; }
        touch := TouchArea { mouse-cursor: pointer; clicked => { root.current = root.pages[i]; root.focus(); } }
    }
}

export component Layers inherits Rectangle {
    property <bool> cancel-confirm;
    private property <bool> viewer-focused: viewer-close.has-focus || zoom-out.has-focus || zoom-in.has-focus || viewer-fit.has-focus || original-size.has-focus || viewer-save.has-focus || viewer-open-external.has-focus || viewer-previous.has-focus || viewer-next.has-focus;
    property <float> viewer-zoom: 1;
    property <int> detail-depth: DetailState.detail-depth;
    changed detail-depth => { if root.detail-depth == 0 { DetailState.detail-dialog = DetailAction.none; } }
    property <string> unsend-feedback-id: ConversationState.unsend-feedback-id;
    changed unsend-feedback-id => { if root.unsend-feedback-id != "" { unsend-feedback-timer.running = true; unsend-feedback-timer.restart(); } }
    unsend-feedback-timer := Timer { interval: 3s; running: false; triggered => { self.running = false; ConversationState.unsend-feedback-id = ""; } }
    property <string> reaction-error-id: ConversationState.reaction-error-id;
    changed reaction-error-id => { if root.reaction-error-id != "" { reaction-error-timer.running = true; reaction-error-timer.restart(); } }
    reaction-error-timer := Timer { interval: 4s; running: false; triggered => { self.running = false; ConversationState.reaction-error-id = ""; } }
    Timer { interval: 5s; running: ViewerState.viewer-save-status != "" && !ViewerState.viewer-saving; triggered => { ViewerState.viewer-save-status = ""; } }
    property <SettingsSection> settings-section;
    property <bool> auth-visible: AuthState.auth-open;
    changed auth-visible => { if !self.auth-visible { root.cancel-confirm = false; } }
    property <bool> approval-busy: AuthState.auth-busy;
    changed approval-busy => { if !self.approval-busy && root.cancel-confirm { root.cancel-confirm = false; root.focus-auth(); } }
    public function dismiss-auth() {
        if (AuthState.auth-phase == AuthPhase.cancelling) { return; }
        if AuthState.auth-busy { root.cancel-confirm = true; keep-waiting.focus(); }
        else { AuthState.close-sign-in(); }
    }
    Dialog {
        full-window: true; visible: AuthState.auth-open;
        dismissed => { root.dismiss-auth(); }
        VerticalLayout {
            x: (parent.width - self.width) / 2; y: max(24px, (parent.height - self.preferred-height) / 2);
            width: min(360px, parent.width - 32px); height: self.preferred-height;
            spacing: 16px; alignment: start;
            Text { text: "閃"; font-size: Tokens.heading + 8px; font-weight: 800; color: Tokens.accent; horizontal-alignment: center; }
            Text { text: "Sign in"; font-size: Tokens.heading; font-weight: 600; horizontal-alignment: center; }
            Text { text: AuthState.auth-prerequisite-missing ? "Sign-in needs a supported LINE for Chrome installation." : "Scan the code with LINE on your phone."; color: Tokens.secondary; font-size: Tokens.small; horizontal-alignment: center; wrap: word-wrap; }
            if AuthState.auth-qr.width > 0: HorizontalLayout { alignment: center;
                Rectangle { width: 252px; height: 252px; background: white; border-radius: 12px;
                    Image { x: 16px; y: 16px; width: 220px; height: 220px; source: AuthState.auth-qr; image-fit: contain; accessible-role: image; accessible-label: "Scan this QR code with LINE on your phone"; }
                }
            }
            Text { text: AuthState.status; horizontal-alignment: center; color: Tokens.text; wrap: word-wrap; }
            if AuthState.auth-error != "": Text { text: AuthState.auth-error; wrap: word-wrap; color: Tokens.danger; horizontal-alignment: center; }
            HorizontalLayout { alignment: center; spacing: 8px;
                auth-back := Button { text: (AuthState.auth-phase == AuthPhase.cancelling) ? "Cancelling…" : "Back"; text-button: true; enabled: !(AuthState.auth-phase == AuthPhase.cancelling); clicked => { root.dismiss-auth(); } }
                auth-start := Button { text: AuthState.auth-prerequisite-missing ? "Check again" : AuthState.auth-error != "" ? "Try again" : "Start"; primary: true; enabled: !AuthState.auth-busy; clicked => { AuthState.start-sign-in(); } }
            }
            Text { text: "Signing in here signs LINE out in Chrome."; color: Tokens.secondary; font-size: Tokens.small; horizontal-alignment: center; wrap: word-wrap; }
        }
    }

    Dialog {
        visible: SettingsState.logout-open;
        panel-width: min(440px, root.width - 32px);
        dismissed => { if !SettingsState.logout-busy { SettingsState.logout-open = false; settings-section.focus(); } }
        VerticalLayout {
            padding: 24px; spacing: 16px;
            Text { text: "Log out?"; font-size: Tokens.heading; font-weight: 700; }
            Text { text: "This device will sign out of LINE. Drafts and chat history stay on this computer for when you sign in to this account again."; wrap: word-wrap; }
            CheckBox { wrap-text: true; text: "Also delete this account's chats and drafts from this computer"; checked <=> SettingsState.logout-delete-data; enabled: !SettingsState.logout-busy; }
            HorizontalLayout { alignment: end; spacing: 8px;
                logout-cancel := Button { text: "Cancel"; enabled: !SettingsState.logout-busy;
                    clicked => { SettingsState.logout-open = false; settings-section.focus(); }
                }
                Button { text: "Log out"; danger: true; primary: true; enabled: !SettingsState.logout-busy;
                    clicked => { SettingsState.confirm-logout(); }
                }
            }
        }
    }
    profile := Rectangle {
        x: ShellState.profile-sheet ? (ShellState.narrow ? 0px : ShellState.rail-width + ShellState.browser-width) : parent.width - ShellState.panel-width;
        width: ShellState.profile-sheet ? parent.width - self.x : ShellState.panel-width; height: parent.height;
        visible: DetailState.detail-open && !AuthState.auth-open && !ViewerState.viewer-open; background: Tokens.background;
        TouchArea { scroll-event(event) => { accept } }
        border-width: 1px; border-color: Tokens.border;
        detail := Detail { }
    }
    Dialog {
        visible: SettingsState.settings-open && !SettingsState.logout-open && !AuthState.auth-open && !ViewerState.viewer-open;
        panel-width: min(640px, root.width - 32px);
        panel-height: min(root.height - 32px, settings-title.height + 56px + max(settings-section.preferred-height, settings-content.preferred-height));
        shadow: true;
        dismissed => { SettingsState.close-settings(); }
        settings-dialog := VerticalLayout {
            padding: 24px; spacing: 16px;
            settings-title := HorizontalLayout {
                height: max(settings-heading.preferred-height, settings-close.height);
                settings-heading := Text { text: "Settings"; font-size: Tokens.heading; font-weight: 700; vertical-alignment: center; }
                settings-close := IconButton { label: "Close settings"; icon: @image-url("../assets/icons/close.svg"); activated => { SettingsState.close-settings(); } }
            }
            Rectangle {
                settings-section := SettingsSections {
                    x: 0px; y: 0px;
                    current <=> root.settings-section;
                    width: ShellState.narrow ? 104px : max(132px, Tokens.small * 7.5);
                    height: self.preferred-height;
                }
                ScrollView {
                    x: settings-section.width + 16px;
                    y: 0px;
                    width: parent.width - self.x; height: parent.height - self.y;
                    horizontal-scrollbar-policy: always-off;
                    content-width: self.width;
                    settings-content := VerticalLayout {
                        padding-right: 12px; spacing: 0px; alignment: start;
                        if root.settings-section == SettingsSection.account: VerticalLayout {
                            spacing: 12px;
                            Text { text: "Account"; font-weight: 600; }
                            logout-open := Button { text: "Log out…"; danger: true; enabled: ShellState.account-mid != "";
                                clicked => { SettingsState.logout-delete-data = false; SettingsState.logout-open = true; logout-cancel.focus(); }
                            }
                        }
                        if root.settings-section == SettingsSection.chats: VerticalLayout {
                            spacing: 12px;
                            Text { text: "Message text size"; }
                            text-size := ComboBox {
                                accessible-label: "Message text size";
                                model: ["Small", "Default", "Large", "Extra large"];
                                current-index: SettingsState.text-size-index;
                                selected(value) => { SettingsState.text-size = SettingsState.text-sizes[value]; SettingsState.settings-changed(); }
                            }
                            if ShellState.storage-error != "": Text { text: ShellState.storage-error; wrap: word-wrap; color: Tokens.danger; }
                            enter-sends := CheckBox { text: "Enter sends"; checked <=> SettingsState.enter-sends; toggled => { SettingsState.settings-changed(); } }
                        }
                        if root.settings-section == SettingsSection.notifications: VerticalLayout {
                            spacing: 12px;
                            CheckBox { text: "Desktop notifications"; checked <=> SettingsState.notifications-enabled; toggled => { SettingsState.settings-changed(); } }
                            if SettingsState.notifications-paused: Text { text: "Notifications are paused from the tray."; wrap: word-wrap; color: Tokens.secondary; }
                            Text { text: "Preview"; }
                            ComboBox {
                                accessible-label: "Notification preview";
                                model: ["Name and text", "Name only", "New message only"];
                                current-index: SettingsState.notification-preview == NotificationPreview.name-and-text ? 0 : SettingsState.notification-preview == NotificationPreview.name-only ? 1 : 2;
                                selected(value) => { SettingsState.notification-preview = value == 0 ? NotificationPreview.name-and-text : value == 1 ? NotificationPreview.name-only : NotificationPreview.new-message; SettingsState.settings-changed(); }
                            }
                            CheckBox { text: "Notification sound"; checked <=> SettingsState.notification-sound; toggled => { SettingsState.settings-changed(); } }
                            CheckBox { text: "Mentions in muted chats"; checked <=> SettingsState.notification-mention-exception; toggled => { SettingsState.settings-changed(); } }
                            CheckBox { text: "Group events"; checked <=> SettingsState.notification-group-events; toggled => { SettingsState.settings-changed(); } }
                            notification-test := Button { text: "Send test notification"; clicked => { SettingsState.test-notification(); } }
                            if !SettingsState.notification-available: Text { text: "Notification service not available"; color: Tokens.secondary; wrap: word-wrap; }
                            if SettingsState.notification-status != "": Text { text: SettingsState.notification-status; wrap: word-wrap; }
                        }
                        if root.settings-section == SettingsSection.background: VerticalLayout {
                            spacing: 12px;
                            CheckBox { text: "Keep running in background"; checked <=> SettingsState.background-mode; toggled => { SettingsState.settings-changed(); } }
                            Text { text: "Closing 閃 hides it to the desktop tray. Notifications and sync continue until you choose Quit."; wrap: word-wrap; color: Tokens.secondary; }
                            if SettingsState.background-status != "": Text { text: SettingsState.background-status; wrap: word-wrap; color: Tokens.secondary; }
                            autostart-control := CheckBox { text: "Start 閃 at login"; checked <=> SettingsState.autostart; toggled => { SettingsState.settings-changed(); } }
                            if SettingsState.autostart-status != "": Text { text: SettingsState.autostart-status; wrap: word-wrap; color: Tokens.secondary; }
                        }
                        if root.settings-section == SettingsSection.shortcuts: Text { text: "Ctrl+Enter  Send\nEnter  Newline, or Send with Enter sends\nShift+Enter  Always newline\nEscape  Close layer or clear search\nCtrl+F  Search\nCtrl+1  Friends\nCtrl+2  Chats\nAlt+↑ / Alt+↓  Previous / next chat\nAlt+←  Back\nF6  Connection actions\nCtrl+Q  Quit"; wrap: word-wrap; }
                        if root.settings-section == SettingsSection.about: VerticalLayout {
                            spacing: 12px;
                            Text { text: "閃"; font-size: Tokens.heading; }
                            if (ShellState.account-mid != ""): Button { text: ShellState.account-name; text-button: true; clicked => { DetailState.open-profile(ShellState.account-mid); } }
                            Text { text: "Native desktop client · 0.1.0"; wrap: word-wrap; color: Tokens.secondary; }
                        }
                    }
                }
            }
        }
    }
    Dialog {
        full-window: true; visible: ViewerState.viewer-open;
        changed visible => { if self.visible { root.focus-viewer(); } }
        dismissed => { ViewerState.close-viewer(); }
        key-pressed(event) => {
            if event.text == "+" || event.text == "=" { root.zoom(1.25, viewport.width / 2, viewport.height / 2); return accept; }
            if event.text == "-" { root.zoom(0.8, viewport.width / 2, viewport.height / 2); return accept; }
            if event.text == "0" { root.fit-photo(); return accept; }
            if event.text == "1" { root.original-photo(); return accept; }
            if event.text == Key.LeftArrow { ViewerState.viewer-step(-1); root.focus-viewer(); return accept; }
            if event.text == Key.RightArrow { ViewerState.viewer-step(1); root.focus-viewer(); return accept; }

            reject
        }
        viewport := Rectangle {
            width: parent.width; height: parent.height; background: Tokens.viewer-bg;
            clip: true;
            property <float> fit: min(self.width / max(1px, ViewerState.viewer-image.width * 1px), self.height / max(1px, ViewerState.viewer-image.height * 1px));
            property <length> photo-width: ViewerState.viewer-image.width * 1px * self.fit * root.viewer-zoom;
            property <length> photo-height: ViewerState.viewer-image.height * 1px * self.fit * root.viewer-zoom;
            Image {
                source: ViewerState.viewer-image; accessible-role: image; accessible-label: "Photo in viewer";
                width: viewport.photo-width;
                height: viewport.photo-height;
                x: (parent.width - viewport.photo-width) / 2 + root.shown-pan-x;
                y: (parent.height - viewport.photo-height) / 2 + root.shown-pan-y;
                image-fit: contain;
                animate x, y, width, height { duration: viewer-pointer.pressed ? 0ms : 120ms; easing: ease-out; }
            }
            viewer-pointer := TouchArea {
                property <length> drag-x;
                property <length> drag-y;
                property <length> start-x;
                property <length> start-y;
                mouse-cursor: self.pressed ? grabbing : grab;
                scroll-event(event) => { root.zoom(event.delta-y > 0px ? 1.2 : 1 / 1.2, self.mouse-x, self.mouse-y); accept }
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                        self.drag-x = self.mouse-x; self.drag-y = self.mouse-y;
                        self.start-x = root.shown-pan-x; self.start-y = root.shown-pan-y;
                    }
                }
                moved => { if self.pressed { root.pan-x = self.start-x + self.mouse-x - self.drag-x; root.pan-y = self.start-y + self.mouse-y - self.drag-y; } }
            }
        }
        Rectangle { x: 0px; y: 0px; width: parent.width; height: 80px; background: @linear-gradient(180deg, #000000BB, #00000000); }
        HorizontalLayout { x: 16px; y: 12px; width: parent.width - 32px; height: 40px; spacing: 8px;
            viewer-close := IconButton { label: "Close photo"; icon: @image-url("../assets/icons/close.svg"); icon-color: white; activated => { ViewerState.close-viewer(); } }
            Text { text: ViewerState.viewer-status; color: white; font-size: Tokens.small; overflow: elide; vertical-alignment: center; }
            zoom-out := IconButton { label: "Zoom out"; icon: @image-url("../assets/icons/zoom-out.svg"); icon-color: white; enabled: root.viewer-zoom > 0.1; activated => { root.zoom(0.8, viewport.width / 2, viewport.height / 2); } }
            zoom-in := IconButton { label: "Zoom in"; icon: @image-url("../assets/icons/zoom-in.svg"); icon-color: white; enabled: root.viewer-zoom < 24; activated => { root.zoom(1.25, viewport.width / 2, viewport.height / 2); } }
            viewer-fit := IconButton { label: "Fit"; icon: @image-url("../assets/icons/fit.svg"); icon-color: white; activated => { root.fit-photo(); } }
            original-size := IconButton { label: "Original size"; icon: @image-url("../assets/icons/actual-size.svg"); icon-color: white; activated => { root.original-photo(); } }
            viewer-save := IconButton { label: "Save photo"; icon: @image-url("../assets/icons/save.svg"); icon-color: white; enabled: !ViewerState.viewer-saving && !ViewerState.viewer-loading && ViewerState.viewer-error == "" && ViewerState.viewer-image.width > 0; activated => { ViewerState.save-photo(); } }
            viewer-open-external := IconButton { label: "Open in default viewer"; icon: @image-url("../assets/icons/open-external.svg"); icon-color: white; enabled: !ViewerState.viewer-opening && !ViewerState.viewer-loading && ViewerState.viewer-error == "" && ViewerState.viewer-image.width > 0; activated => { ViewerState.open-photo-externally(); } }
        }
        viewer-previous := IconButton { x: 16px; y: (parent.height - 40px) / 2; width: 40px; height: 40px; border-radius: 20px; background: Tokens.surface-2; label: "Previous"; icon: @image-url("../assets/icons/previous.svg"); icon-color: white; visible: ViewerState.viewer-has-previous; enabled: self.visible; activated => { ViewerState.viewer-step(-1); root.focus-viewer(); } }
        viewer-next := IconButton { x: parent.width - 56px; y: (parent.height - 40px) / 2; width: 40px; height: 40px; border-radius: 20px; background: Tokens.surface-2; label: "Next"; icon: @image-url("../assets/icons/next.svg"); icon-color: white; visible: ViewerState.viewer-has-next; enabled: self.visible; activated => { ViewerState.viewer-step(1); root.focus-viewer(); } }
        VerticalLayout { x: 16px; y: parent.height - self.preferred-height - 16px; width: parent.width - 32px; height: self.preferred-height; alignment: start;
            if ViewerState.viewer-error != "": Text { text: ViewerState.viewer-error; wrap: word-wrap; color: Tokens.danger; }
            if ViewerState.viewer-retryable: Button { text: "Retry"; init => { if ViewerState.viewer-open && root.viewer-focused { self.focus(); } } activated => { ViewerState.retry-original(); root.focus-viewer(); } }
            if ViewerState.viewer-save-status != "": Text { text: ViewerState.viewer-save-status; wrap: word-wrap; color: white; }
        }
    }
    Dialog {
        visible: root.cancel-confirm && AuthState.auth-open;
        panel-height: min(320px, root.height - 32px); shadow: true;
        dismissed => { root.cancel-confirm = false; auth-back.focus(); }
        VerticalLayout {
            padding: 20px; spacing: 12px;
            Text { text: "Cancel sign-in?"; font-size: Tokens.heading; }
            Text { text: "The current sign-in attempt will stop."; wrap: word-wrap; }
            HorizontalLayout {
                alignment: end; spacing: 8px;
                keep-waiting := Button { text: "Keep waiting"; clicked => { root.cancel-confirm = false; auth-back.focus(); } }
                confirm-cancel := Button { text: "Cancel sign-in"; primary: true; danger: true; clicked => { root.cancel-confirm = false; AuthState.cancel-sign-in(); } }
            }
        }
    }
    Dialog {
        visible: DetailState.detail-open && !AuthState.auth-open && !ViewerState.viewer-open && DetailState.detail-dialog != DetailAction.none;
        dismissed => { DetailState.detail-dialog = DetailAction.none; detail.focus-action(); }
        dialog-content := VerticalLayout { padding: 24px; spacing: 16px;
            HorizontalLayout { dialog-title := Text { text: DetailState.detail-dialog == DetailAction.leave ? "Leave group?" : DetailState.action-text(DetailState.detail-dialog, DetailAction.none); font-size: Tokens.heading; }
                dialog-close := IconButton { label: "Close dialog"; icon: @image-url("../assets/icons/close.svg"); activated => { DetailState.detail-dialog = DetailAction.none; detail.focus-action(); } }
            }
            if DetailState.detail-dialog == DetailAction.rename: VerticalLayout { spacing: 16px;
                Rectangle {
                    height: 36px; border-radius: 8px; background: Tokens.surface-2;
                    rename-value := TextInput { text: DetailState.profile-name; init => { self.focus(); } x: 12px; y: 8px; width: parent.width - 24px; height: parent.height - 16px; single-line: true; font-size: Tokens.base; color: Tokens.text; accessible-label: "Name"; }
                    FocusRing { outset: 4px; text-entry: true; focused: rename-value.has-focus; }
                }
                HorizontalLayout { alignment: end; spacing: 8px;
                    Button { text: "Cancel"; clicked => { DetailState.detail-dialog = DetailAction.none; detail.focus-action(); } }
                    Button { text: "Save"; primary: true; clicked => { DetailState.detail-action(DetailAction.rename, rename-value.text); DetailState.detail-dialog = DetailAction.none; detail.focus-first(); } }
                }
            }
            if DetailState.detail-dialog == DetailAction.edit-name || DetailState.detail-dialog == DetailAction.edit-status: profile-editor := VerticalLayout { spacing: 12px;
                property <DetailAction> action: DetailState.detail-dialog;
                function save() { if !DetailState.detail-busy && DetailState.profile-edit-valid(self.action, profile-value.text) { DetailState.detail-action(self.action, profile-value.text); } }
                Rectangle {
                    height: 36px; border-radius: 8px; background: Tokens.surface-2;
                    profile-value := TextInput { text: DetailState.profile-name; init => { self.focus(); } enabled: !DetailState.detail-busy; x: 12px; y: 8px; width: parent.width - 24px; height: parent.height - 16px; single-line: true; font-size: Tokens.base; color: Tokens.text; accessible-label: "Name";
                        edited => { self.text = DetailState.profile-edit-value(DetailState.detail-dialog, self.text); }
                        accepted => { profile-editor.save(); }
                        states [ status when DetailState.detail-dialog == DetailAction.edit-status: { text: DetailState.profile-status; accessible-label: "Status message"; } ]
                    }
                    FocusRing { outset: 4px; text-entry: true; focused: profile-value.has-focus; }
                }
                Text { text: "(" + DetailState.profile-edit-count(profile-value.text) + "/" + DetailState.profile-edit-limit(DetailState.detail-dialog) + ")"; color: Tokens.secondary; horizontal-alignment: right; }
                if DetailState.detail-error != "": Text { text: DetailState.detail-error; color: Tokens.danger; wrap: word-wrap; }
                HorizontalLayout { alignment: end; spacing: 8px;
                    Button { text: "Cancel"; clicked => { DetailState.detail-dialog = DetailAction.none; detail.focus-action(); } }
                    Button { text: "Save"; primary: true; enabled: !DetailState.detail-busy && DetailState.profile-edit-valid(DetailState.detail-dialog, profile-value.text); clicked => { profile-editor.save(); } }
                }
            }
            if DetailState.detail-dialog == DetailAction.leave: VerticalLayout { spacing: 16px;
                Text { text: "You will no longer receive messages in this group."; wrap: word-wrap; }
                HorizontalLayout { alignment: end; spacing: 8px;
                    Button { text: "Cancel"; init => { self.focus(); } clicked => { DetailState.detail-dialog = DetailAction.none; detail.focus-action(); } }
                    Button { text: "Leave"; primary: true; danger: true; clicked => { DetailState.detail-action(DetailAction.leave, ""); DetailState.detail-dialog = DetailAction.none; detail.focus-first(); } }
                }
            }
        }
    }
    property <length> pan-x;
    property <length> pan-y;
    property <length> shown-pan-x: clamp(root.pan-x, -max(0px, (viewport.photo-width - viewport.width) / 2), max(0px, (viewport.photo-width - viewport.width) / 2));
    property <length> shown-pan-y: clamp(root.pan-y, -max(0px, (viewport.photo-height - viewport.height) / 2), max(0px, (viewport.photo-height - viewport.height) / 2));
    public function zoom(factor: float, px: length, py: length) {
        let x = root.shown-pan-x; let y = root.shown-pan-y;
        let previous = root.viewer-zoom;
        root.viewer-zoom = max(0.1, min(24, previous * factor));
        let ratio = root.viewer-zoom / previous;
        root.pan-x = px - viewport.width / 2 - (px - viewport.width / 2 - x) * ratio;
        root.pan-y = py - viewport.height / 2 - (py - viewport.height / 2 - y) * ratio;
    }
    public function fit-photo() { root.viewer-zoom = 1; root.pan-x = 0px; root.pan-y = 0px; }
    public function original-photo() { root.viewer-zoom = max(0.1, min(24, 1 / max(0.001, viewport.fit))); root.pan-x = 0px; root.pan-y = 0px; }
    out property <bool> editing: DetailState.detail-open && detail.editing;
    out property <bool> detail-focused: DetailState.detail-open && detail.focus-opener() != FocusOpener.none;
    public function focus-opener() -> FocusOpener { return detail.focus-opener(); }
    public function restore-opener(opener: FocusOpener) { detail.restore-opener(opener); }
    public function focus-profile-close() { detail.focus-open(); }
    public function focus-settings() { root.settings-section = SettingsSection.chats; settings-close.focus(); }
    public function focus-auth() { if AuthState.auth-busy { auth-back.focus(); } else { auth-start.focus(); } }
    public function focus-viewer() { viewer-close.focus(); }
    public function reset-viewer() { root.fit-photo(); ViewerState.viewer-save-status = ""; }
}
