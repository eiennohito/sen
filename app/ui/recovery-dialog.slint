import { IconButton } from "icon-button.slint";
import { Button } from "button.slint";

import { State } from "state.slint";
import { Tokens } from "tokens.slint";

export component RecoveryDialog inherits Rectangle {
    visible: State.recovery-kind != "";
    width: 100%; height: 100%;
    background: Tokens.scrim;
    TouchArea { }
    property <bool> opened: State.recovery-kind != "";
    changed opened => { if self.opened { cancel.focus(); } }
    FocusScope {
        key-pressed(event) => {
            if !State.ime-active && event.text == Key.Tab {
                if event.modifiers.shift && cancel.has-focus { if State.recovery-kind == "edit" { append.focus(); } else { resend.focus(); } return accept; }
                if !event.modifiers.shift && (append.has-focus || resend.has-focus) { cancel.focus(); return accept; }
            }
            if !State.ime-active && event.text == Key.Escape { State.resolve-recovery("cancel"); return accept; }
            reject
        }
        Rectangle {
            width: min(400px, parent.width - 32px);
            height: content.preferred-height;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: Tokens.bg; border-radius: 12px; drop-shadow-color: #00000033; drop-shadow-blur: 16px; drop-shadow-offset-y: 4px; border-width: 1px; border-color: Tokens.border;
            content := VerticalLayout {
                padding: 24px; spacing: 12px;
                HorizontalLayout { spacing: 8px;
                Text { text: State.recovery-kind == "unsend" ? "Unsend message?" : State.recovery-kind == "resend" ? "Send again?" : "Use message text?"; font-size: Tokens.heading; wrap: word-wrap; }
                IconButton { label: "Close dialog"; icon: @image-url("../assets/icons/close.svg"); activated => { State.resolve-recovery("cancel"); } }
                }
                Text { text: State.recovery-kind == "unsend" ? "It will be removed for everyone." : State.recovery-kind == "resend" ? "The message may already have arrived. Sending again could create a duplicate." : "There is already a draft in this conversation. Replace it or append this message?"; color: Tokens.foreground; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px; alignment: end;
                    cancel := Button { text: "Cancel"; clicked => { State.resolve-recovery("cancel"); } }
                    replace := Button { visible: State.recovery-kind == "edit"; enabled: self.visible; text: "Replace"; clicked => { State.resolve-recovery("replace"); } }
                    append := Button { visible: State.recovery-kind == "edit"; enabled: self.visible; text: "Append"; primary: true; clicked => { State.resolve-recovery("append"); } }
                    resend := Button { visible: State.recovery-kind == "resend" || State.recovery-kind == "unsend"; enabled: self.visible; text: State.recovery-kind == "unsend" ? "Unsend" : "Resend"; primary: true; danger: State.recovery-kind == "unsend"; clicked => { State.resolve-recovery(State.recovery-kind); } }
                }
            }
        }
    }
}
