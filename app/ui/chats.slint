import { EmptyState } from "empty-state.slint";
import { Avatar } from "avatar.slint";
import { Button } from "button.slint";
import { LineEdit, TextEdit, ScrollView, ListView, ComboBox } from "std-widgets.slint";
import { State } from "state.slint";
import { Tokens } from "tokens.slint";
import { ChatRow, FriendRow, MessageRow, ReactionRow } from "types.slint";
import { IconButton } from "icon-button.slint";
import { FeedbackRect } from "connection-notice.slint";
import { Pane } from "scrollpane.slint";
import { PreviewLine } from "preview-line.slint";
import { SearchField } from "search-field.slint";

export component Chats inherits Rectangle {
    visible: State.section == 0;
    out property <bool> has-focus: search.contains-focus || chips-focus.has-focus || list-focus.has-focus;
    public function scroll(delta: length) { chat-list.scroll(delta); }
    public function jump(y: length) { chat-list.jump(y); }
    out property <FeedbackRect> first-row-bounds: { x: chat-list.absolute-position.x, y: chat-list.absolute-position.y + chat-list.visible-top + State.list-y, width: root.visible && (!State.narrow || !State.show-conversation) && State.section == 0 && State.chats.length > 0 ? chat-list.visible-width : 0px, height: State.chat-row-height };
    out property <FeedbackRect> visible-first-row-bounds: {
        x: root.first-row-bounds.x,
        y: max(root.first-row-bounds.y, chat-list.absolute-position.y + chat-list.visible-top),
        width: root.first-row-bounds.width,
        height: max(0px, min(root.first-row-bounds.y + root.first-row-bounds.height, chat-list.absolute-position.y + chat-list.height) - max(root.first-row-bounds.y, chat-list.absolute-position.y + chat-list.visible-top))
    };
    out property <length> viewport-height: chat-list.visible-height;
    changed viewport-height => { State.chat-list-height = root.viewport-height; }
    property <length> reveal-y;
    // Slint's virtual list estimates a distant seek at a row boundary first.
    // Apply the requested pixel offset again after that layout has settled.
    reveal-settle := Timer { interval: 0ms; triggered => { chat-list.jump(root.reveal-y); } }
    public function reveal(index: int) {
        chat-list.jump(State.list-y);
        let top = index * State.chat-row-height;
        let bottom = top + State.chat-row-height;
        let extent = max(0px, State.chats.length * State.chat-row-height - chat-list.height) + chat-list.inset;
        let y = top + State.list-y < 0px ? -top : bottom + State.list-y > chat-list.visible-height ? chat-list.visible-height - bottom : State.list-y;
        root.reveal-y = max(-extent, min(0px, y));
        chat-list.jump(root.reveal-y);
        reveal-settle.restart();
    }
    public function focus-search-last() { chips-focus.focus(); }
    public function focus-list() { list-focus.focus(); }
    public function move-cursor(delta: int) {
        State.result-focus = max(0, min(State.chats.length - 1, State.result-focus + delta));
        chat-list.jump(-max(0px, State.result-focus * State.chat-row-height - chat-list.visible-height / 2));
    }
    public function open-result() {
        if State.result-focus >= 0 && State.result-focus < State.chats.length { State.select-chat(State.chats[State.result-focus].index); State.show-conversation = true; State.focus-composer(); }
    }
            VerticalLayout {
                y: 0px; height: parent.height; visible: State.section == 0;
                padding: 12px; spacing: 10px;
                HorizontalLayout {
                    height: 42px;
                    Text { text: "Chats"; color: Tokens.text; font-size: Tokens.heading; font-weight: 800; vertical-alignment: center; }
                    Text { width: State.narrow ? Tokens.small * 6.5 : 0px; horizontal-stretch: 0; text: State.narrow && State.retrying-connection && !State.connection-failed ? "Connecting…" : ""; color: Tokens.secondary; font-size: Tokens.small; overflow: elide; vertical-alignment: center; }
                    new-chat-button := IconButton { label: "New chat"; focus-description: "Focused"; key-pressed(event) => { if event.text == Key.Tab { if event.modifiers.shift { chips-focus.focus(); } else if State.narrow && State.connection-actions-enabled { State.focus-connection-first(); } else { list-focus.focus(); } return accept; } reject } icon: @image-url("../assets/icons/new-chat.svg"); activated => { State.open-new-chat(); } }
                }
                HorizontalLayout {
                    search := SearchField {
                        text <=> State.query;
                        placeholder-text: "Find a conversation";
                        label: "Find a conversation";
                        clear => { State.query = ""; State.search-changed(""); State.list-y = State.search-list-y; State.result-focus = -1; State.searching = false; State.focus-search(); }
                        edited(query) => {
                            if query != "" && !State.searching { State.search-list-y = State.list-y; State.searching = true; }
                            State.search-changed(query);
                            State.result-focus = -1;
                            if query == "" { State.list-y = State.search-list-y; State.searching = false; }
                        }
                        key-pressed(event) => {
                            if State.browser-key(event) == accept { return accept; }
                            if State.ime-active { return reject; }
                            if event.text == Key.Tab { if event.modifiers.shift { State.focus-settings-opener(); } else if State.narrow && !State.show-conversation && State.connection-actions-enabled { State.focus-connection-first(); } else { chips-focus.focus(); } return accept; }
                            if event.text == Key.Escape && State.query != "" {
                                State.query = ""; State.search-changed(""); State.list-y = State.search-list-y; State.result-focus = -1; State.searching = false; return accept;
                            }
                            if event.text == Key.DownArrow || event.text == Key.UpArrow { root.move-cursor(event.text == Key.DownArrow ? 1 : -1); return accept; }
                            if event.text == Key.Return { root.open-result(); return accept; }
                            reject
                        }
                    }
                }
                chips-focus := FocusScope {
                    property <int> cursor: State.category;
                    accessible-role: button; accessible-label: ["All", "Friends", "Groups"][self.cursor];
                    accessible-description: self.has-focus ? "Focused filter" : "";
                    key-pressed(event) => {
                        if State.ime-active { return reject; }
                        if event.text == Key.Tab { if event.modifiers.shift { search.focus-last(); } else { new-chat-button.focus-button(); } return accept; }
                        if event.text == Key.LeftArrow || event.text == Key.RightArrow { self.cursor = mod(self.cursor + (event.text == Key.RightArrow ? 1 : 2), 3); return accept; }
                        if event.text == Key.Return || event.text == " " { State.category = self.cursor; State.filter-category(); return accept; }
                        reject
                    }
                    HorizontalLayout {
                    spacing: 4px;
                    for category[i] in ["All", "Friends", "Groups"]: Rectangle {
                        height: 28px; border-radius: 14px;
                        background: State.category == i ? Tokens.text : Tokens.surface-2;
                        border-width: chips-focus.has-focus && chips-focus.cursor == i ? 2px : 0px; border-color: (chips-focus.has-focus && chips-focus.cursor == i) || State.category == i ? Tokens.accent : Tokens.border;
                        accessible-role: button; accessible-label: category;
                        accessible-item-selectable: true; accessible-item-selected: State.category == i;
                        accessible-action-default => { chips-focus.cursor = i; chips-focus.focus(); State.category = i; State.filter-category(); }
                        Text { text: category; color: State.category == i ? Tokens.bg : Tokens.text; font-size: Tokens.small; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { mouse-cursor: pointer; clicked => { chips-focus.cursor = i; chips-focus.focus(); State.category = i; State.filter-category(); } }
                    }
                }
                }
                list-focus := FocusScope {
                    accessible-role: list; accessible-label: "Conversations";
                    accessible-description: self.has-focus ? "Focused conversations" : "";
                    key-pressed(event) => {
                        if State.browser-key(event) == accept { return accept; }
                        if State.ime-active { return reject; }
                        if event.text == Key.Tab { if event.modifiers.shift { if State.narrow && State.connection-actions-enabled { State.focus-sign-in-opener(); } else { new-chat-button.focus-button(); } } else { State.focus-after-browser(); } return accept; }
                        if event.text == Key.DownArrow || event.text == Key.UpArrow { root.move-cursor(event.text == Key.DownArrow ? 1 : -1); return accept; }
                        if event.text == Key.Home { State.result-focus = 0; chat-list.jump(0px); return accept; }
                        if event.text == Key.End { State.result-focus = State.chats.length - 1; chat-list.jump(-chat-list.extent); return accept; }
                        if event.text == Key.Return || event.text == " " { root.open-result(); return accept; }
                        reject
                    }
                chat-list := Pane {
                    connection-feedback: State.narrow && !State.show-conversation && State.section == 0 && !(State.detail-open && State.profile-sheet);
                    offset <=> State.list-y;
                    content-width: self.visible-width;
                virtual: true;
                virtual-height: chat-view.content-height;
                chat-view := ListView {
                    width: parent.width; height: parent.height;
                    content-y <=> State.list-y;
                    content-width: self.width;
                    vertical-scrollbar-policy: always-off;
                    horizontal-scrollbar-policy: always-off;
                    accessible-role: none;
for chat[i] in State.chats: Rectangle {
                        width: chat-list.visible-width; height: State.chat-row-height;
                        border-radius: 8px; clip: true;
                        background: chat.index == State.selected-chat ? Tokens.selection : row-touch.has-hover ? Tokens.chat-hover : transparent;
                        border-width: (list-focus.has-focus || search.has-focus) && i == State.result-focus ? 2px : 0px;
                        border-color: Tokens.accent;
                        Avatar { x: 8px; y: (parent.height - 44px) / 2; identity: chat.id; initial: chat.initial; picture: chat.avatar; }
                        Rectangle {
                            x: 64px; y: 10px; width: max(0px, parent.width - 76px); height: parent.height - 20px; clip: true;
                            time := Text { y: 3px; x: parent.width - self.width; max-width: parent.width * 0.55; text: chat.time; color: Tokens.secondary; font-size: Tokens.time; horizontal-alignment: right; overflow: elide; }
                            name := Text { x: 0px; y: 0px; width: max(0px, parent.width - time.width - (chat.muted ? 24px : 8px)); height: State.text-size * 1.5px; text: chat.title; color: Tokens.text; font-weight: 600; overflow: elide; wrap: no-wrap; }
                            if chat.muted: Image { x: name.width + 4px; y: 3px; width: 16px; height: 16px; source: @image-url("../assets/icons/muted.svg"); colorize: Tokens.secondary; accessible-role: image; accessible-label: "Muted"; }
                            preview := Rectangle {
                                x: 0px; y: name.height + 2px; width: max(0px, parent.width - markers.width - 4px); height: max(0px, parent.height - self.y);
                                if chat.draft || chat.preview-runs.length == 0: Text { width: parent.width; height: parent.height; text: chat.draft ? "Draft: " + chat.draft-preview : (chat.outgoing-preview ? "You: " : "") + chat.preview; color: Tokens.secondary; font-size: Tokens.preview; wrap: no-wrap; overflow: elide; }
                                if !chat.draft && chat.preview-runs.length > 0 && i * State.chat-row-height + State.list-y + State.chat-row-height >= 0px && i * State.chat-row-height + State.list-y <= chat-list.visible-height: PreviewLine {
                                    width: parent.width; height: parent.height; runs: chat.preview-runs;
                                    prefix: chat.outgoing-preview ? "You: " : "";
                                    text-color: Tokens.secondary;
                                }
                            }
                            markers := HorizontalLayout {
                                x: parent.width - self.width; y: name.height + 2px; spacing: 4px; width: (chat.draft ? 20px : 0px) + (chat.failed ? 20px : 0px) + (chat.muted ? 20px : 0px) + (chat.unread > 0 || chat.unread-unknown ? 36px : 0px); height: 20px;
                                if !chat.failed && (chat.unread > 0 || chat.unread-unknown): Rectangle { width: chat.unread-unknown ? 8px : 32px; height: chat.unread-unknown ? 8px : 20px; border-radius: self.height / 2; background: chat.muted ? Tokens.secondary : Tokens.accent; Text { visible: !chat.unread-unknown; text: chat.unread > 999 ? "999+" : "" + chat.unread; color: Tokens.on-accent; font-size: Tokens.small; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; } }
                                if chat.draft: Image { source: @image-url("../assets/icons/draft.svg"); colorize: Tokens.accent; width: 16px; height: 16px; accessible-role: image; accessible-label: "Draft"; }
                                if chat.failed: Image { source: @image-url("../assets/icons/error.svg"); colorize: Tokens.danger; width: 16px; height: 16px; accessible-role: image; accessible-label: "Send failed"; }

                            }
                        }
                        accessible-role: button;
                        accessible-item-selectable: true;
                        accessible-item-selected: chat.index == State.selected-chat;
                        accessible-label: chat.title + (chat.time != "" ? ", " + chat.time : "") + ", " + (chat.draft ? "Draft: " + chat.draft-preview : (chat.outgoing-preview ? "You: " : "") + chat.preview) + (chat.unread-unknown ? ", Unread count unavailable" : chat.unread > 0 ? ", " + chat.unread + " unread" : "") + (chat.failed ? ", Send failed" : "") + (chat.muted ? ", Muted" : "");
                        accessible-action-default => { State.result-focus = i; root.open-result(); }
                        row-touch := TouchArea {
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.cancel { State.list-pressed = false; State.list-release-pending = true; }
                                else if event.button == PointerEventButton.left {
                                    if event.kind == PointerEventKind.down { State.list-pressed = true; }
                                    else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel { State.list-pressed = false; State.list-release-pending = true; }
                                }
                            }
                            clicked => { State.result-focus = i; root.open-result(); } }
                    }
                }

                }
                }
                if State.more-chats: Button { text: "Load more"; clicked => { State.more(); } }

            }
    if State.chats.length == 0: EmptyState { signed-out: !State.has-account; y: 160px; height: max(0px, parent.height - 160px); text: State.query == "" ? "No conversations yet" : "No results"; icon: State.query == "" ? @image-url("../assets/icons/chats.svg") : @image-url("../assets/icons/search.svg"); }
    public function focus-search() { search.focus(); }
}
