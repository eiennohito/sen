import { FocusRing } from "button.slint";
import { ListRow, RowText } from "list-row.slint";
import { EmptyState } from "empty-state.slint";
import { State } from "state.slint";
import { Tokens } from "tokens.slint";
import { Pane } from "scrollpane.slint";
import { SearchField } from "search-field.slint";
export component Friends inherits Rectangle {
    out property <bool> has-focus: friend-search.contains-focus || list-focus.has-focus;
    visible: State.section == 1;
    public function focus-search() { friend-search.focus(); }
    public function focus-search-last() { friend-search.focus-last(); }
    public function focus-list() { list-focus.focus(); }
    public function move-cursor(delta: int) {
        State.friend-result = max(0, min(State.friends.length - 1, State.friend-result + delta));
    }
    public function activate() {
        if State.friend-result < 0 || State.friend-result >= State.friends.length { return; }
        if State.friends[State.friend-result].header {
            if State.friends[State.friend-result].group { State.groups-expanded = !State.groups-expanded; }
            else { State.friends-expanded = !State.friends-expanded; }
            State.filter-friends();
        } else { State.open-profile(State.friends[State.friend-result].id); }
    }
    VerticalLayout {
        padding: 12px; spacing: 8px;
        HorizontalLayout {
            Text { text: "Friends"; font-size: Tokens.heading; color: Tokens.text; font-weight: 700; }
        }
        HorizontalLayout {
            friend-search := SearchField {
                text <=> State.friend-query; placeholder-text: "Search friends and groups";
                label: "Search friends and groups";
                clear => { State.friend-query = ""; State.filter-friends(); friend-search.focus(); }
                edited => { State.filter-friends(); }
                key-pressed(event) => {
                    if State.ime-active { return reject; }
                    if event.text == Key.Tab { if event.modifiers.shift { State.focus-settings-opener(); } else if State.narrow && State.connection-actions-enabled { State.focus-connection-first(); } else { list-focus.focus(); } return accept; }
                    if event.text == Key.DownArrow || event.text == Key.UpArrow { root.move-cursor(event.text == Key.DownArrow ? 1 : -1); return accept; }
                    if event.text == Key.Return { root.activate(); return accept; }
                    if event.text == Key.Escape && State.friend-query != "" { State.friend-query = ""; State.filter-friends(); return accept; }
                    reject
                }
            }
        }
        if State.friends-error != "": Text { text: State.friends-error; color: Tokens.danger; font-size: Tokens.small; wrap: word-wrap; }
        list-focus := FocusScope {
            accessible-role: list; accessible-label: "Friends and groups";
            key-pressed(event) => {
                if State.ime-active { return reject; }
                if event.text == Key.Tab { if event.modifiers.shift { if State.narrow && State.connection-actions-enabled { State.focus-sign-in-opener(); } else { friend-search.focus-last(); } } else { State.focus-after-browser(); } return accept; }
                if event.text == Key.DownArrow || event.text == Key.UpArrow { root.move-cursor(event.text == Key.DownArrow ? 1 : -1); return accept; }
                if event.text == Key.Home { State.friend-result = 0; friend-list.jump(0px); return accept; }
                if event.text == Key.End { State.friend-result = State.friends.length - 1; friend-list.jump(-friend-list.extent); return accept; }
                if event.text == Key.Return || event.text == " " { root.activate(); return accept; }
                reject
            }
            friend-list := Pane {
                connection-feedback: State.narrow && !State.show-conversation && State.section == 1 && !(State.detail-open && State.profile-sheet);
                offset <=> State.friends-y;
                VerticalLayout {
                    spacing: 0px;
                    for friend[i] in State.friends: Rectangle {
                        width: friend-list.visible-width; height: self.preferred-height;
                        property <bool> selected: State.friend-result == i;
                        changed selected => { if self.selected { friend-list.centre(self.y); } }
                        VerticalLayout {
                            spacing: 0px;
                            if !friend.header: ListRow {
                                identity: friend.id; initial: friend.initial; avatar: friend.avatar; title: friend.name; subtitle: friend.status; subtitle-runs: friend.status-runs;
                                height: self.row-height;
                            }
                            if friend.header: RowText { x: 8px; width: parent.width - 44px; color: Tokens.secondary; font-size: Tokens.small; height: max(68px, self.preferred-height); vertical-alignment: center; font-weight: 600; text: friend.name + " " + friend.count; }
                        }
                        states [ hovered when row-touch.has-hover: { background: Tokens.surface-hover; in-out { animate background { duration: 100ms; } } } ]
                        border-radius: 8px;
                        FocusRing { focused: (list-focus.has-focus || friend-search.has-focus) && State.friend-result == i; border-radius: 8px; border-color: Tokens.accent; }
                        accessible-role: button; accessible-label: friend.header ? friend.name : "Open profile: " + friend.name;
                        accessible-expandable: friend.header;
                        accessible-expanded: friend.header && (friend.group ? State.groups-expanded : State.friends-expanded);
                        accessible-action-default => { State.friend-result = i; root.activate(); }
                        if friend.header: Image {
                            x: parent.width - 28px; y: (parent.height - 20px) / 2; width: 20px; height: 20px;
                            source: (friend.group ? State.groups-expanded : State.friends-expanded) ? @image-url("../assets/icons/chevron-down.svg") : @image-url("../assets/icons/chevron.svg");
                            colorize: Tokens.foreground;
                        }
                        row-touch := TouchArea { mouse-cursor: pointer; clicked => { list-focus.focus(); State.friend-result = i; root.activate(); } }
                    }
                }
            }
        }
    }
    if State.friends.length == 0: EmptyState { signed-out: !State.has-account; y: 100px; height: max(0px, parent.height - 100px); text: State.friend-query != "" ? "No results" : "No friends yet"; icon: State.friend-query == "" ? @image-url("../assets/icons/friends.svg") : @image-url("../assets/icons/search.svg"); }
}
