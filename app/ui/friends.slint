import { Button, LineEdit } from "std-widgets.slint";
import { State } from "state.slint";
import { Tokens } from "tokens.slint";
import { Pane } from "scrollpane.slint";
import { IconButton } from "icon-button.slint";
export component Friends inherits Rectangle {
    visible: State.section == 1;
    public function focus-search() { friend-search.focus(); }
    public function focus-list() { list-focus.focus(); }
    public function move-cursor(delta: int) {
        State.friend-result = max(0, min(State.friends.length - 1, State.friend-result + delta));
        if friend-search.has-focus && State.friend-result >= 0 && State.friend-result < State.friends.length && State.friends[State.friend-result].header {
            State.friend-result = max(0, min(State.friends.length - 1, State.friend-result + (delta >= 0 ? 1 : -1)));
        }
        friend-list.jump(-max(0px, State.friend-result * State.friend-row-height - friend-list.height / 2));
    }
    public function activate() {
        if State.friend-result < 0 || State.friend-result >= State.friends.length { return; }
        if State.friends[State.friend-result].header {
            if State.friends[State.friend-result].group { State.groups-expanded = !State.groups-expanded; }
            else { State.friends-expanded = !State.friends-expanded; }
            State.filter-friends();
        } else { State.open-profile(State.friends[State.friend-result].id); }
    }
    VerticalLayout {
        padding: 12px; spacing: 8px;
        HorizontalLayout {
            Text { text: "Friends"; font-size: Tokens.heading; color: Tokens.accent; font-weight: 700; }
            IconButton { label: "Refresh friends"; icon: @image-url("../assets/icons/refresh.svg"); enabled: !State.loading-friends && State.connected; activated => { State.refresh-friends(); } }
        }
        HorizontalLayout {
            friend-search := LineEdit {
                text <=> State.friend-query; placeholder-text: "Search friends and groups";
                accessible-label: "Search loaded friends and groups";
                edited => { State.filter-friends(); }
                key-pressed(event) => {
                    if State.browser-key(event) == accept { return accept; }
                    if State.ime-active { return reject; }
                    if event.text == Key.Tab { if event.modifiers.shift { State.focus-settings-opener(); } else { list-focus.focus(); } return accept; }
                    if event.text == Key.DownArrow || event.text == Key.UpArrow { root.move-cursor(event.text == Key.DownArrow ? 1 : -1); return accept; }
                    if event.text == Key.Return { root.activate(); return accept; }
                    if event.text == Key.Escape && State.friend-query != "" { State.friend-query = ""; State.filter-friends(); return accept; }
                    reject
                }
            }
            Button { text: "Clear"; enabled: State.friend-query != ""; clicked => { State.friend-query = ""; State.filter-friends(); friend-search.focus(); } }
        }
        if State.friend-query != "" && State.friends.length <= 2: Text { text: "No match among loaded friends and groups"; wrap: word-wrap; }
        list-focus := FocusScope {
            accessible-role: list; accessible-label: "Friends and groups"; accessible-description: self.has-focus ? "Focused friends and groups" : "";
            key-pressed(event) => {
                if State.browser-key(event) == accept { return accept; }
                if State.ime-active { return reject; }
                if event.text == Key.Tab { if event.modifiers.shift { friend-search.focus(); } else if State.narrow && !State.show-conversation { State.focus-settings-opener(); } else { State.focus-history(); } return accept; }
                if event.text == Key.DownArrow || event.text == Key.UpArrow { root.move-cursor(event.text == Key.DownArrow ? 1 : -1); return accept; }
                if event.text == Key.Home { State.friend-result = 0; friend-list.jump(0px); return accept; }
                if event.text == Key.End { State.friend-result = State.friends.length - 1; friend-list.jump(-friend-list.extent); return accept; }
                if event.text == Key.Return || event.text == " " { root.activate(); return accept; }
                reject
            }
            friend-list := Pane {
                offset <=> State.friends-y;
                VerticalLayout {
                    spacing: 0px;
                    for friend[i] in State.friends: Rectangle {
                        width: friend-list.visible-width; height: State.friend-row-height;
                        background: row-touch.has-hover ? Tokens.surface : transparent;
                        border-width: (list-focus.has-focus || friend-search.has-focus) && State.friend-result == i ? 2px : 0px;
                        border-color: Tokens.accent; border-radius: 6px;
                        accessible-role: button;
                        accessible-label: friend.header ? friend.name + (friend.group ? State.groups-expanded ? " ▾" : " ▸" : State.friends-expanded ? " ▾" : " ▸") : "Open profile: " + friend.name;
                        accessible-action-default => { State.friend-result = i; root.activate(); }
                        if friend.header: Text { x: 8px; width: parent.width - 16px; height: parent.height; vertical-alignment: center; font-weight: 600; text: friend.name + (friend.group ? State.groups-expanded ? " ▾" : " ▸" : State.friends-expanded ? " ▾" : " ▸"); }
                        if !friend.header: Rectangle {
                            x: 8px; y: (parent.height - 40px) / 2; width: 40px; height: 40px; border-radius: 20px; background: Tokens.selection;
                            Text { width: 100%; height: 100%; text: friend.name; overflow: elide; color: Tokens.selection-foreground; horizontal-alignment: center; vertical-alignment: center; visible: friend.avatar.width == 0; }
                            Image { width: 100%; height: 100%; source: friend.avatar; image-fit: contain; }
                        }
                        if !friend.header: VerticalLayout {
                            x: 60px; y: 8px; width: max(0px, parent.width - 68px); height: parent.height - 16px; spacing: 4px; alignment: center;
                            Text { text: friend.name; color: Tokens.foreground; font-weight: 600; overflow: elide; wrap: no-wrap; }
                            Text { text: friend.status; color: Tokens.secondary; font-size: Tokens.preview; overflow: elide; wrap: no-wrap; }
                        }
                        row-touch := TouchArea { mouse-cursor: pointer; clicked => { list-focus.focus(); State.friend-result = i; root.activate(); } }
                    }
                }
            }
        }
        if State.loading-friends: Text { text: "Loading friends and groups…"; color: Tokens.secondary; }
        if State.friends-error != "": HorizontalLayout { Text { text: State.friends-error; color: Tokens.danger; wrap: word-wrap; } Button { text: "Retry"; clicked => { State.refresh-friends(); } } }
    }
}
