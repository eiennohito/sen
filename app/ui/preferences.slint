import { Pressable, FocusRing } from "button.slint";
import { RowText } from "list-row.slint";
import { Tokens } from "tokens.slint";
export component CheckBox inherits Pressable {
    in property <string> text;
    in property <bool> indicator-only;
    in property <bool> wrap-text;
    in-out property <bool> checked;
    callback toggled();
    min-height: max(32px, label.preferred-height);
    preferred-height: self.min-height;
    vertical-stretch: 0;
    accessible-role: checkbox; accessible-label: root.text; accessible-checked: root.checked;
    key-event(event) => { event.text == Key.Return ? accept : reject }
    activated => { root.checked = !root.checked; root.toggled(); }
    indicator := Rectangle { x: 0px; y: (root.height - self.height) / 2; width: 20px; height: 20px; border-radius: 4px; background: (root.checked ? Tokens.accent : Tokens.surface-2).transparentize(root.dimming);
        Image { x: 2px; y: 2px; width: 16px; height: 16px; source: @image-url("../assets/icons/check.svg"); colorize: Tokens.on-accent.transparentize(root.dimming); visible: root.checked; }
    }
    label := RowText { wrap: root.wrap-text ? word-wrap : no-wrap; x: 28px; width: max(0px, root.width - 28px); height: root.height; text: root.text; font-size: Tokens.base; color: Tokens.text.transparentize(root.dimming); vertical-alignment: center; }
    states [ row when root.indicator-only: { indicator.x: root.width - 28px; label.visible: false; label.text: ""; ring.outset: 0px; } ]
    ring := FocusRing { outset: 4px; focused: root.has-focus; border-radius: 8px; }
}
export component ComboBox inherits Pressable {
    in property <[string]> model;
    in property <int> current-index;
    callback selected(int);
    height: 36px; border-radius: 8px; background: Tokens.surface-2;
    accessible-role: combobox; accessible-value: root.model[root.current-index];
    public function select(index: int) { root.selected(max(0, min(root.model.length - 1, index))); }
    RowText { x: 12px; width: parent.width - 48px; height: parent.height; text: root.model[root.current-index]; color: Tokens.text.transparentize(root.dimming); font-size: Tokens.base; vertical-alignment: center; }
    Image { x: parent.width - 32px; y: 10px; width: 16px; height: 16px; source: @image-url("../assets/icons/down.svg"); colorize: Tokens.secondary.transparentize(root.dimming); }
    FocusRing { outset: 4px; focused: root.has-focus; }
    activated => { popup.show(); }
    key-event(event) => {
            if event.text == Key.UpArrow { root.select(root.current-index - 1); return accept; }
            if event.text == Key.DownArrow { root.select(root.current-index + 1); return accept; }
            if event.text == Key.Home { root.select(0); return accept; }
            if event.text == Key.End { root.select(root.model.length - 1); return accept; }
            reject
    }
    popup := PopupWindow { y: root.height + 4px; width: root.width; height: root.model.length * 32px + 8px;
        Rectangle { background: Tokens.bg; border-radius: 8px; border-width: 1px; border-color: Tokens.divider;
            VerticalLayout { padding: 4px;
                for option[i] in root.model: Rectangle { height: 32px; border-radius: 4px; background: touch.has-hover ? Tokens.surface-hover : i == root.current-index ? Tokens.surface-selected : transparent;
                    RowText { x: 12px; width: parent.width - 24px; height: parent.height; text: option; color: Tokens.text; font-size: Tokens.base; vertical-alignment: center; }
                    touch := TouchArea { accessible-role: button; accessible-label: option; accessible-action-default => { root.select(i); popup.close(); root.focus(); } clicked => { root.select(i); popup.close(); root.focus(); } }
                }
            }
        }
    }
}
