import { Button, LineEdit, TextEdit, ScrollView, ComboBox } from "std-widgets.slint";
import { State } from "state.slint";
import { Tokens } from "tokens.slint";
import { ChatRow, FriendRow, MessageRow, ReactionRow } from "types.slint";
import { IconButton } from "icon-button.slint";
import { Pane } from "scrollpane.slint";
import { Message } from "message.slint";
import { FeedbackRect } from "connection-notice.slint";
import { Composer } from "composer.slint";

component HistoryPill inherits Rectangle {
    in property <string> text;
    in property <string> label: root.text;
    in property <bool> enabled;
    callback activated();
    callback traversed(bool);
    public function focus-pill() { focus.focus(); }
    preferred-width: root.visible ? label.preferred-width + 16px : 0px; preferred-height: root.visible ? max(32px, label.preferred-height + 12px) : 0px;
    border-radius: self.height / 2; background: touch.has-hover ? Tokens.selection : Tokens.background;
    border-width: focus.has-focus ? 2px : 1px; border-color: focus.has-focus ? Tokens.accent : Tokens.border;
    label := Text { x: 8px; width: parent.width - 16px; height: parent.height; text: root.text; font-size: Tokens.small; color: Tokens.foreground; horizontal-alignment: center; vertical-alignment: center; overflow: elide; accessible-role: none; }
    focus := FocusScope {
        enabled: root.enabled; accessible-role: button; accessible-label: root.label;
        accessible-action-default => { root.activated(); }
        key-pressed(event) => {
            if State.ime-active { return reject; }
            if State.browser-key(event) == accept { return accept; }
            if event.text == Key.Tab { root.traversed(event.modifiers.shift); return accept; }
            if event.text == Key.Return || event.text == " " { root.activated(); return accept; }
            reject
        }
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.activated(); } }
}

export component Conversation inherits Rectangle {
    out property <FeedbackRect> older-retry-bounds: { x: older-retry.absolute-position.x, y: older-retry.absolute-position.y, width: root.visible && State.older-failed && State.has-chat ? older-retry.width : 0px, height: older-retry.height };
    out property <FeedbackRect> header-bounds: { x: header.absolute-position.x, y: header.absolute-position.y, width: root.visible ? header.width : 0px, height: header.height };
    out property <FeedbackRect> feedback-bounds: history-feedback.visible ? { x: history-feedback.absolute-position.x, y: history-feedback.absolute-position.y, width: history-feedback.width, height: history-feedback.height } : { x: 0px, y: 0px, width: 0px, height: 0px };
    out property <FeedbackRect> composer-bounds: { x: composer-surface.absolute-position.x, y: composer-surface.absolute-position.y, width: root.visible ? composer-surface.width : 0px, height: composer-surface.height };
    property <bool> latest-visible: !State.following && State.has-chat;
    property <string> latest-label: State.history-needs-refresh ? "Latest · updates available" : State.new-count > 0 ? "Latest · " + State.new-count + " new" : "Latest";

          visible: !State.narrow || State.show-conversation;
          VerticalLayout {
            spacing: 0px;
            header := Rectangle {
                height: max(64px, Tokens.heading * 1.4 + 28px) + (State.chat-subtitle != "" ? Tokens.small * 1.4 + 5px : 0px) + (State.unread-locating || State.unread-boundary-unknown ? Tokens.small * 1.4 + 5px : 0px); background: Tokens.surface;
                FocusScope {
                    key-pressed(event) => {
                        if event.text == Key.Tab && !event.modifiers.shift && State.narrow && !State.ime-active {
                            if State.connection-failed && State.connection-feedback-visible { State.focus-connection-first(); } else { history-focus.focus(); }
                            return accept;
                        }
                        reject
                    }
                VerticalLayout {
                    padding: 14px; spacing: 5px;
                    HorizontalLayout {
                        back-button := IconButton { visible: State.narrow; enabled: State.narrow; width: State.narrow ? 40px : 0px; label: "Back"; icon: @image-url("../assets/icons/back.svg"); activated => { State.show-conversation = false; if State.section == 1 { State.focus-friend-search(); } else { State.focus-search(); } } }
                        if State.narrow && State.unread-conversations > 0: Rectangle { width: 24px; height: 22px; border-radius: 11px; background: Tokens.accent; Text { text: State.unread-stale ? "•" : "" + State.unread-conversations; color: Tokens.selection-foreground; font-size: Tokens.time; horizontal-alignment: center; vertical-alignment: center; } }
                        Text { text: State.chat-title; color: Tokens.foreground; font-size: Tokens.heading; font-weight: 700; overflow: elide; vertical-alignment: center; }
                        Text { width: Tokens.small * 6.5; horizontal-stretch: 0; text: State.retrying-connection && !State.connection-failed ? "Connecting…" : ""; color: Tokens.secondary; font-size: Tokens.small; overflow: elide; vertical-alignment: center; }
                    }
                    if State.unread-locating || State.unread-boundary-unknown: Text { text: State.unread-locating ? "Finding unread messages…" : "Couldn’t find your first unread message"; color: Tokens.secondary; font-size: Tokens.small; }
                    if State.chat-subtitle != "": Text { text: State.chat-subtitle; color: Tokens.secondary; font-size: Tokens.small; overflow: elide; }
                }
                }
            }
            history-surface := Rectangle {
              vertical-stretch: 1;
              history-focus := FocusScope {
                accessible-role: list; accessible-label: "Message history";
                accessible-description: self.has-focus ? "Focused history" : "Scrollable message history";
                key-pressed(event) => {
                    if State.ime-active { return reject; }
                    if State.browser-key(event) == accept { return accept; }
                    if State.recovery-kind != "" { return reject; }
                    if event.text == Key.Tab { if event.modifiers.shift { if State.connection-failed { State.focus-sign-in-opener(); } else if State.narrow { back-button.focus-button(); } else if State.section == 1 { State.focus-friend-list(); } else { State.focus-chat-list(); } } else { if root.latest-visible { latest-button.focus-pill(); } else if State.return-visible { return-button.focus-pill(); } else { State.focus-composer(); } } return accept; }
                    if event.text == Key.UpArrow { history.scroll(Tokens.base * 1.4); history.scrolled(); return accept; }
                    if event.text == Key.DownArrow { history.scroll(-Tokens.base * 1.4); history.scrolled(); return accept; }
                    if event.text == Key.PageUp { history.scroll(history.visible-height * 0.9); history.scrolled(); return accept; }
                    if event.text == Key.PageDown { history.scroll(-history.visible-height * 0.9); history.scrolled(); return accept; }
                    if event.text == Key.Home { history.jump(0px); history.scrolled(); return accept; }
                    if event.text == Key.End { State.latest(); return accept; }
                    reject
                }
              }
              history := Pane {
                connection-feedback: (!State.narrow || State.show-conversation) && !(State.profile-open && State.profile-sheet);
                focus-requested => { history-focus.focus(); }
                changed extent => { State.history-extent = self.extent; if State.following && !self.dragging { self.jump(-self.extent); } }
                changed dragging => { State.history-dragging = self.dragging; }
                offset <=> State.history-y;

                vertical-stretch: 1;
                scrolled => { State.following = State.history-can-follow && self.visible-top == self.inset && !State.history-dragging && State.history-extent + State.history-y <= State.text-size * 1px; if State.following { State.new-count = 0; } State.history-scrolled(); }
                VerticalLayout {
                    padding: 16px; spacing: 5px;
                    padding-bottom: 16px + root.pill-height;
                    if !State.has-chat: Text { text: "Choose a conversation"; color: Tokens.secondary; font-size: Tokens.small; horizontal-alignment: center; wrap: word-wrap; }
                    Rectangle {
                        height: State.has-chat ? max(32px, Tokens.small * 1.8) : 0px;
                        HorizontalLayout { alignment: center; spacing: 8px;
                            Text { text: State.older-status; color: Tokens.secondary; font-size: Tokens.small; min-width: 0px; overflow: elide; vertical-alignment: center; }
                            older-retry := Button { visible: State.older-failed; width: self.visible ? self.preferred-width : 0px; text: "Retry older"; clicked => { State.older-retry(); } }
                        }
                    }
                    if State.has-chat && State.messages.length == 0 && !State.loading-history && State.history-error == "": Text { text: "No messages yet"; accessible-label: self.text; color: Tokens.secondary; font-size: Tokens.small; horizontal-alignment: center; wrap: word-wrap; }
                    for message in State.messages: Message { message: message; }
                }
            }
              history-pills := HorizontalLayout {
                x: max(8px, (parent.width - self.width) / 2); y: max(0px, parent.height - self.height - 8px);
                width: min(parent.width - 16px, latest-button.preferred-width + return-button.preferred-width + (root.latest-visible && State.return-visible ? 8px : 0px));
                height: max(latest-button.preferred-height, return-button.preferred-height); spacing: root.latest-visible && State.return-visible ? 8px : 0px;
                latest-button := HistoryPill {
                    visible: root.latest-visible; enabled: self.visible;
                    width: self.visible ? min(self.preferred-width, parent.width - (State.return-visible ? return-button.width + 8px : 0px)) : 0px;
                    label: root.latest-label;
                    text: State.return-visible && !State.history-needs-refresh && State.new-count > 0 ? "Latest · " + State.new-count : root.latest-label;
                    activated => { State.latest(); State.focus-history(); }
                    traversed(back) => { if back { history-focus.focus(); } else if State.return-visible { return-button.focus-pill(); } else { State.focus-composer(); } }
                }
                return-button := HistoryPill {
                    visible: State.return-visible; enabled: self.visible;
                    width: self.visible ? min(self.preferred-width, parent.width - (root.latest-visible ? min(latest-button.preferred-width, parent.width * 0.4) + 8px : 0px)) : 0px;
                    text: "Return to message";
                    activated => { State.return-to-message(); State.focus-history(); }
                    traversed(back) => { if !back { State.focus-composer(); } else if root.latest-visible { latest-button.focus-pill(); } else { history-focus.focus(); } }
                }
              }
              if State.demo && State.last-opened-link != "": Text {
                y: parent.height - self.preferred-height; text: "Preview opened: " + State.last-opened-link;
                accessible-label: "Recorded link activation"; accessible-value: State.last-opened-link;
                font-size: Tokens.small; color: Tokens.secondary; wrap: word-wrap;
              }
              // Overlay: async loading/error never contributes to history geometry.
              history-feedback := Rectangle {
                y: State.connection-feedback-visible ? State.connection-notice-height : 0px;
                visible: State.history-error != "" || State.loading-history;
                height: 24px; background: Tokens.surface;
                HorizontalLayout {
                    padding-left: 8px; spacing: 4px;
                    Text { text: State.loading-history ? "Loading recent messages…" : State.history-error; accessible-label: self.text; color: State.loading-history ? Tokens.secondary : Tokens.danger; font-size: Tokens.small; overflow: elide; vertical-alignment: center; }
                    if !State.loading-history: Button { text: "Retry"; clicked => { State.retry-history(); } }
                }
              }
            }
            if State.history-budget-warning: Text { text: "Some images in this long message may be unavailable"; color: Tokens.secondary; font-size: Tokens.small; wrap: word-wrap; }
            if State.jump-error != "": Text { text: State.jump-error; color: Tokens.secondary; font-size: Tokens.small; }
composer-surface := Composer { }
            if State.storage-error != "": HorizontalLayout {
                padding: 8px;
                Text { text: State.storage-error; color: Tokens.danger; font-size: Tokens.small; wrap: word-wrap; }
                Button { text: "Retry saving"; enabled: State.storage-retryable; clicked => { State.retry-storage(); } }
            }
        }
    
    public function focus-header() { if State.narrow { back-button.focus-button(); } else if State.section == 1 { State.focus-friend-list(); } else { State.focus-chat-list(); } }
    public function restore-editor(anchor: int, caret: int) { composer-surface.restore-editor(anchor, caret); }
    public function focus-editor() { composer-surface.focus-editor(); }
    public function focus-history() { history-focus.focus(); }
    public function focus-reading-before-editor() { if State.return-visible { return-button.focus-pill(); } else if root.latest-visible { latest-button.focus-pill(); } else { history-focus.focus(); } }
    public function scroll(delta: length) { history.scroll(delta); history.scrolled(); }
    public function jump(y: length) { history.jump(y); }
    changed width => { State.history-width = history.width; }
    property <length> viewport-height: history.visible-height;
    changed viewport-height => { State.history-viewport-height = root.viewport-height; }
    property <length> visible-top: history.visible-top;
    changed visible-top => { State.history-visible-top = root.visible-top; }
    property <length> cover-inset: history.inset;
    changed cover-inset => { State.history-cover-inset = root.cover-inset; }
    // Pills plus the 8 px gap below them remain outside read exposure.
    property <length> pill-height: root.latest-visible || State.return-visible ? history-surface.height - history-pills.y : 0px;
    changed pill-height => { State.history-pill-height = root.pill-height; }
    init => { State.history-width = history.width; State.history-viewport-height = history.visible-height; State.history-visible-top = root.visible-top; State.history-cover-inset = root.cover-inset; State.history-pill-height = root.pill-height; State.conversation-height = root.height; State.history-extent = history.extent; }
    changed height => { State.conversation-height = root.height; }

}
