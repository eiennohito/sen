import { EmptyState } from "empty-state.slint";
import { DatePill } from "history-pill.slint";
import { Avatar } from "avatar.slint";
import { Button } from "button.slint";
import { LineEdit, TextEdit, ScrollView, ListView, ComboBox } from "std-widgets.slint";
import { State } from "state.slint";
import { Tokens } from "tokens.slint";
import { ChatRow, FriendRow, MessageRow, ReactionRow } from "types.slint";
import { IconButton } from "icon-button.slint";
import { Pane } from "scrollpane.slint";
import { Message } from "message.slint";
import { FeedbackRect } from "connection-notice.slint";
import { Composer } from "composer.slint";

component HistoryPill inherits Rectangle {
    in property <string> text;
    in property <string> label: root.text;
    in property <bool> latest;
    in property <bool> enabled;
    callback activated();
    callback traversed(bool);
    public function focus-pill() { focus.focus(); }
    preferred-width: root.visible ? (root.latest ? 36px : label.preferred-width + 24px) : 0px; preferred-height: root.visible ? 36px : 0px;
    border-radius: self.height / 2; background: touch.has-hover ? Tokens.surface-hover : Tokens.bg; drop-shadow-color: #00000026; drop-shadow-blur: 8px; drop-shadow-offset-y: 2px;
    border-width: focus.has-focus ? 2px : 0px; border-color: Tokens.accent-strong;
    label := Text { x: 8px; width: parent.width - 16px; height: parent.height; visible: !root.latest; text: root.text; font-size: Tokens.small; color: Tokens.foreground; horizontal-alignment: center; vertical-alignment: center; overflow: elide; accessible-role: none; }
    if root.latest: Image { x: 8px; y: 8px; width: 20px; height: 20px; source: @image-url("../assets/icons/down.svg"); colorize: Tokens.text; }
    if root.latest && State.new-count > 0: Rectangle { x: 20px; y: -4px; width: 20px; height: 20px; border-radius: 10px; background: Tokens.accent; Text { text: "" + State.new-count; font-size: Tokens.small; font-weight: 600; color: Tokens.on-accent; horizontal-alignment: center; vertical-alignment: center; } }
    focus := FocusScope {
        enabled: root.enabled; accessible-role: button; accessible-label: root.label;
        accessible-description: self.has-focus && self.enabled && self.visible ? "Focused" : "";
        accessible-action-default => { root.activated(); }
        key-pressed(event) => {
            if State.ime-active { return reject; }
            if State.browser-key(event) == accept { return accept; }
            if event.text == Key.Tab { root.traversed(event.modifiers.shift); return accept; }
            if event.text == Key.Return || event.text == " " { root.activated(); return accept; }
            reject
        }
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.activated(); } }
}

export component Conversation inherits Rectangle {
    property <bool> loading-delayed;
    property <int> window-sub: State.window-sub;
    changed window-sub => { root.loading-delayed = false; loading-timer.restart(); }
    loading-timer := Timer { interval: 300ms; running: State.window-loading && !root.loading-delayed; triggered => { root.loading-delayed = true; } }
    property <int> demo-reset: State.demo-reset-generation;
    changed demo-reset => { more-menu.close(); }
    out property <FeedbackRect> header-bounds: { x: header.absolute-position.x, y: header.absolute-position.y, width: root.visible ? header.width : 0px, height: header.height };
    out property <FeedbackRect> composer-bounds: { x: composer-surface.absolute-position.x, y: composer-surface.absolute-position.y, width: root.visible ? composer-surface.width : 0px, height: composer-surface.height };
    property <bool> latest-visible: !State.following && State.has-chat;
    property <string> latest-label: State.history-needs-refresh ? "Latest · updates available" : State.new-count > 0 ? "Latest · " + State.new-count + " new" : "Latest";

          visible: !State.narrow || State.show-conversation;
          VerticalLayout {
            spacing: 0px;
            header := Rectangle {
                height: 56px; background: Tokens.bg;
                Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: Tokens.divider; }
                FocusScope {
                    focus-on-tab-navigation: false;
                    key-pressed(event) => {
                        if event.text == Key.Tab && !State.ime-active {
                            if event.modifiers.shift {
                                if more-button.has-focus { if State.chat-group { members-button.focus-button(); } else { title-focus.focus(); } }
                                else if members-button.has-focus { title-focus.focus(); }
                                else if title-focus.has-focus && State.narrow { back-button.focus-button(); }
                                else if State.narrow { root.focus-last(); }
                                else if State.section == 1 { State.focus-friend-list(); } else { State.focus-chat-list(); }
                            } else {
                                if back-button.has-focus { title-focus.focus(); }
                                else if title-focus.has-focus && State.chat-group { members-button.focus-button(); }
                                else if !more-button.has-focus { more-button.focus-button(); }
                                else { root.focus-after-header(); }
                            }
                            return accept;
                        }
                        reject
                    }
                    HorizontalLayout {
                        y: 12px; height: 32px; padding-left: 16px; padding-right: 16px; spacing: 8px;
                        back-button := IconButton { visible: State.narrow; enabled: self.visible; width: self.visible ? 32px : 0px; label: "Back"; focus-description: "Focused"; icon: @image-url("../assets/icons/back.svg"); activated => { State.show-conversation = false; if State.section == 1 { State.focus-friend-search(); } else { State.focus-search(); } }
                            if State.unread-conversations > 0: Rectangle { x: 20px; y: -4px; width: State.unread-stale ? 8px : 20px; height: State.unread-stale ? 8px : 20px; border-radius: self.height / 2; background: Tokens.accent;
                                if !State.unread-stale: Text { text: State.unread-conversations > 999 ? "999+" : "" + State.unread-conversations; color: Tokens.on-accent; font-size: Tokens.small; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        title-button := Rectangle {
                            horizontal-stretch: 1; height: 32px; border-radius: 8px;
                            background: title-touch.has-hover ? Tokens.surface-hover : transparent;
                            HorizontalLayout {
                                spacing: 8px; padding: 0px;
                                Avatar { width: 32px; height: 32px; identity: State.chat-id; initial: State.chat-initial; picture: State.chat-avatar; label: "Conversation avatar"; }
                                VerticalLayout { spacing: 0px; alignment: center;
                                    Text { text: State.chat-title; color: Tokens.text; font-size: Tokens.base + 2px; font-weight: 600; overflow: elide; }
                                    if State.chat-group: Text { text: State.member-count + " members"; color: Tokens.secondary; font-size: Tokens.small; }
                                }
                            }
                            title-focus := FocusScope {
                                accessible-role: button; accessible-label: State.chat-title; accessible-description: self.has-focus ? "Focused" : "";
                                accessible-action-default => { State.open-profile(State.chat-id); }
                                key-pressed(event) => { if event.text == Key.Return || event.text == " " { State.open-profile(State.chat-id); return accept; } reject }
                                Rectangle { x: -4px; y: -4px; width: parent.width + 8px; height: parent.height + 8px; background: transparent; border-radius: 12px; border-width: parent.has-focus ? 2px : 0px; border-color: Tokens.accent-strong; }
                            }
                            title-touch := TouchArea { clicked => { title-focus.focus(); State.open-profile(State.chat-id); } }
                        }
                        members-button := IconButton { visible: State.chat-group; enabled: self.visible; width: self.visible ? 32px : 0px; label: State.member-count >= 0 ? "Members, " + State.member-count : "Members"; focus-description: "Focused"; icon: @image-url("../assets/icons/members.svg"); activated => { State.open-members(); } }
                        more-button := IconButton { label: "More"; focus-description: "Focused"; icon: @image-url("../assets/icons/more.svg"); activated => { more-menu.show(); } }
                    }
                }
                more-menu := PopupWindow {
                    x: max(0px, header.width - self.width - 16px); y: 52px; width: 184px; height: 40px;
                    Rectangle { background: Tokens.bg; border-width: 1px; border-color: Tokens.divider; border-radius: 8px;
                        Button { x: 4px; y: 4px; text: State.chat-group ? "Group info" : "Profile"; text-button: true; clicked => { more-menu.close(); State.open-profile(State.chat-id); } }
                    }
                }
            }
            if State.conversation-error != "": Text { text: State.conversation-error; color: Tokens.danger; font-size: Tokens.small; wrap: word-wrap; }
            history-surface := Rectangle {
              vertical-stretch: 1;
              history-focus := FocusScope {
                accessible-role: list; accessible-label: "Message history";
                accessible-description: self.has-focus ? "Focused history" : "Scrollable message history";
                key-pressed(event) => {
                    if State.ime-active { return reject; }
                    if State.browser-key(event) == accept { return accept; }
                    if State.recovery-kind != "" { return reject; }
                    if event.text == Key.Tab { if event.modifiers.shift { if State.connection-actions-enabled { State.focus-sign-in-opener(); } else { more-button.focus-button(); } } else { if !State.has-chat { State.focus-after-conversation(); } else if root.latest-visible { latest-button.focus-pill(); } else if State.return-visible { return-button.focus-pill(); } else { State.focus-composer(); } } return accept; }
                    if event.text == Key.UpArrow { history.scroll(Tokens.base * 1.4); history.scrolled(); return accept; }
                    if event.text == Key.DownArrow { history.scroll(-Tokens.base * 1.4); history.scrolled(); return accept; }
                    if event.text == Key.PageUp { history.scroll(history.visible-height * 0.9); history.scrolled(); return accept; }
                    if event.text == Key.PageDown { history.scroll(-history.visible-height * 0.9); history.scrolled(); return accept; }
                    if event.text == Key.Home { history.jump(0px); history.scrolled(); return accept; }
                    if event.text == Key.End { State.latest(); return accept; }
                    reject
                }
              }
              history := Pane {
                connection-feedback: (!State.narrow || State.show-conversation) && !(State.detail-open && State.profile-sheet);
                focus-requested => { history-focus.focus(); }
                changed extent => { State.history-extent = self.extent; if State.following && !self.dragging { self.jump(-self.extent); } }
                changed dragging => { State.history-dragging = self.dragging; }
                offset <=> State.history-y;

                vertical-stretch: 1;
                scrolled => { State.following = State.history-can-follow && self.visible-top == self.inset && !State.history-dragging && State.history-extent + State.history-y <= State.text-size * 1px; if State.following { State.new-count = 0; } State.history-scrolled(); }
                virtual: State.history-virtual;
                full-height: State.plain-history-height;
                virtual-height: State.virtual-history-height;
                if State.history-virtual: history-view := ListView {
                    width: parent.width; height: parent.height;
                    changed content-height => { State.virtual-history-height = self.content-height; }
                    content-y <=> State.history-y;
                    content-width: self.width;
                    vertical-scrollbar-policy: always-off;
                    horizontal-scrollbar-policy: always-off;
                    accessible-role: none;
                for message[i] in State.messages: Rectangle {
                    property <length> prefix: i == 0 ? 16px + (State.has-chat ? max(32px, Tokens.small * 1.8) : 0px) : 0px;
                    height: self.prefix + item.preferred-height + (i == State.messages.length - 1 ? 16px + root.pill-height : 0px);
                    if i == 0: HorizontalLayout {
                        x: 16px; y: 16px; width: parent.width - 32px;
                        height: State.has-chat ? max(32px, Tokens.small * 1.8) : 0px;
                        alignment: center; spacing: 8px;
                        DatePill { text: State.older-status; visible: State.older-status != ""; }
                    }
                    item := Message {
                        x: 16px; y: parent.prefix; width: parent.width - 32px;
                        height: self.preferred-height;
                        message: message;
                        origin-y: parent.y;
                    }
                }
                }
                if !State.history-virtual: VerticalLayout {
                    width: parent.width;
                    height: self.preferred-height;
                    changed preferred-height => { State.plain-history-height = self.preferred-height; }
                    init => { State.plain-history-height = self.preferred-height; }
                    padding: 16px; spacing: 0px;
                    padding-bottom: 16px + root.pill-height;
                    Rectangle {
                        height: State.has-chat ? max(32px, Tokens.small * 1.8) : 0px;
                        HorizontalLayout { alignment: center; spacing: 8px;
                            DatePill { text: State.older-status; visible: State.older-status != ""; }
                        }
                    }
                    for message in State.messages: Message { message: message; }
                }
            }
              if State.has-chat && State.window-loading && root.loading-delayed: Text { accessible-role: text; accessible-label: "Loading history…"; text: "Loading history…"; color: Tokens.secondary; font-size: Tokens.small; horizontal-alignment: center; vertical-alignment: center; }
              if !State.has-chat || (!State.window-loading && State.messages.length == 0): EmptyState { y: history.visible-top; height: parent.height - self.y; text: !State.has-chat ? "Choose a conversation" : "No messages yet"; name: State.has-chat ? State.chat-title : ""; identity: State.chat-id; initial: State.chat-initial; avatar: State.chat-avatar; icon: @image-url("../assets/icons/chats.svg"); }
              history-pills := HorizontalLayout {
                x: max(8px, parent.width - self.width - 16px); y: max(0px, parent.height - self.height - 16px);
                width: min(parent.width - 16px, latest-button.preferred-width + return-button.preferred-width + (root.latest-visible && State.return-visible ? 8px : 0px));
                height: max(latest-button.preferred-height, return-button.preferred-height); spacing: root.latest-visible && State.return-visible ? 8px : 0px;
                latest-button := HistoryPill {
                    latest: true;
                    visible: root.latest-visible; enabled: self.visible;
                    width: self.visible ? min(self.preferred-width, parent.width - (State.return-visible ? return-button.width + 8px : 0px)) : 0px;
                    label: root.latest-label;
                    text: State.return-visible && !State.history-needs-refresh && State.new-count > 0 ? "Latest · " + State.new-count : root.latest-label;
                    activated => { State.latest(); State.focus-history(); }
                    traversed(back) => { if back { history-focus.focus(); } else if State.return-visible { return-button.focus-pill(); } else { State.focus-composer(); } }
                }
                return-button := HistoryPill {
                    visible: State.return-visible; enabled: self.visible;
                    width: self.visible ? min(self.preferred-width, parent.width - (root.latest-visible ? min(latest-button.preferred-width, parent.width * 0.4) + 8px : 0px)) : 0px;
                    text: "Return to message";
                    activated => { State.return-to-message(); State.focus-history(); }
                    traversed(back) => { if !back { State.focus-composer(); } else if root.latest-visible { latest-button.focus-pill(); } else { history-focus.focus(); } }
                }
              }
              if State.link-feedback != "": Text {
                y: parent.height - self.preferred-height; text: State.link-feedback;
                accessible-label: "Recorded link activation"; accessible-value: State.last-opened-link;
                font-size: Tokens.small; color: Tokens.secondary; wrap: word-wrap;
              }
            }
            if State.history-budget-warning: Text { text: "Some images in this long message may be unavailable"; color: Tokens.secondary; font-size: Tokens.small; wrap: word-wrap; }
composer-surface := Composer { }
            if State.storage-error != "": HorizontalLayout {
                padding: 8px;
                Text { text: State.storage-error; color: Tokens.danger; font-size: Tokens.small; wrap: word-wrap; }
            }
        }
    
    public function focus-after-header() { if State.connection-actions-enabled { State.focus-connection-first(); } else { history-focus.focus(); } }
    public function focus-first() { if State.narrow { back-button.focus-button(); } else { title-focus.focus(); } }
    public function focus-last() { if State.has-chat { composer-surface.focus-last(); } else { history-focus.focus(); } }
    public function focus-members() { members-button.focus-button(); }
    public function focus-header() { more-button.focus-button(); }
    public function restore-editor(anchor: int, caret: int) { composer-surface.restore-editor(anchor, caret); }
    public function focus-editor() { composer-surface.focus-editor(); }
    public function focus-history() { history-focus.focus(); }
    public function focus-reading-before-editor() { if State.return-visible { return-button.focus-pill(); } else if root.latest-visible { latest-button.focus-pill(); } else { history-focus.focus(); } }
    public function scroll(delta: length) { history.scroll(delta); history.scrolled(); }
    public function jump(y: length) { history.jump(y); }
    changed width => { State.history-width = history.width; }
    property <length> viewport-height: history.visible-height;
    changed viewport-height => { State.history-viewport-height = root.viewport-height; }
    property <length> visible-top: history.visible-top;
    changed visible-top => { State.history-visible-top = root.visible-top; }
    property <length> cover-inset: history.inset;
    changed cover-inset => { State.history-cover-inset = root.cover-inset; }
    // Pills plus the 8 px gap below them remain outside read exposure.
    property <length> pill-height: root.latest-visible || State.return-visible ? history-surface.height - history-pills.y : 0px;
    changed pill-height => { State.history-pill-height = root.pill-height; }
    init => { State.history-width = history.width; State.history-viewport-height = history.visible-height; State.history-visible-top = root.visible-top; State.history-cover-inset = root.cover-inset; State.history-pill-height = root.pill-height; State.conversation-height = root.height; State.history-extent = history.extent; }
    changed height => { State.conversation-height = root.height; }

}
