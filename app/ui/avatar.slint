import { Tokens } from "tokens.slint";
import { State } from "state.slint";
export component Avatar inherits Rectangle {
    in property <string> identity;
    in property <string> initial;
    in property <image> picture;
    in property <string> label: "Contact photo";
    width: 44px; height: 44px; border-radius: self.width / 2;
    background: root.picture.width > 0 ? transparent : State.avatar-tint(root.identity);
    Text { text: root.initial; color: #202124; font-size: Tokens.base; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; visible: root.picture.width == 0; }
    Image { accessible-role: image; accessible-label: root.label; width: 100%; height: 100%; source: State.avatar-picture(root.picture, root.width / 1px, State.device-scale); image-fit: cover; visible: root.picture.width > 0; }
}
