    public function close-viewer() { ShellState.request-panel(PanelState.none); }
}
export enum NotificationPreview { name-and-text, name-only, new-message }
export enum SettingsSection { chats, notifications, background, shortcuts, about }
export global SettingsState {
    in-out property <int> text-size: 15;
    out property <[int]> text-sizes: [13, 15, 18, 22];
    out property <int> text-size-index: self.text-size <= self.text-sizes[0] ? 0 : self.text-size <= self.text-sizes[1] ? 1 : self.text-size <= self.text-sizes[2] ? 2 : 3;
    in-out property <bool> enter-sends: false;
    in-out property <bool> background-mode;
    in-out property <bool> autostart;
    in-out property <string> autostart-status;
    in-out property <bool> notifications-paused;
    in-out property <bool> notifications-enabled;
    in-out property <NotificationPreview> notification-preview: NotificationPreview.name-only;
    in-out property <bool> notification-sound;
    in-out property <bool> notification-mention-exception;
    in-out property <bool> notification-group-events;
    in-out property <bool> notification-available;
    in-out property <string> notification-status;
    callback test-notification();
    out property <bool> settings-open: ShellState.panel == PanelState.settings;
    public function close-settings() { ShellState.request-panel(PanelState.none); ShellState.focus-settings-opener(); }
    callback settings-changed();
}
export enum AuthPhase { preparing, pairing, signed-in, cancelling }
export global AuthState {
    in-out property <AuthPhase> auth-phase;
    out property <bool> auth-open: ShellState.panel == PanelState.sign-in;
    out property <bool> auth-busy: ShellState.connection == ConnectionState.signing-in;
    in-out property <image> auth-qr;
    in-out property <string> auth-pin;
    pure callback status-text(string, string, bool, AuthPhase) -> string;
    out property <string> status: self.status-text(self.auth-pin, self.auth-stage, self.auth-busy, self.auth-phase);
    in-out property <string> auth-stage;
    in-out property <string> auth-error;
    in-out property <string> session-cause;
    in-out property <bool> auth-prerequisite-missing;
    callback start-sign-in();
    callback cancel-sign-in();
    public function close-sign-in() { ShellState.request-panel(PanelState.none); ShellState.focus-connection-first(); }
    public function open-sign-in() { if ShellState.sign-in-available { ShellState.request-panel(PanelState.sign-in); } }
}
