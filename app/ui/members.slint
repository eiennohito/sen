import { ListRow, RowText } from "list-row.slint";
import { IconButton } from "icon-button.slint";
import { Avatar } from "avatar.slint";
import { State } from "state.slint";
import { Tokens } from "tokens.slint";
import { SearchField } from "search-field.slint";
import { Pane } from "scrollpane.slint";

export component Members inherits FocusScope {
    focus-on-tab-navigation: false;
    in-out property <int> selected <=> State.member-result;
    property <length> row-height: max(64px, Tokens.base * 2.8 + 16px);
    public function focus-first() { State.focus-profile-close(); }
    public function focus-last() { if list.visible { list.focus(); } else { search.focus-last(); } }
    public function focus-list() { list.focus(); }
    function reveal() { if root.selected * root.row-height < -pane.offset { pane.jump(-root.selected * root.row-height); } else if (root.selected + 1) * root.row-height > -pane.offset + pane.visible-height { pane.jump(pane.visible-height - (root.selected + 1) * root.row-height); } }
    capture-key-pressed(event) => { if State.profile-sheet && event.text == Key.Return && event.modifiers.control { return accept; } reject }
    key-pressed(event) => {
        if State.ime-active { return reject; }
        if State.browser-key(event) == accept { return accept; }
        if event.text == Key.Escape { State.pop-detail(false); return accept; }
        if event.text == Key.Tab {

            if !event.modifiers.shift && (list.has-focus) { State.focus-after-layer(); return accept; }
            if event.modifiers.shift && list.has-focus { search.focus-last(); return accept; }
        }
        reject
    }
    VerticalLayout {
        padding: 16px; spacing: 12px;
        search := SearchField {
            text <=> State.member-query; label: "Search members"; placeholder-text: "Search members";
            edited(value) => { root.selected = 0; State.filter-members(); pane.jump(0px); }
            clear => { State.member-query = ""; root.selected = 0; State.filter-members(); pane.jump(0px); }
            key-pressed(event) => {
                if event.text == Key.Escape { State.pop-detail(false); return accept; }
                if event.text == Key.Tab { if event.modifiers.shift { State.focus-profile-close(); } else { list.focus(); } return accept; }
                if event.text == Key.DownArrow { list.focus(); return accept; }
                reject
            }
        }
        if State.members.length == 0: Text { text: State.member-query == "" ? "No members" : "No members match your search"; wrap: word-wrap; color: Tokens.secondary; }
        if State.detail-error != "": Text { text: State.detail-error; color: Tokens.danger; font-size: Tokens.small; wrap: word-wrap; }
        list := FocusScope {
            accessible-role: AccessibleRole.list; accessible-label: "Group members";
            accessible-description: self.has-focus && self.enabled && self.visible ? "Focused" : "";
            key-pressed(event) => {
                if State.ime-active { return reject; }
                if event.text == Key.UpArrow { root.selected = max(0, root.selected - 1); root.reveal(); return accept; }
                if event.text == Key.DownArrow { root.selected = min(State.members.length - 1, root.selected + 1); root.reveal(); return accept; }
                if event.text == Key.Home { root.selected = 0; pane.jump(0px); return accept; }
                if event.text == Key.End { root.selected = State.members.length - 1; pane.jump(-pane.extent); return accept; }
                if event.text == Key.Return && State.members.length > 0 && !State.members[min(State.members.length - 1, max(0, root.selected))].invited { State.open-member(State.members[min(State.members.length - 1, max(0, root.selected))].id); return accept; }
                reject
            }
            pane := Pane {
                VerticalLayout {
                    spacing: 0px;
                    for member[i] in State.members: VerticalLayout {
                      if member.invited && (i == 0 || !State.members[i - 1].invited): Text { text: "Invited (" + State.invitee-count + ")"; color: Tokens.secondary; }
                      ListRow {
                        width: pane.visible-width; height: root.row-height;
                        background: touch.has-hover ? Tokens.surface : transparent;
                        border-width: list.has-focus && root.selected == i ? 2px : 0px; border-color: Tokens.accent; border-radius: 6px;
                        if !member.invited: Rectangle { width: 100%; height: 100%; accessible-role: button; accessible-label: "Open member: " + member.name + (member.is-self ? ", You" : ""); accessible-action-default => { root.selected=i;list.focus();State.open-member(member.id); } }
                        identity: member.id; initial: member.initial; avatar: member.avatar; title: member.name; subtitle: member.status;
                        title-note: member.is-self ? "You" : member.friend ? "Friend" : "";
                        avatar-size: 40px; trailing-width: 40px;
                        touch := TouchArea { enabled: !member.invited; mouse-cursor: pointer; clicked => { root.selected = i; list.focus(); if !member.invited { State.open-member(member.id); } } }
                        IconButton { x: parent.width - 40px; y: (parent.height - 32px) / 2; visible: member.friend && !member.invited && !member.is-self && (touch.has-hover || (list.has-focus && root.selected == i)); enabled: self.visible; label: "Chat with " + member.name; icon: @image-url("../assets/icons/chats.svg"); activated => { State.detail-action("member-chat", member.id); } }

                      }
                    }
                }
            }
        }
    }
}
