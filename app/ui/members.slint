import { Button } from "std-widgets.slint";
import { State } from "state.slint";
import { Tokens } from "tokens.slint";
import { SearchField } from "search-field.slint";
import { Pane } from "scrollpane.slint";

export component Members inherits FocusScope {
    focus-on-tab-navigation: false;
    in-out property <int> selected <=> State.member-result;
    property <length> row-height: max(64px, Tokens.base * 2.8 + 16px);
    public function focus-first() { close.focus(); }
    public function focus-last() { if list.visible { list.focus(); } else { search.focus-last(); } }
    public function focus-list() { list.focus(); }
    function reveal() { if root.selected * root.row-height < -pane.offset { pane.jump(-root.selected * root.row-height); } else if (root.selected + 1) * root.row-height > -pane.offset + pane.visible-height { pane.jump(pane.visible-height - (root.selected + 1) * root.row-height); } }
    capture-key-pressed(event) => { if State.profile-sheet && event.text == Key.Return && event.modifiers.control { return accept; } reject }
    key-pressed(event) => {
        if State.ime-active { return reject; }
        if State.browser-key(event) == accept { return accept; }
        if event.text == Key.Escape { State.close-profile(); return accept; }
        if event.text == Key.Tab {
            if event.modifiers.shift && close.has-focus { State.focus-before-layer(); return accept; }
            if !event.modifiers.shift && (list.has-focus) { State.focus-after-layer(); return accept; }
            if event.modifiers.shift && list.has-focus { search.focus-last(); return accept; }
        }
        reject
    }
    VerticalLayout {
        padding: 16px; spacing: 12px;
        close := Button { text: "Close members"; accessible-description: self.has-focus ? "Focused" : ""; clicked => { State.close-profile(); } }
        Text { text: "Members" + (State.member-count >= 0 ? " (" + State.member-count + ")" : ""); font-size: Tokens.heading; font-weight: 700; }
        search := SearchField {
            text <=> State.member-query; label: "Search members"; placeholder-text: "Search members";
            edited(value) => { root.selected = 0; State.filter-members(); pane.jump(0px); }
            clear => { State.member-query = ""; root.selected = 0; State.filter-members(); pane.jump(0px); }
            key-pressed(event) => {
                if event.text == Key.Escape { State.close-profile(); return accept; }
                if event.text == Key.Tab { if event.modifiers.shift { close.focus(); } else { list.focus(); } return accept; }
                if event.text == Key.DownArrow { list.focus(); return accept; }
                reject
            }
        }
        if State.members.length == 0: Text { text: State.member-query == "" ? "No members" : "No members match your search"; wrap: word-wrap; color: Tokens.secondary; }
        list := FocusScope {
            accessible-role: AccessibleRole.list; accessible-label: "Group members";
            accessible-description: self.has-focus ? "Focused" : "";
            key-pressed(event) => {
                if State.ime-active { return reject; }
                if event.text == Key.UpArrow { root.selected = max(0, root.selected - 1); root.reveal(); return accept; }
                if event.text == Key.DownArrow { root.selected = min(State.members.length - 1, root.selected + 1); root.reveal(); return accept; }
                if event.text == Key.Home { root.selected = 0; pane.jump(0px); return accept; }
                if event.text == Key.End { root.selected = State.members.length - 1; pane.jump(-pane.extent); return accept; }
                if event.text == Key.Return && State.members.length > 0 { State.open-member(State.members[min(State.members.length - 1, max(0, root.selected))].id); return accept; }
                reject
            }
            pane := Pane {
                VerticalLayout {
                    spacing: 0px;
                    for member[i] in State.members: Rectangle {
                        width: pane.visible-width; height: root.row-height;
                        background: touch.has-hover ? Tokens.surface : transparent;
                        border-width: list.has-focus && root.selected == i ? 2px : 0px; border-color: Tokens.accent; border-radius: 6px;
                        accessible-role: button; accessible-label: "Open member: " + member.name + (member.is-self ? ", You" : "");
                        accessible-action-default => { root.selected = i; State.open-member(member.id); }
                        Rectangle {
                            x: 8px; y: (parent.height - 40px) / 2; width: 40px; height: 40px; border-radius: 20px; background: Tokens.selection;
                            Text { width: 100%; height: 100%; text: member.initial; color: Tokens.selection-foreground; horizontal-alignment: center; vertical-alignment: center; visible: member.avatar.width == 0; }
                            Image { width: 100%; height: 100%; source: member.avatar; image-fit: contain; }
                        }
                        VerticalLayout {
                            x: 60px; width: max(0px, parent.width - 68px); height: parent.height; alignment: center; spacing: 4px;
                            Text { text: member.name; overflow: elide; font-weight: 600; }
                            if member.is-self: Text { text: "You"; font-size: Tokens.small; color: Tokens.secondary; }
                        }
                        touch := TouchArea { mouse-cursor: pointer; clicked => { root.selected = i; State.open-member(member.id); } }
                    }
                }
            }
        }
    }
}
