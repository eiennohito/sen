import { DetailAction } from "globals.slint";
import { DetailState, ShellState } from "globals.slint";
import { FocusRing } from "button.slint";

import { ListRow } from "list-row.slint";
import { IconButton } from "icon-button.slint";
import { Tokens } from "tokens.slint";
import { SearchField } from "search-field.slint";
import { Pane } from "scrollpane.slint";

export component Members inherits FocusScope {
    property <length> row-height: max(64px, Tokens.base * 2.8 + 16px);
    focus-on-tab-navigation: false;
    out property <bool> contains-focus: list.has-focus || search.contains-focus;
    out property <bool> editing: search.has-focus;
    public function focus-list() { list.focus(); }
    private property <int> selected;
    capture-key-pressed(event) => { if ShellState.profile-sheet && event.text == Key.Return && event.modifiers.control { return accept; } reject }
    key-pressed(event) => {
        if ShellState.ime-active { return reject; }
        if event.text == Key.Escape { DetailState.pop-detail(false); return accept; }
        reject
    }
    VerticalLayout {
        padding: 16px; spacing: 12px;
        search := SearchField {
            text <=> DetailState.member-query; label: "Search members"; placeholder-text: "Search members";
            edited(value) => { root.selected = 0; DetailState.filter-members(); pane.jump(0px); }
            clear => { DetailState.member-query = ""; root.selected = 0; DetailState.filter-members(); pane.jump(0px); }
            key-pressed(event) => {
                if event.text == Key.Escape { DetailState.pop-detail(false); return accept; }
                if event.text == Key.DownArrow { list.focus(); return accept; }
                reject
            }
        }
        if DetailState.members.length == 0: Text { text: DetailState.member-query == "" ? "No members" : "No members match your search"; wrap: word-wrap; color: Tokens.secondary; }
        if DetailState.detail-error != "": Text { text: DetailState.detail-error; color: Tokens.danger; font-size: Tokens.small; wrap: word-wrap; }
        list := FocusScope {
            accessible-role: AccessibleRole.list; accessible-label: "Group members";

            key-pressed(event) => {
                if ShellState.ime-active { return reject; }
                if event.text == Key.UpArrow { root.selected = max(0, root.selected - 1); pane.reveal(root.selected, root.row-height); return accept; }
                if event.text == Key.DownArrow { root.selected = min(DetailState.members.length - 1, root.selected + 1); pane.reveal(root.selected, root.row-height); return accept; }
                if event.text == Key.Home { root.selected = 0; pane.jump(0px); return accept; }
                if event.text == Key.End { root.selected = DetailState.members.length - 1; pane.jump(-pane.extent); return accept; }
                if event.text == Key.Return && DetailState.members.length > 0 && !DetailState.members[min(DetailState.members.length - 1, max(0, root.selected))].invited { DetailState.open-member(DetailState.members[min(DetailState.members.length - 1, max(0, root.selected))].id); return accept; }
                reject
            }
            pane := Pane {
                VerticalLayout {
                    spacing: 0px;
                    for member[i] in DetailState.members: VerticalLayout {
                      if member.invited && (i == 0 || !DetailState.members[i - 1].invited): Text { text: "Invited (" + DetailState.invitee-count + ")"; color: Tokens.secondary; }
                      ListRow {
                        width: pane.visible-width; height: root.row-height;
                        background: touch.has-hover ? Tokens.surface : transparent;
                        border-radius: 6px; FocusRing { focused: list.has-focus && root.selected == i; border-radius: 6px; border-color: Tokens.accent; }
                        if !member.invited: Rectangle { width: 100%; height: 100%; accessible-role: button; accessible-label: "Open member: " + member.name + (member.is-self ? ", You" : ""); accessible-action-default => { root.selected=i;list.focus();DetailState.open-member(member.id); } }
                        identity: member.id; initial: member.initial; avatar: member.avatar; title: member.name; subtitle: member.status;
                        title-note: member.is-self ? "You" : member.friend ? "Friend" : "";
                        avatar-size: 40px; trailing-width: 40px;
                        touch := TouchArea { enabled: !member.invited; mouse-cursor: pointer; clicked => { root.selected = i; list.focus(); if !member.invited { DetailState.open-member(member.id); } } }
                        chat-button := IconButton { x: parent.width - 40px; y: (parent.height - 32px) / 2; visible: member.friend && !member.invited && !member.is-self; enabled: self.visible; focus-on-tab-navigation: self.visible && root.selected == i; opacity: touch.has-hover || self.has-hover || self.has-focus || (list.has-focus && ShellState.keyboard-navigation && root.selected == i) ? 1 : 0; label: "Chat with " + member.name; icon: @image-url("../assets/icons/chats.svg"); activated => { DetailState.detail-action(DetailAction.member-chat, member.id); } }
                      }
                    }
                }
            }
        }
    }
}
