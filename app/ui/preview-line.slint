import { RichRun } from "types.slint";
import { State } from "state.slint";
import { Tokens } from "tokens.slint";

export component PreviewLine inherits Rectangle {
    in property <[RichRun]> runs;
    in property <string> prefix;
    in property <brush> text-color;
    property <[RichRun]> source: State.rich-source(root.runs);
    property <[RichRun]> line;
    property <bool> measuring;
    function reflow() {
        if !root.measuring && root.width >= 1px {
            root.measuring = true;
            root.line = State.preview-layout(root.source, root.prefix, root.width / 1px, Tokens.preview / 1px);
            root.measuring = false;
        }
    }
    changed source => { root.reflow(); }
    changed prefix => { root.reflow(); }
    changed width => { root.reflow(); }
    property <length> text-size: Tokens.preview;
    changed text-size => { root.reflow(); }
    init => { root.reflow(); }
    clip: true;
    for run in root.line: Rectangle {
        x: run.x * 1px; width: run.measured-width * 1px; height: parent.height;
        if !run.thumbnail && (!run.emoji || !run.has-picture): Text {
            width: parent.width; height: parent.height;
            text: run.text; color: root.text-color; font-size: run.emoji ? max(11px, Tokens.preview - 2px) : Tokens.preview;
            wrap: no-wrap; overflow: clip; vertical-alignment: center; accessible-role: none;
        }
        if run.has-picture && (run.emoji || run.thumbnail): Rectangle {
            width: run.thumbnail ? Tokens.preview * 1.5 : parent.width;
            height: min(parent.height, Tokens.preview * 1.5);
            y: (parent.height - self.height) / 2;
            border-radius: run.thumbnail ? 4px : 0px; clip: true;
            Image { width: parent.width; height: parent.height; source: run.picture; image-fit: run.thumbnail && !run.contain ? cover : contain; accessible-role: image; accessible-label: run.thumbnail ? "Media thumbnail" : run.text; }
        }
    }
}
