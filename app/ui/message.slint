import { Pressable, FocusRing, Button } from "button.slint";
import { DeliveryState, RecoveryKind, HistoryRowKind, MessageRow, MessageKind, RunPosition } from "types.slint";
import { ReactionChip } from "reaction-chip.slint";
import { ReplyQuote } from "reply-quote.slint";
import { IconButton } from "icon-button.slint";
import { Avatar } from "avatar.slint";
import { DatePill } from "history-pill.slint";
import { State } from "state.slint";
import { Tokens } from "tokens.slint";
import { RichFlow } from "rich-flow.slint";
enum MessageAction { react, select-text, copy-selection, copy-message }
component MessageMenu inherits Rectangle {
    in property <MessageRow> message;
    in property <bool> text-actions;
    in property <bool> rich;
    callback action(MessageAction);
    public function show(position: {x: length, y: length}) { menu.show(position); }
    menu := ContextMenuArea {
        width: 100%; height: 100%;
        Menu {
            if root.message.can-react: MenuItem { title: "Reply"; activated => { State.reply(root.message.id); } }
            if root.message.can-react: MenuItem { title: "React"; activated => { root.action(MessageAction.react); } }
            if root.text-actions && root.rich: MenuItem { title: "Select text"; activated => { root.action(MessageAction.select-text); } }
            if root.text-actions && !root.rich: MenuItem { title: "Copy selection"; activated => { root.action(MessageAction.copy-selection); } }
            if root.text-actions: MenuItem { title: "Copy message"; activated => { root.action(MessageAction.copy-message); } }
            if root.text-actions && root.message.recoverable: MenuItem { title: "Copy to composer"; activated => { State.recover-message(root.message.id); } }
            if root.message.can-unsend: MenuItem { title: "Unsend"; activated => { State.recovery-id = root.message.id; State.recovery-kind = RecoveryKind.unsend; } }
            for link in (root.text-actions && !root.rich ? root.message.links : []): MenuItem { title: "Open link " + link.url; activated => { State.open-link(link.url); } }
            if !root.rich && root.message.kind == MessageKind.photo: MenuItem { title: "Open photo"; activated => { State.open-photo(root.message.image-key); } }
        }
        Rectangle { width: 100%; height: 100%; @children }
    }
}
component TextAction inherits Pressable {
    in property <string> text;
    in property <string> action-label: root.text;
    callback clicked();
    width: label.preferred-width + 8px; height: max(24px, Tokens.small * 1.5);
    horizontal-stretch: 0;
    background: root.has-hover ? Tokens.alternate-background : transparent; animate background { duration: 100ms; }
    label := Text { text: root.text; color: Tokens.accent-strong; font-size: Tokens.small; vertical-alignment: center; horizontal-alignment: center; }
    accessible-label: root.action-label;
    activated => { root.clicked(); }
    FocusRing { thickness: 1px; focused: root.has-focus; border-radius: 0px; border-color: Tokens.accent; }
}
export component Message inherits TouchArea {
    in property <MessageRow> message;
    in property <length> origin-y;
    property <bool> card: root.message.kind == MessageKind.video || root.message.kind == MessageKind.voice || root.message.kind == MessageKind.file || root.message.kind == MessageKind.contact || root.message.kind == MessageKind.location || root.message.kind == MessageKind.undecryptable;
    property <length> avatar-gutter: !root.message.outgoing && root.message.sender-name != "" ? Tokens.message-avatar + Tokens.message-gap : 0px;
    property <length> time-gutter: Tokens.time * 3.8; property <color> bubble-surface: Tokens.surface-2;
    property <length> reaction-x;
    property <color> body-color: Tokens.foreground;
    states [ outgoing when root.message.outgoing: {
        bubble-background.border-top-left-radius: 16px; bubble-background.border-bottom-left-radius: 16px;
        bubble-background.border-top-right-radius: root.message.run-position == RunPosition.middle || root.message.run-position == RunPosition.last ? 4px : 16px;
        bubble-background.border-bottom-right-radius: root.message.run-position == RunPosition.middle || root.message.run-position == RunPosition.first ? 4px : 16px;
        time-gutter: Tokens.time * 4.8; bubble-surface: Tokens.outgoing-bubble; body-color: Tokens.outgoing-foreground;
        reaction-x: min(0px, message-bubble.width - 216px);
        time-slot.x: root.bubble-x - time-slot.width - 4px;
        message-actions.x: (root.shows-time ? time-slot.x : root.bubble-x) - message-actions.width - 4px;
    } ]
    property <length> bubble-limit: max(Tokens.bubble-min, min(Tokens.bubble-max, root.width - root.avatar-gutter - root.time-gutter - Tokens.space-6 - Tokens.space-4 - Tokens.space-1));
    property <bool> shows-time: root.message.run-position == RunPosition.single || root.message.run-position == RunPosition.last;
    property <length> bubble-x: message-content.x + message-column.x + message-bubble.x;
    property <length> bubble-bottom: message-content.y + message-column.y + message-bubble.y + message-bubble.height;
    property <bool> selecting-rich: false; property <bool> rich-focused: false;
    property <bool> card-focused: false; property <bool> rich-fallback: false;
    property <float> rich-width;
    property <bool> showing-rich: root.message.rich-runs.length > 0 && !root.selecting-rich && !root.rich-fallback;
    property <bool> system-item: root.message.kind == MessageKind.system || root.message.kind == MessageKind.withdrawn;
    property <length> anchor-top: root.origin-y + root.y + (root.system-item ? (root.message.day-label != "" ? 27px : 0px) + (root.message.id == State.unread-divider ? 31px : 0px) : message-content.y + message-column.y + message-bubble.y);
    property <length> anchor-height: max(1px, root.height - (root.anchor-top - root.origin-y - root.y));
    public function report-geometry() {
        // The history layout reserves at least 16 px before its first delegate.
        // Initial unlaid-out values must never count as an exposed message.
        if root.origin-y + root.y >= 16px && root.width > 0px && root.anchor-height > 1px {
            State.row-geometry(root.message.row-kind, root.message.id, root.anchor-top, root.anchor-height);
            if root.message.id == State.unread-divider { State.row-geometry(HistoryRowKind.unread, "", root.origin-y + root.y, 28px); }
        }
    }
    changed anchor-top => { root.report-geometry(); }
    changed anchor-height => { root.report-geometry(); }
    init => { root.report-geometry(); }
    VerticalLayout {
                        vertical-stretch: 0; spacing: 2px;
                        padding-top: root.message.run-position == RunPosition.single || root.message.run-position == RunPosition.first ? 12px : 2px;
                        if root.message.id == State.unread-divider: Text { text: "Unread messages"; color: Tokens.accent-strong; font-size: Tokens.small; horizontal-alignment: center; height: 28px; }
                        if root.message.day-label != "": HorizontalLayout { alignment: center; DatePill { text: root.message.day-label; } }
                        if root.system-item: HorizontalLayout { alignment: center; DatePill { text: root.message.body; max-width: root.width - 24px; background: Tokens.surface-2; states [ highlighted when State.highlight-message == root.message.id: { background: Tokens.bubble-selection; in-out { animate background { duration: 120ms; } } } ] } }
                        message-content := HorizontalLayout {
                        visible: !root.system-item; height: self.visible ? self.preferred-height : 0px;
                        spacing: Tokens.message-gap;
                        if root.message.outgoing: Rectangle { min-width: 24px; horizontal-stretch: 1; }
                        if !root.message.outgoing && root.message.sender-name != "": sender-gutter := VerticalLayout {
                            width: Tokens.message-avatar; spacing: 0px; alignment: end;
                            Avatar { width: Tokens.message-avatar; height: Tokens.message-avatar; visible: root.message.run-position == RunPosition.single || root.message.run-position == RunPosition.last; identity: root.message.sender-id; initial: root.message.sender-initial; picture: root.message.sender-avatar; label: root.message.sender-name + " avatar"; TouchArea { accessible-role: button; accessible-label: "Profile: " + root.message.sender-name; accessible-action-default => { State.open-member(root.message.sender-id); } clicked => { State.open-member(root.message.sender-id); } } }
                        }
                        message-column := VerticalLayout {
                            horizontal-stretch: 0;
                            min-width: min(root.bubble-limit, root.message.image-key != "" || root.message.kind == MessageKind.photo ? 200px : 24px);
                            preferred-width: root.card ? min(300px, root.bubble-limit) : root.message.image-key != "" || root.message.kind == MessageKind.photo ? min(340px, root.bubble-limit) : min(root.bubble-limit, text-body.preferred-width + 24px);
                            max-width: root.bubble-limit; spacing: 3px;
                            if (root.message.run-position == RunPosition.single || root.message.run-position == RunPosition.first) && !root.message.outgoing && root.message.sender-name != "": Text {
                                text: root.message.sender-name; accessible-label: "Sender: " + root.message.sender-name;
                                color: Tokens.secondary; font-size: Tokens.small; overflow: elide;
                                TouchArea { accessible-role: button; accessible-label: "Sender profile: " + root.message.sender-name; accessible-action-default => { State.open-member(root.message.sender-id); } clicked => { State.open-member(root.message.sender-id); } }
                            }
                            message-bubble := MessageMenu {
                                    reactions := PopupWindow {
                                        x: root.reaction-x; y: -48px;
                                        width: 216px; height: 44px;
                                        Rectangle { background: Tokens.bg; border-radius: 20px; border-width: 1px; border-color: Tokens.border;
                                            FocusScope {
                                                key-pressed(event) => { if State.ime-active { return reject; } if event.text == Key.Escape { reactions.close(); return accept; } reject }
                                                HorizontalLayout { padding: 6px; spacing: 2px;
                                                    for kind in State.reaction-kinds: Rectangle {
                                                        width: 32px; height: 32px; border-radius: 16px;
                                                        background: root.message.own-reaction == kind.id ? Tokens.surface-selected : reaction-touch.has-hover ? Tokens.surface-hover : transparent;
                                                        Text { text: kind.glyph; font-size: 20px; horizontal-alignment: center; vertical-alignment: center; }
                                                        reaction-touch := Pressable {
                                                            FocusRing { focused: parent.has-focus; border-radius: 16px; }
                                                            accessible-label: kind.label; accessible-item-selected: root.message.own-reaction == kind.id;
                                                            activated => { State.react(root.message.id, kind.id); reactions.close(); }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                message: root.message;
                                text-actions: false; rich: false;
                                action(kind) => {
                                    if kind == MessageAction.react { reactions.show(); }
                                    else if kind == MessageAction.select-text { root.selecting-rich = true; body.focus(); }
                                    else if kind == MessageAction.copy-selection { body.copy(); }
                                    else { State.copy-text(root.message.body); }
                                }
                                property <bool> selected: body.has-focus || root.card-focused || root.rich-focused || (State.highlight-message == root.message.id);
                                bubble-background := Rectangle { width: 100%; height: 100%;
                                background: root.bubble-surface; border-color: Tokens.border;
                                border-top-left-radius: (root.message.run-position == RunPosition.middle || root.message.run-position == RunPosition.last) ? 4px : 16px;
                                border-bottom-left-radius: (root.message.run-position == RunPosition.middle || root.message.run-position == RunPosition.first) ? 4px : 16px;
                                border-top-right-radius: 16px; border-bottom-right-radius: 16px;
                                states [
                                    selected when message-bubble.selected: { background: Tokens.bubble-selection; border-width: 2px; border-color: Tokens.bubble-selection-border; in-out { animate background { duration: 120ms; } } }
                                    media when root.message.kind == MessageKind.sticker || root.message.kind == MessageKind.photo: { background: transparent; }
                                ]
                                }
                                height: bubble-content.preferred-height;
                                bubble-content := VerticalLayout {
                                    padding-top: 8px; padding-bottom: 8px; padding-left: 12px; padding-right: 12px; spacing: 6px; alignment: start;
                                    if root.message.reply-id != "": ReplyQuote {
                                        surface: root.bubble-surface;
                                        sender: root.message.reply-sender; sender-id: root.message.reply-sender-id; preview: root.message.reply-preview;
                                        picture: root.message.reply-picture; has-picture: root.message.reply-has-picture;
                                        quote-focus := Pressable {
                                            accessible-label: "Jump to replied message"; accessible-description: root.message.reply-preview;
                                            activated => { State.jump-message(root.message.reply-id); }
                                            FocusRing { thickness: 1px; focused: parent.has-focus; border-radius: 0px; border-color: Tokens.accent; }
                                        }
                                    }
                                    text-body := MessageMenu {
                                        message: root.message; text-actions: true; rich: false;
                                        action(kind) => { message-bubble.action(kind); }
                                        visible: root.message.kind != MessageKind.photo && !root.card && root.message.body != "" && (root.message.kind != MessageKind.sticker || root.message.image-key == "");
                                        height: self.visible ? body.preferred-height : 0px; preferred-width: body.preferred-width;
                                        states [ rich when root.showing-rich: {
                                            height: rich-flow.height; rich: true; rich-body.visible: true; body.visible: false;
                                            preferred-width: root.rich-width > 0 ? root.rich-width * 1px : Tokens.bubble-max;
                                        } ]
                                        rich-body := Rectangle {
                                            visible: false;
                                            rich-focus := FocusScope {
                                                accessible-role: text; accessible-label: root.message.accessible-label; accessible-value: root.message.body; accessible-description: root.message.accessible-label;
                                                changed has-focus => { root.rich-focused = self.has-focus; }
                                                accessible-action-default => { self.focus(); }
                                                key-pressed(event) => {
                                                    if State.ime-active { return reject; }
                                                    if event.text == Key.Tab { if event.modifiers.shift { State.focus-history(); } else if root.message.can-react { react-button.focus(); } else { State.focus-composer(); } return accept; }
                                                    return State.reading-key(event);
                                                }
                                            }
                                            TouchArea {
                                                clicked => { rich-focus.focus(); }
                                                pointer-event(event) => { if event.kind == PointerEventKind.down && event.button == PointerEventButton.right { text-body.show({ x: self.mouse-x, y: self.mouse-y }); } }
                                            }
                                            rich-flow := RichFlow {
                                                text-color: root.body-color; runs: root.message.rich-runs; width: parent.width;
                                                natural-width(width) => { root.rich-width = width; }
                                                fallback(failed) => { root.rich-fallback = failed; }
                                                select-text => { if !root.message.has-inline-emoji { root.selecting-rich = true; body.focus(); body.select-all(); } }
                                            }
                                        }
                                        body := TextInput {
                                            text: root.message.body; read-only: true; single-line: false; text-cursor-width: 0px;
                                            wrap: word-wrap; color: root.body-color;
                                            font-size: Tokens.base; height: self.preferred-height;
                                            accessible-label: root.message.accessible-label; selection-background-color: Tokens.message-selection;
                                            selection-foreground-color: Tokens.message-selection-foreground;
                                            key-pressed(event) => {
                                                if State.ime-active { return reject; }
                                                if event.text == Key.Tab { if event.modifiers.shift { State.focus-history(); } else if root.message.can-react { react-button.focus(); } else if !State.following && State.has-chat { State.focus-reading-before-editor(); } else { State.focus-composer(); } return accept; }
                                                if State.reading-key(event) == accept { return accept; }
                                                reject
                                            }
                                            property <bool> selecting: self.has-focus && self.anchor-position-byte-offset != self.cursor-position-byte-offset;
                                            changed selecting => { State.history-interacting = self.selecting; if self.selecting { State.following = false; State.history-scrolled(); } }
                                        }
                                    }
                                    if root.selecting-rich: Button { text: root.message.has-inline-emoji ? "Show emoji" : "Show message"; clicked => { root.selecting-rich = false; } }
                                    if root.card: HorizontalLayout {
                                        spacing: 12px; height: max(48px, card-title.preferred-height + card-meta.preferred-height + 4px);
                                        Rectangle { width: 40px; height: 40px; border-radius: 8px; background: Tokens.bg.with-alpha(0.6);
                                            Image { x: 10px; y: 10px; width: 20px; height: 20px; colorize: Tokens.text; source: root.message.kind == MessageKind.video ? @image-url("../assets/icons/video.svg") : root.message.kind == MessageKind.voice ? @image-url("../assets/icons/voice.svg") : root.message.kind == MessageKind.file ? @image-url("../assets/icons/file.svg") : root.message.kind == MessageKind.contact ? @image-url("../assets/icons/contact.svg") : root.message.kind == MessageKind.location ? @image-url("../assets/icons/location.svg") : root.message.kind == MessageKind.undecryptable ? @image-url("../assets/icons/lock.svg") : @image-url("../assets/icons/unknown.svg"); }
                                        }
                                        VerticalLayout { spacing: 4px; alignment: center;
                                            card-title := TextInput { changed has-focus => { root.card-focused = self.has-focus; } read-only: true; single-line: false; text-cursor-width: 0px; text: root.message.body; color: Tokens.text; font-size: Tokens.base; font-weight: 600; wrap: word-wrap; accessible-label: root.message.accessible-label; key-pressed(event) => { if event.text == Key.Tab { if event.modifiers.shift { State.focus-history(); } else if root.message.can-react { react-button.focus(); } else { State.focus-composer(); } return accept; } State.reading-key(event) } }
                                            card-meta := Text { text: root.message.detail; color: Tokens.secondary; font-size: Tokens.small; }
                                        }
                                        if root.message.kind == MessageKind.file && (root.message.delivery == DeliveryState.sent || root.message.delivery == DeliveryState.read) && (!root.message.file-failed || root.message.file-retryable): IconButton { label: root.message.file-failed ? "Retry file" : "Save"; icon: @image-url("../assets/icons/save.svg"); enabled: !State.file-saving && !root.message.local-media; activated => { State.save-file(root.message.id); } }
                                    }
                                    if !root.card && root.message.detail != "": Rectangle {
                                        height: detail.preferred-height;
                                        detail := Text { x: 0px; y: 0px; width: parent.width; text: root.message.detail; font-size: Tokens.small; color: Tokens.secondary; wrap: word-wrap; }
                                    }
                                    if root.message.uploading && root.card: Rectangle { height: 3px; background: Tokens.surface-2;
                                        accessible-role: text; accessible-label: "Uploading " + round(root.message.upload-progress * 100) + "%";
                                        Rectangle { x: 0px; y: 0px; height: 100%; width: parent.width * root.message.upload-progress; background: Tokens.accent; }
                                    }
                                    if root.message.file-failed: Text { text: root.message.file-error; color: Tokens.secondary; font-size: Tokens.small; wrap: word-wrap; }
                                    if State.file-save-id == root.message.id && State.file-save-status != "": Rectangle {
                                        height: saved.preferred-height;
                                        saved := Text { x: 0px; y: 0px; width: parent.width; text: State.file-save-status; font-size: Tokens.small; color: Tokens.secondary; wrap: word-wrap; }
                                    }
                                    if root.message.image-key != "" || root.message.kind == MessageKind.photo: Rectangle {
                                        // Geometry does not change when a thumbnail arrives or fails.
                                        height: root.message.kind == MessageKind.sticker ? 120px : 180px;
                                        border-radius: 12px; clip: true;
                                        Image { source: root.message.picture; width: 100%; height: 100%; image-fit: contain; visible: root.message.has-picture; accessible-role: image; accessible-label: root.message.kind == MessageKind.photo ? "Photo preview" : root.message.kind == MessageKind.sticker ? "Sticker" : "Message image"; }
                                        // Software clips are rectangular: cover the four outside corners
                                        // at the contained image's actual bounds, without touching cached pixels.
                                        if root.message.kind == MessageKind.photo && root.message.has-picture: Rectangle {
                                            width: min(parent.width, parent.height * root.message.picture.width / max(1, root.message.picture.height));
                                            height: min(parent.height, parent.width * root.message.picture.height / max(1, root.message.picture.width));
                                            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                            Image { x: 0px; y: 0px; width: 12px; height: 12px; source: @image-url("../assets/photo-corner-0.svg"); colorize: Tokens.bg; }
                                            Image { x: parent.width - 12px; y: 0px; width: 12px; height: 12px; source: @image-url("../assets/photo-corner-1.svg"); colorize: Tokens.bg; }
                                            Image { x: parent.width - 12px; y: parent.height - 12px; width: 12px; height: 12px; source: @image-url("../assets/photo-corner-2.svg"); colorize: Tokens.bg; }
                                            Image { x: 0px; y: parent.height - 12px; width: 12px; height: 12px; source: @image-url("../assets/photo-corner-3.svg"); colorize: Tokens.bg; }
                                        }
                                        if root.message.kind == MessageKind.photo && root.message.has-picture: FocusScope {
                                            accessible-role: button; accessible-label: "Open photo";
                                            property <bool> viewer-open: State.viewer-open;
                                            changed viewer-open => { if !self.viewer-open && root.message.image-key == State.viewer-key { self.focus(); } }
                                            accessible-action-default => { self.focus(); State.open-photo(root.message.image-key); }
                                            key-pressed(event) => { if !State.ime-active && (event.text == Key.Return || event.text == " ") { State.open-photo(root.message.image-key); return accept; } reject }
                                            TouchArea {
                                                clicked => { parent.focus(); State.open-photo(root.message.image-key); }
                                                pointer-event(event) => { if event.kind == PointerEventKind.down && event.button == PointerEventButton.right { message-bubble.show({x: self.mouse-x, y: self.mouse-y}); } }
                                            }
                                            FocusRing { focused: parent.has-focus; border-radius: 0px; border-color: Tokens.accent; }
                                        }
                                        if root.message.uploading: Rectangle {
                                            width: root.message.has-picture ? min(parent.width, parent.height * root.message.picture.width / max(1, root.message.picture.height)) : parent.width;
                                            x: (parent.width - self.width) / 2;
                                            y: root.message.has-picture ? (parent.height + min(parent.height, parent.width * root.message.picture.height / max(1, root.message.picture.width))) / 2 - 3px : parent.height - 3px;
                                            height: 3px; background: Tokens.surface-2;
                                            accessible-role: text; accessible-label: "Uploading " + round(root.message.upload-progress * 100) + "%";
                                            Rectangle { x: 0px; y: 0px; height: 100%; width: parent.width * root.message.upload-progress; background: Tokens.accent; }
                                        }
                                        if !root.message.has-picture: VerticalLayout {
                                            padding: 8px; spacing: 8px; alignment: center;
                                            Text { text: root.message.image-failed ? root.message.image-error : root.message.kind == MessageKind.sticker ? root.message.body : root.message.image-key == "" ? "Photo unavailable" : "Loading image…"; color: !root.message.image-failed && root.message.kind == MessageKind.sticker ? Tokens.foreground : Tokens.secondary; horizontal-alignment: center; wrap: word-wrap; }
                                            if root.message.image-failed && root.message.image-retryable: HorizontalLayout { alignment: center; TextAction { text: "Retry"; action-label: "Retry image"; clicked => { State.retry-image(root.message.image-key); } } }
                                        }
                                    }
                                }
                            }
                            if State.reaction-error-id == root.message.id: Text { text: "Couldn't react."; color: Tokens.danger; font-size: Tokens.time; }
                            if State.unsend-feedback-id == root.message.id: Text { text: "Couldn't unsend."; color: Tokens.danger; font-size: Tokens.time; }
                            if root.message.recoverable: HorizontalLayout {
                                spacing: 8px; alignment: start;
                                Text { text: root.message.delivery-detail; wrap: word-wrap; min-width: 0px; horizontal-stretch: 1; color: Tokens.danger; font-size: Tokens.small; vertical-alignment: center; }
                                TextAction {
                                    text: root.message.file-missing ? "File missing" : "Retry"; focus-on-activation: false;
                                    enabled: State.connected && !root.message.file-missing;
                                    clicked => { State.retry-message(root.message.id); }
                                }
                                TextAction { text: "Delete"; clicked => { State.discard-message(root.message.id); } }
                            }
                            if root.message.reaction-count > 0: HorizontalLayout {
                                alignment: start; spacing: 4px;
                                for reaction in root.message.reactions: ReactionChip { reaction: reaction; groups: root.message.reactions; }
                            }
                        }
                        if !root.message.outgoing: Rectangle { min-width: 24px; horizontal-stretch: 1; }
                        }
    }
    // Time appears once at the end of a run, beside the
    // bubble. Time and status use their content width without adding a row.
    time-slot := Rectangle {
        visible: !root.system-item; x: root.bubble-x + message-bubble.width + 4px;
        y: root.bubble-bottom - self.height; width: root.shows-time ? time-content.preferred-width : 0px;
        height: max(16px, Tokens.time * 1.4);
        time-content := HorizontalLayout {
            height: max(16px, Tokens.time * 1.4); spacing: 2px;
            Text { text: root.shows-time ? root.message.clock : ""; accessible-label: root.shows-time ? root.message.time : ""; color: Tokens.secondary; font-size: Tokens.time; }
            if root.message.outgoing && (root.message.run-position == RunPosition.single || root.message.run-position == RunPosition.last): Image {
                width: 16px; height: 16px;
                source: @image-url("../assets/icons/check.svg"); accessible-role: image;
                accessible-label: "Sent"; colorize: Tokens.secondary;
                states [
                    pending when root.message.delivery == DeliveryState.pending: { source: @image-url("../assets/icons/clock.svg"); accessible-label: "Sending"; }
                    read when root.message.delivery == DeliveryState.read: { source: @image-url("../assets/icons/check-double.svg"); accessible-label: "Read"; colorize: Tokens.accent-strong; }
                    rejected when root.message.delivery == DeliveryState.rejected: { source: @image-url("../assets/icons/error.svg"); accessible-label: "Not sent"; colorize: Tokens.danger; }
                ]
            }
        }
    }
    message-actions := Rectangle {
        x: (root.shows-time ? time-slot.x + time-slot.width : root.bubble-x + message-bubble.width) + 4px; y: root.bubble-bottom - self.height;
        width: 58px; height: 28px;
        reply-button := IconButton {
            x: 30px; y: 0px; width: 28px; height: 28px; label: "Reply"; icon: @image-url("../assets/icons/reply.svg");
            visible: root.message.can-react && (root.has-hover || message-bubble.selected || self.has-focus || react-button.has-focus);
            activated => { State.reply(root.message.id); }
            key-event(event) => { if event.text == Key.Tab { if event.modifiers.shift { react-button.focus(); } else { State.focus-composer(); } return accept; } reject }
        }
        react-button := IconButton {
            x: 0px; y: 0px;
            width: 28px; height: 28px; border-radius: 14px;
            label: "React"; icon: @image-url("../assets/icons/react.svg");
            visible: root.message.can-react && (root.has-hover || message-bubble.selected || self.has-focus || reply-button.has-focus);
            activated => { reactions.show(); }
            key-event(event) => { if event.text == Key.Tab { if event.modifiers.shift { if root.card { State.focus-history(); } else { body.focus(); } } else { reply-button.focus(); } return accept; } reject }
        }
    }
}
