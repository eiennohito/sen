import { ReplyQuote } from "reply-quote.slint";
import { IconButton } from "icon-button.slint";
import { Avatar } from "avatar.slint";
import { DatePill } from "history-pill.slint";
import { Button } from "button.slint";
import { LineEdit, TextEdit, ScrollView, ComboBox } from "std-widgets.slint";
import { State } from "state.slint";
import { Tokens } from "tokens.slint";
import { ChatRow, FriendRow, MessageRow, ReactionRow, MessageKind } from "types.slint";
import { RichFlow } from "rich-flow.slint";
import { Pane } from "scrollpane.slint";

component TextAction inherits Rectangle {
    in property <string> text;
    in property <string> action-label: root.text;
    in property <bool> enabled: true;
    in property <bool> focus-on-click: true;
    callback clicked();
    width: label.preferred-width + 8px; height: max(24px, Tokens.small * 1.5);
    horizontal-stretch: 0;
    background: touch.has-hover ? Tokens.alternate-background : transparent;
    opacity: root.enabled ? 1 : 0.45;
    label := Text { text: root.text; color: Tokens.accent-strong; font-size: Tokens.small; vertical-alignment: center; horizontal-alignment: center; }
    action-focus := FocusScope {
        enabled: root.enabled; accessible-role: button; accessible-label: root.action-label;
        accessible-action-default => { if root.enabled { root.clicked(); } }
        key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.clicked(); return accept; } reject }
        Rectangle { background: transparent; border-width: parent.has-focus ? 1px : 0px; border-color: Tokens.accent; }
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { if root.focus-on-click { action-focus.focus(); } root.clicked(); } }
    public function focus-action() { action-focus.focus(); }
}

export component Message inherits TouchArea {
    in property <MessageRow> message;
    in property <length> origin-y;
    property <bool> card: root.message.kind == MessageKind.video || root.message.kind == MessageKind.voice || root.message.kind == MessageKind.file || root.message.kind == MessageKind.contact || root.message.kind == MessageKind.location || root.message.kind == MessageKind.undecryptable;
    property <length> bubble-limit: max(72px, min(480px, root.width - (!root.message.outgoing && root.message.sender-name != "" ? 37px : 0px) - 56px - (root.message.outgoing ? Tokens.time * 4.8 : Tokens.time * 3.8) - 44px));
    property <bool> selecting-rich: false;
    property <bool> rich-focused: false;
    property <bool> card-focused: false;
    property <bool> rich-fallback: false;
    property <float> rich-width;
    property <bool> copying-rich;
    property <bool> showing-rich: root.message.rich-runs.length > 0 && !root.selecting-rich && !root.rich-fallback;
    function copy-message() { root.copying-rich = true; body.select-all(); body.copy(); root.copying-rich = false; }

    property <bool> system-item: root.message.kind == MessageKind.system || root.message.kind == MessageKind.withdrawn;
    property <length> anchor-top: root.origin-y + root.y + (root.system-item ? (root.message.day-label != "" ? 27px : 0px) + (root.message.id == State.unread-divider ? 31px : 0px) : message-content.y + message-column.y + message-bubble.y);
    property <length> anchor-height: max(1px, root.height - (root.anchor-top - root.origin-y - root.y));
    public function report-geometry() {
        // The history layout reserves at least 16 px before its first delegate.
        // Initial unlaid-out values must never count as an exposed message.
        if root.origin-y + root.y >= 16px && root.width > 0px && root.anchor-height > 1px {
            State.row-geometry(root.message.id, root.anchor-top, root.anchor-height);
            if root.message.id == State.unread-divider { State.row-geometry("unread", root.origin-y + root.y, 28px); }
        }
    }
    changed anchor-top => { root.report-geometry(); }
    changed anchor-height => { root.report-geometry(); }
    init => { root.report-geometry(); }
    VerticalLayout {
                        vertical-stretch: 0; spacing: 2px;
                        padding-top: root.message.run-position == "single" || root.message.run-position == "first" ? 12px : 2px;
                        if root.message.id == State.unread-divider: Text { text: "Unread messages"; color: Tokens.accent-strong; font-size: Tokens.small; horizontal-alignment: center; height: 28px; }
                        if root.message.day-label != "": HorizontalLayout { alignment: center; DatePill { text: root.message.day-label; } }
                        if root.system-item: HorizontalLayout { alignment: center; DatePill { text: root.message.body; max-width: root.width - 24px; background: State.highlight-message == root.message.id ? Tokens.bubble-selection : Tokens.surface-2; } }
                        message-content := HorizontalLayout {
                        visible: !root.system-item;
                        height: root.system-item ? 0px : self.preferred-height;
                        spacing: 5px;
                        if root.message.outgoing: Rectangle { min-width: 24px; horizontal-stretch: 1; }
                        if !root.message.outgoing && root.message.sender-name != "": VerticalLayout {
                            width: 32px; spacing: 0px; alignment: end;
                            Avatar { width: 32px; height: 32px; visible: root.message.run-position == "single" || root.message.run-position == "last"; identity: root.message.sender-id; initial: root.message.sender-initial; picture: root.message.sender-avatar; label: root.message.sender-name + " avatar"; TouchArea { accessible-role: button; accessible-label: "Profile: " + root.message.sender-name; accessible-action-default => { State.open-member(root.message.sender-id); } clicked => { State.open-member(root.message.sender-id); } } }
                        }
                        message-column := VerticalLayout {
                            horizontal-stretch: 0;
                            min-width: min(root.bubble-limit, root.message.image-key != "" || root.message.photo ? 200px : 24px);
                            preferred-width: root.card ? min(300px, root.bubble-limit) : root.message.image-key != "" || root.message.photo ? min(340px, root.bubble-limit) : min(root.bubble-limit, (root.showing-rich ? (root.rich-width > 0 ? root.rich-width * 1px : 480px) : body-measure.preferred-width) + 24px);
                            max-width: max(72px, min(480px, root.bubble-limit));
                            spacing: 3px;
                            if (root.message.run-position == "single" || root.message.run-position == "first") && !root.message.outgoing && root.message.sender-name != "": Text {
                                text: root.message.sender-name; accessible-label: "Sender: " + root.message.sender-name;
                                color: Tokens.secondary; font-size: Tokens.small; overflow: elide;
                                TouchArea { accessible-role: button; accessible-label: "Sender profile: " + root.message.sender-name; accessible-action-default => { State.open-member(root.message.sender-id); } clicked => { State.open-member(root.message.sender-id); } }
                            }
                            message-bubble := ContextMenuArea {
                                    reactions := PopupWindow {
                                        x: root.message.outgoing ? min(0px, message-bubble.width - 216px) : 0px; y: -48px;
                                        width: 216px; height: 44px;
                                        Rectangle { background: Tokens.bg; border-radius: 20px; border-width: 1px; border-color: Tokens.border;
                                            FocusScope {
                                                key-pressed(event) => { if State.ime-active { return reject; } if event.text == Key.Escape { reactions.close(); return accept; } reject }
                                                HorizontalLayout { padding: 6px; spacing: 2px;
                                                    for label[i] in ["👍", "❤️", "😆", "😮", "😢", "😰"]: Rectangle {
                                                        width: 32px; height: 32px; border-radius: 16px;
                                                        background: root.message.own-reaction == i + 2 ? Tokens.surface-selected : reaction-touch.has-hover ? Tokens.surface-hover : transparent;
                                                        Text { text: label; font-size: 20px; horizontal-alignment: center; vertical-alignment: center; }
                                                        FocusScope { accessible-description: self.has-focus ? "Focused" : "";
                                                            Rectangle { background: transparent; border-radius: 16px; border-width: parent.has-focus ? 2px : 0px; border-color: Tokens.accent-strong; }
                                                            accessible-role: button; accessible-label: ["NICE", "LOVE", "FUN", "AMAZING", "SAD", "OMG"][i]; accessible-item-selected: root.message.own-reaction == i + 2;
                                                            accessible-action-default => { State.react(root.message.id, i + 2); reactions.close(); }
                                                            key-pressed(event) => { if event.text == Key.Return || event.text == " " { State.react(root.message.id, i + 2); reactions.close(); return accept; } reject }
                                                        }
                                                        reaction-touch := TouchArea { clicked => { State.react(root.message.id, i + 2); reactions.close(); } }
                                                    }
                                                }
                                            }
                                        }
                                    }

                                Menu {
                                    if root.message.can-react: MenuItem { title: "Reply"; activated => { State.reply(root.message.id); } }
                                    if root.message.can-react: MenuItem { title: "React"; activated => { reactions.show(); } }
                                    if root.message.recoverable: MenuItem { title: "Copy to composer"; activated => { State.recover-message(root.message.id); } }
                                    if root.message.can-unsend: MenuItem { title: "Unsend"; activated => { State.recovery-id = root.message.id; State.recovery-kind = "unsend"; } }
                                }
                                property <bool> selected: body.has-focus || root.card-focused || root.rich-focused || State.highlight-message == root.message.id;
                                Rectangle { width: 100%; height: 100%;
                                background: parent.selected ? Tokens.bubble-selection : root.message.sticker || root.message.photo ? transparent : root.message.outgoing ? Tokens.outgoing-bubble : Tokens.surface-2;
                                border-width: parent.selected ? 2px : 0px;
                                border-color: parent.selected ? Tokens.bubble-selection-border : Tokens.border;
                                border-top-left-radius: !root.message.outgoing && (root.message.run-position == "middle" || root.message.run-position == "last") ? 4px : 16px;
                                border-bottom-left-radius: !root.message.outgoing && (root.message.run-position == "middle" || root.message.run-position == "first") ? 4px : 16px;
                                border-top-right-radius: root.message.outgoing && (root.message.run-position == "middle" || root.message.run-position == "last") ? 4px : 16px;
                                border-bottom-right-radius: root.message.outgoing && (root.message.run-position == "middle" || root.message.run-position == "first") ? 4px : 16px;
                                }
                                height: bubble-content.preferred-height;
                                body-measure := Text { visible: false; text: root.showing-rich ? "" : root.message.body; font-size: Tokens.base; wrap: word-wrap; }
                                bubble-content := VerticalLayout {
                                    padding-top: 8px; padding-bottom: 8px; padding-left: 12px; padding-right: 12px; spacing: 6px; alignment: start;
                                    if root.message.reply-id != "": ReplyQuote {
                                        sender: root.message.reply-sender; sender-id: root.message.reply-sender-id; preview: root.message.reply-preview;
                                        picture: root.message.reply-picture; has-picture: root.message.reply-has-picture;
                                        quote-focus := FocusScope {
                                            accessible-role: button; accessible-label: "Jump to replied message"; accessible-description: root.message.reply-preview;
                                            accessible-action-default => { State.jump-message(root.message.reply-id); }
                                            key-pressed(event) => { if event.text == Key.Return || event.text == " " { State.jump-message(root.message.reply-id); return accept; } reject }
                                            Rectangle { background: transparent; border-width: parent.has-focus ? 1px : 0px; border-color: Tokens.accent; }
                                        }
                                        TouchArea { mouse-cursor: pointer; clicked => { quote-focus.focus(); State.jump-message(root.message.reply-id); } }
                                    }
                                    if root.message.rich-runs.length > 0 && !root.selecting-rich: ContextMenuArea {
                                        visible: !root.rich-fallback;
                                        height: self.visible ? rich-flow.height : 0px;
                                        Menu {
                                            if root.message.can-react: MenuItem { title: "Reply"; activated => { State.reply(root.message.id); } }
                                    if root.message.can-react: MenuItem { title: "React"; activated => { reactions.show(); } }
                                            MenuItem { title: "Select text"; activated => { root.selecting-rich = true; body.focus(); } }
                                            MenuItem { title: "Copy message"; activated => { root.copy-message(); } }
                                            if root.message.recoverable: MenuItem { title: "Copy to composer"; activated => { State.recover-message(root.message.id); } }
                                            if root.message.can-unsend: MenuItem { title: "Unsend"; activated => { State.recovery-id = root.message.id; State.recovery-kind = "unsend"; } }
                                        }
                                        rich-focus := FocusScope {
                                            accessible-role: text; accessible-label: root.message.accessible-label; accessible-value: root.message.body; accessible-description: self.has-focus ? "Focused message" : root.message.accessible-label;
                                            changed has-focus => { root.rich-focused = self.has-focus; }
                                            accessible-action-default => { self.focus(); }
                                            key-pressed(event) => {
                                                if State.ime-active { return reject; }
                                                if event.text == Key.Tab { if event.modifiers.shift { State.focus-history(); } else if root.message.can-react { react-button.focus-button(); } else { State.focus-composer(); } return accept; }
                                                return State.reading-key(event);
                                            }
                                        }
                                        TouchArea {
                                            clicked => { rich-focus.focus(); }
                                            pointer-event(event) => { if event.kind == PointerEventKind.down && event.button == PointerEventButton.right { parent.show({ x: self.mouse-x, y: self.mouse-y }); } }
                                        }
                                        rich-flow := RichFlow {
                                            text-color: root.message.outgoing ? Tokens.outgoing-foreground : Tokens.foreground; runs: root.message.rich-runs; width: parent.width;
                                            natural-width(width) => { root.rich-width = width; }
                                            fallback(failed) => { root.rich-fallback = failed; }
                                            select-text => { if !root.message.has-inline-emoji { root.selecting-rich = true; body.focus(); body.select-all(); } }
                                        }
                                    }
                                    if root.selecting-rich: Button { text: root.message.has-inline-emoji ? "Show emoji" : "Show message"; clicked => { root.selecting-rich = false; } }
                                    ContextMenuArea {
                                        visible: !root.message.photo && !root.card && root.message.body != "" && (!root.message.sticker || root.message.image-key == "") && (root.message.rich-runs.length == 0 || root.selecting-rich || root.rich-fallback);
                                        height: self.visible ? body.preferred-height : 0px;
                                        Menu {
                                            if root.message.can-react: MenuItem { title: "Reply"; activated => { State.reply(root.message.id); } }
                                    if root.message.can-react: MenuItem { title: "React"; activated => { reactions.show(); } }
                                            MenuItem { title: "Copy selection"; activated => { body.copy(); } }
                                            MenuItem { title: "Copy message"; activated => { root.copy-message(); } }
                                            if root.message.recoverable: MenuItem { title: "Copy to composer"; activated => { State.recover-message(root.message.id); } }
                                            if root.message.can-unsend: MenuItem { title: "Unsend"; activated => { State.recovery-id = root.message.id; State.recovery-kind = "unsend"; } }
                                            for link in root.message.links: MenuItem { title: "Open link " + link.url; activated => { State.open-link(link.url); } }
                                            if root.message.photo: MenuItem { title: "Open photo"; activated => { State.open-photo(root.message.image-key); } }
                                        }
                                        body := TextInput {
                                            text: root.showing-rich && !root.copying-rich ? "" : root.message.body; read-only: true; single-line: false; text-cursor-width: 0px;
                                            wrap: body-measure.min-width > self.width ? char-wrap : word-wrap; color: root.message.outgoing ? Tokens.outgoing-foreground : Tokens.foreground;
                                            font-size: Tokens.base;
                                            height: root.showing-rich ? 0px : self.preferred-height;
                                            accessible-label: root.message.accessible-label;
                                            selection-background-color: Tokens.message-selection;
                                            selection-foreground-color: Tokens.message-selection-foreground;
                                            // Explicit surface traversal is the click-only equivalent on Slint 1.18.
                                            key-pressed(event) => {
                                                if State.ime-active { return reject; }
                                                if event.text == Key.Tab { if event.modifiers.shift { State.focus-history(); } else if root.message.can-react { react-button.focus-button(); } else if !State.following && State.has-chat { State.focus-reading-before-editor(); } else { State.focus-composer(); } return accept; }
                                                if State.reading-key(event) == accept { return accept; }
                                                reject
                                            }
                                            changed has-focus => { if !self.has-focus && State.history-interacting { State.history-interacting = false;  } }
                                            changed anchor-position-byte-offset => { State.history-interacting = self.has-focus && self.anchor-position-byte-offset != self.cursor-position-byte-offset; if State.history-interacting { State.following = false; State.history-scrolled(); } else {  } }
                                            changed cursor-position-byte-offset => { State.history-interacting = self.has-focus && self.anchor-position-byte-offset != self.cursor-position-byte-offset; if State.history-interacting { State.following = false; State.history-scrolled(); } else {  } }
                                        }
                                    }
                                    if root.card: HorizontalLayout {
                                        spacing: 12px; height: max(48px, card-title.preferred-height + card-meta.preferred-height + 4px);
                                        Rectangle { width: 40px; height: 40px; border-radius: 8px; background: Tokens.bg.with-alpha(0.6);
                                            Image { x: 10px; y: 10px; width: 20px; height: 20px; colorize: Tokens.text;
                                                source: root.message.kind == MessageKind.video ? @image-url("../assets/icons/video.svg") : root.message.kind == MessageKind.voice ? @image-url("../assets/icons/voice.svg") : root.message.kind == MessageKind.file ? @image-url("../assets/icons/file.svg") : root.message.kind == MessageKind.contact ? @image-url("../assets/icons/contact.svg") : root.message.kind == MessageKind.location ? @image-url("../assets/icons/location.svg") : root.message.kind == MessageKind.undecryptable ? @image-url("../assets/icons/lock.svg") : @image-url("../assets/icons/unknown.svg");
                                            }
                                        }
                                        VerticalLayout { spacing: 4px; alignment: center;
                                            card-title := TextInput { changed has-focus => { root.card-focused = self.has-focus; } read-only: true; single-line: false; text-cursor-width: 0px; text: root.message.body; color: Tokens.text; font-size: Tokens.base; font-weight: 600; wrap: word-wrap; accessible-label: root.message.accessible-label; key-pressed(event) => { if event.text == Key.Tab { if event.modifiers.shift { State.focus-history(); } else if root.message.can-react { react-button.focus-button(); } else { State.focus-composer(); } return accept; } State.reading-key(event) } }
                                            card-meta := Text { text: root.message.detail; color: Tokens.secondary; font-size: Tokens.small; }
                                        }
                                        if root.message.kind == MessageKind.file && (root.message.delivery == "Sent" || root.message.delivery == "Read") && (!root.message.file-failed || root.message.file-retryable): IconButton { label: root.message.file-failed ? "Retry file" : "Save"; icon: @image-url("../assets/icons/save.svg"); enabled: !State.file-saving && !root.message.local-media; activated => { State.save-file(root.message.id); } }
                                    }
                                    if !root.card && root.message.detail != "": Rectangle {
                                        height: detail.preferred-height;
                                        detail-measure := Text { visible: false; text: root.message.detail; font-size: Tokens.small; wrap: word-wrap; }
                                        detail := Text { x: 0px; y: 0px; width: parent.width; text: root.message.detail; font-size: Tokens.small; color: Tokens.secondary; wrap: detail-measure.min-width > self.width ? char-wrap : word-wrap; }
                                    }

                                    if root.message.uploading && root.card: Rectangle { height: 3px; background: Tokens.surface-2;
                                        accessible-role: text; accessible-label: "Uploading " + round(root.message.upload-progress * 100) + "%";
                                        Rectangle { x: 0px; y: 0px; height: 100%; width: parent.width * root.message.upload-progress; background: Tokens.accent; }
                                    }
                                    if root.message.file-failed: Text { text: root.message.file-error; color: Tokens.secondary; font-size: Tokens.small; wrap: word-wrap; }
                                    if State.file-save-id == root.message.id && State.file-save-status != "": Rectangle {
                                        height: saved.preferred-height;
                                        save-measure := Text { visible: false; text: State.file-save-status; font-size: Tokens.small; wrap: word-wrap; }
                                        saved := Text { x: 0px; y: 0px; width: parent.width; text: State.file-save-status; font-size: Tokens.small; color: Tokens.secondary; wrap: save-measure.min-width > self.width ? char-wrap : word-wrap; }
                                    }
                                    if root.message.image-key != "" || root.message.photo: Rectangle {
                                        // Geometry does not change when a thumbnail arrives or fails.
                                        height: root.message.sticker ? 120px : 180px;
                                        border-radius: 12px; clip: true;
                                        Image { source: root.message.picture; width: 100%; height: 100%; image-fit: contain; visible: root.message.has-picture; accessible-role: image; accessible-label: root.message.photo ? "Photo preview" : root.message.sticker ? "Sticker" : "Message image"; }
                                        // Software clips are rectangular: cover the four outside corners
                                        // at the contained image's actual bounds, without touching cached pixels.
                                        if root.message.photo && root.message.has-picture: Rectangle {
                                            width: min(parent.width, parent.height * root.message.picture.width / max(1, root.message.picture.height));
                                            height: min(parent.height, parent.width * root.message.picture.height / max(1, root.message.picture.width));
                                            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                            Image { x: 0px; y: 0px; width: 12px; height: 12px; source: @image-url("../assets/photo-corner-0.svg"); colorize: Tokens.bg; }
                                            Image { x: parent.width - 12px; y: 0px; width: 12px; height: 12px; source: @image-url("../assets/photo-corner-1.svg"); colorize: Tokens.bg; }
                                            Image { x: parent.width - 12px; y: parent.height - 12px; width: 12px; height: 12px; source: @image-url("../assets/photo-corner-2.svg"); colorize: Tokens.bg; }
                                            Image { x: 0px; y: parent.height - 12px; width: 12px; height: 12px; source: @image-url("../assets/photo-corner-3.svg"); colorize: Tokens.bg; }
                                        }
                                        if root.message.photo && root.message.has-picture: FocusScope {
                                            accessible-role: button; accessible-label: "Open photo"; accessible-description: self.has-focus ? "Focused" : "";
                                            accessible-action-default => { State.open-photo(root.message.image-key); }
                                            TouchArea { mouse-cursor: pointer; clicked => { parent.focus(); State.open-photo(root.message.image-key); } }
                                            key-pressed(event) => { if event.text == Key.Return || event.text == " " { State.open-photo(root.message.image-key); return accept; } reject }
                                            Rectangle { visible: parent.has-focus; border-width: 2px; border-color: Tokens.accent; background: transparent; }
                                            
                                            property <int> return-serial: State.viewer-return-serial;
                                            changed return-serial => { if !State.viewer-open && State.viewer-return-key == root.message.image-key { self.focus(); } }
                                        }
                                        if root.message.uploading: Rectangle {
                                            width: root.message.has-picture ? min(parent.width, parent.height * root.message.picture.width / max(1, root.message.picture.height)) : parent.width;
                                            x: (parent.width - self.width) / 2;
                                            y: root.message.has-picture ? (parent.height + min(parent.height, parent.width * root.message.picture.height / max(1, root.message.picture.width))) / 2 - 3px : parent.height - 3px;
                                            height: 3px; background: Tokens.surface-2;
                                            accessible-role: text; accessible-label: "Uploading " + round(root.message.upload-progress * 100) + "%";
                                            Rectangle { x: 0px; y: 0px; height: 100%; width: parent.width * root.message.upload-progress; background: Tokens.accent; }
                                        }
                                        if !root.message.has-picture: VerticalLayout {
                                            padding: 8px; spacing: 8px; alignment: center;
                                            Text { text: root.message.image-failed ? root.message.image-error : root.message.sticker ? root.message.body : root.message.image-key == "" ? "Photo unavailable" : "Loading image…"; color: root.message.sticker && !root.message.image-failed ? Tokens.foreground : Tokens.secondary; horizontal-alignment: center; wrap: word-wrap; }
                                            if root.message.image-failed && root.message.image-retryable: HorizontalLayout { alignment: center; TextAction { text: "Retry"; action-label: "Retry image"; clicked => { State.retry-image(root.message.image-key); } } }
                                        }
                                    }
                                }
                            }
                            if State.reaction-error-id == root.message.id: Text { text: "Couldn't react."; color: Tokens.danger; font-size: Tokens.time; }
                            if State.unsend-feedback-id == root.message.id: Text { text: "Couldn't unsend."; color: Tokens.danger; font-size: Tokens.time; }
                            if root.message.recoverable: HorizontalLayout {
                                spacing: 8px; alignment: start;
                                Text { text: root.message.delivery == "Rejected" ? "Not sent" : "Maybe not sent"; color: Tokens.danger; font-size: Tokens.small; vertical-alignment: center; }
                                TextAction {
                                    text: root.message.file-missing ? "File missing" : root.message.delivery == "Rejected" ? "Retry" : "Resend";
                                    focus-on-click: false;
                                    enabled: State.connected && !root.message.file-missing;
                                    clicked => { State.retry-message(root.message.id); }
                                    property <bool> restore-action: State.recovery-focus-id == root.message.id && State.recovery-focus-action == "resend";
                                    changed restore-action => { if self.restore-action { self.focus-action(); State.recovery-focus-id = ""; } }
                                }
                                TextAction { text: "Discard"; clicked => { State.discard-message(root.message.id); } }
                            }
                            if root.message.reaction-count > 0: Rectangle {
                                height: 28px; width: reaction-pill.preferred-width + 16px; horizontal-stretch: 0;
                                border-radius: 14px; background: Tokens.bg; border-width: 1px; border-color: Tokens.divider;
                                reaction-pill := HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 4px;
                                    for reaction in root.message.reactions: HorizontalLayout {
                                        if reaction.has-picture: Image { source: reaction.picture; width: 20px; height: 20px; image-fit: contain; }
                                        Text { text: reaction.label; font-size: Tokens.small; color: Tokens.foreground; vertical-alignment: center; }
                                    }
                                    Text { text: root.message.reaction-count; font-size: Tokens.small; color: Tokens.foreground; vertical-alignment: center; }
                                }
                            }
                        }
                        // Time appears once at the end of a run, beside the
                        // bubble. Status has a fixed slot and never adds a row.
                        Rectangle {
                            width: root.message.outgoing ? Tokens.time * 4.8 : Tokens.time * 3.8;
                            HorizontalLayout {
                                y: max(0px, message-column.y + message-bubble.y + message-bubble.height - self.height);
                                height: max(16px, Tokens.time * 1.4); spacing: 2px;
                                Text { text: (root.message.run-position == "single" || root.message.run-position == "last") ? root.message.clock : ""; accessible-label: (root.message.run-position == "single" || root.message.run-position == "last") ? root.message.time : ""; color: Tokens.secondary; font-size: Tokens.time; }
                                if root.message.outgoing && (root.message.run-position == "single" || root.message.run-position == "last"): Image {
                                    width: 16px; height: 16px;
                                    source: root.message.delivery == "Sending…" ? @image-url("../assets/icons/clock.svg") : root.message.delivery == "Read" ? @image-url("../assets/icons/check-double.svg") : root.message.delivery == "Rejected" ? @image-url("../assets/icons/error.svg") : root.message.delivery == "Unconfirmed" ? @image-url("../assets/icons/warning.svg") : @image-url("../assets/icons/check.svg");
                                    accessible-role: image;
                                    accessible-label: root.message.delivery == "Sending…" ? "Sending" : root.message.delivery == "" ? "Sent" : root.message.delivery;
                                    colorize: root.message.delivery == "Rejected" ? Tokens.danger : root.message.delivery == "Read" ? Tokens.accent-strong : Tokens.secondary;
                                }
                            }
                        }
                        Rectangle {
                            width: 56px; horizontal-stretch: 0;
                            reply-button := IconButton {
                                x: 28px; y: react-button.y; width: 28px; height: 28px; label: "Reply";
                                icon: @image-url("../assets/icons/reply.svg");
                                visible: root.message.can-react && (root.has-hover || message-bubble.selected || self.has-focus || react-button.has-focus);
                                activated => { State.reply(root.message.id); }
                            }
                            react-button := IconButton {
                                y: max(0px, message-column.y + message-bubble.y + message-bubble.height - 28px);
                                width: 28px; height: 28px; border-radius: 14px;
                                label: "React"; icon: @image-url("../assets/icons/react.svg");
                                visible: root.message.can-react && (root.has-hover || message-bubble.selected || self.has-focus || reply-button.has-focus);
                                activated => { reactions.show(); }
                                key-pressed(event) => { if event.text == Key.Tab { if event.modifiers.shift { if root.card { State.focus-history(); } else { body.focus(); } } else { State.focus-composer(); } return accept; } reject }
                            }
                        }
                        if !root.message.outgoing: Rectangle { min-width: 24px; horizontal-stretch: 1; }
                        }
                    
}
}
