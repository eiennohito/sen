import { Tokens } from "tokens.slint";
export component IconButton inherits Rectangle {
    out property <bool> has-focus: focus.has-focus;
    in property <image> icon;
    in property <string> label;
    in property <string> focus-description;
    in property <bool> enabled: true;
    in property <bool> selected;
    in property <color> icon-color: root.selected ? Tokens.accent : Tokens.text;
    callback activated();
    callback key-pressed(KeyEvent) -> EventResult;
    key-pressed(event) => { reject }
    width: 32px; height: 32px; border-radius: 8px;
    Rectangle {
        width: root.width; height: root.height;
        border-radius: root.border-radius;
        background: touch.pressed ? Tokens.selection : touch.has-hover ? Tokens.surface-hover : transparent;
        opacity: root.enabled ? 1 : 0.4;
        Image { x: (parent.width - 20px) / 2; y: (parent.height - 20px) / 2; width: 20px; height: 20px; source: root.icon; colorize: root.icon-color; }
        focus := FocusScope {
            enabled: root.enabled;
            accessible-role: button; accessible-label: root.label; accessible-enabled: root.enabled; accessible-description: self.has-focus ? root.focus-description : "";
            accessible-action-default => { if root.enabled { root.activated(); } }
            Rectangle { x: -4px; y: -4px; width: root.width + 8px; height: root.height + 8px; background: transparent; border-radius: root.border-radius + 4px; border-color: Tokens.accent-strong; border-width: focus.has-focus ? 2px : 0px; }
            key-pressed(event) => { if root.key-pressed(event) == accept { return accept; } if event.text == Key.Return || event.text == " " { root.activated(); return accept; } reject }
        }
        touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.activated(); } Tooltip { Text { text: root.label; font-size: Tokens.small; color: Tokens.text; } } }
    }
    public function focus-button() { focus.focus(); }
}
