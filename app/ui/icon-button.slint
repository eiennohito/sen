import { Pressable, FocusRing } from "button.slint";
import { Tokens } from "tokens.slint";
export component IconButton inherits Pressable {
    in property <image> icon;
    in property <string> label;
    in property <color> icon-color: Tokens.text;
    in property <length> icon-size: 20px;
    in property <color> hover-color: Tokens.surface-hover;
    in property <color> pressed-color: Tokens.selection;
    accessible-label: root.label;
    width: 32px; height: 32px; border-radius: 8px;
    Rectangle {
        border-radius: root.border-radius;
        background: (root.pressed ? root.pressed-color : root.has-hover ? root.hover-color : transparent).transparentize(root.dimming);
        // Slint treats transparent colorize as the original image colours.
        Image { visible: root.icon-color.alpha > 0; x: (parent.width - root.icon-size) / 2; y: (parent.height - root.icon-size) / 2; width: root.icon-size; height: root.icon-size; source: root.icon; colorize: root.icon-color.transparentize(root.dimming); }
        FocusRing { outset: 4px; focused: root.has-focus; border-radius: root.border-radius + 4px; }
    }
    Tooltip { Text { text: root.label; font-size: Tokens.small; color: Tokens.text; } }
}
