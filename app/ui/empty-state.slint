import { AuthState } from "globals.slint";
import { Tokens } from "tokens.slint";
import { Button } from "button.slint";
import { Avatar } from "avatar.slint";
export component EmptyState inherits Rectangle {
    in property <bool> signed-out;
    in property <string> text;
    in property <string> name;
    in property <image> icon;
    in property <image> avatar;
    in property <string> initial;
    in property <string> identity;
    VerticalLayout {
        x: 16px; y: max(0px, (parent.height - self.preferred-height) / 2); width: parent.width - 32px; height: self.preferred-height; spacing: 12px;
        HorizontalLayout { alignment: center;
            Rectangle {
                width: root.name != "" ? 96px : 48px; height: self.width;
                Avatar { visible: root.name != ""; width: 96px; height: 96px; identity: root.identity; initial: root.initial; picture: root.avatar; }
                Image { visible: root.name == ""; width: 48px; height: 48px; source: root.icon; colorize: Tokens.secondary; }
            }
        }
        if root.name != "": Text { text: root.name; font-size: Tokens.base; color: Tokens.text; font-weight: 600; horizontal-alignment: center; }
        Text { text: root.signed-out ? "Not signed in" : root.text; font-size: Tokens.base; color: root.name != "" ? Tokens.secondary : Tokens.text; horizontal-alignment: center; wrap: word-wrap; }
        if root.signed-out: HorizontalLayout { alignment: center; Button { text: "Sign in"; primary: true; clicked => { AuthState.open-sign-in(); } } }
    }
}
