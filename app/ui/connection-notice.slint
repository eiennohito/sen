import { State } from "state.slint";
import { Tokens } from "tokens.slint";

component Action inherits Rectangle {
    in property <length> text-size: Tokens.base;
    in property <string> label;
    in property <string> description;
    in property <bool> enabled: true;
    callback activated();
    callback tab(bool);
    public function focus-action() { focus.focus(); }
    preferred-width: caption.preferred-width + 32px;
    width: self.preferred-width;
    height: 32px;
    border-radius: 8px;
    background: touch.has-hover ? Tokens.surface-hover : Tokens.surface-2;
    border-width: focus.has-focus ? 2px : 0px;
    border-color: focus.has-focus ? Tokens.accent : Tokens.action-border;
    opacity: root.enabled ? 1 : 0.45;
    caption := Text { width: 100%; height: 100%; text: root.label; font-size: root.text-size; color: touch.pressed ? Tokens.selection-foreground : Tokens.foreground; horizontal-alignment: center; vertical-alignment: center; }
    focus := FocusScope {
        enabled: root.enabled;
        accessible-role: button; accessible-label: root.description; accessible-enabled: root.enabled;
        accessible-action-default => { if root.enabled { root.activated(); } }
        key-pressed(event) => {
            if State.ime-active { return reject; }
            if event.text == Key.Tab { root.tab(event.modifiers.shift); return accept; }
            if event.text == Key.Return || event.text == " " { root.activated(); return accept; }
            reject
        }
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.activated(); } }
}

export component ConnectionNotice inherits Rectangle {
    callback leave(bool);
    width: 100%; height: State.connection-notice-height;
    visible: State.connection-feedback-visible;
    background: Tokens.warning-surface;
    property <string> status: State.signed-out ? State.session-cause : State.fatal ? "Something went wrong — restart" : "Offline. Reconnecting…";
    property <length> status-width: max(0px, root.width - 64px - (sign-in.visible ? sign-in.preferred-width + 8px : 0px));
    accessible-role: banner; accessible-label: State.connection-failed ? "Connection needs attention" : "Connection restored";
    public function focus-first() { sign-in.focus-action(); }
    public function focus-action() { sign-in.focus-action(); }
    TouchArea { scroll-event(event) => { accept } }
    FocusScope {
        focus-on-tab-navigation: false;
        key-pressed(event) => { if event.text == Key.F6 { root.leave(false); return accept; } State.browser-key(event) }
        HorizontalLayout {
            padding-left: 16px; padding-right: 16px; spacing: 8px; alignment: start;
            Rectangle { width: 20px; height: 36px; Image { y: 8px; width: 20px; height: 20px; source: @image-url("../assets/icons/warning.svg"); colorize: Tokens.text; } }
            Text { width: root.status-width; text: root.status; accessible-label: root.status; color: Tokens.foreground; font-size: Tokens.base; overflow: elide; vertical-alignment: center; wrap: no-wrap; }
            sign-in := Action {
                visible: State.connection-failed && State.sign-in-available; width: self.visible ? self.preferred-width : 0px;
                label: "Sign in"; description: "Sign in again";
                enabled: State.sign-in-available && !State.retrying-connection && !State.auth-busy;
                activated => { State.open-sign-in(); }
                tab(back) => { root.leave(back); }
            }
        }
    }
}
