import { Pressable } from "button.slint";
import { RichRun } from "types.slint";
import { State } from "state.slint";
import { Tokens } from "tokens.slint";

export component RichFlow inherits Rectangle {
    in property <[RichRun]> runs;
    in property <int> max-lines;
    in property <bool> elide-overflow;
    in property <bool> centered;
    in property <brush> text-color: Tokens.foreground;
    callback select-text();
    background: transparent;
    clip: true;
    callback fallback(bool);
    callback natural-width(float);
    property <[RichRun]> source: State.rich-source(root.runs);
    property <[RichRun]> lines;
    in property <length> text-size: Tokens.base;
    property <bool> measuring;
    function reflow() {
        if root.source.length == 0 { root.lines = []; return; }
        if !root.measuring && root.width >= 1px {
            root.measuring = true;
            root.lines = State.rich-layout(root.source, root.width / 1px, root.text-size / 1px, root.lines);
            root.natural-width(root.lines.length > 0 ? root.lines[0].natural-width : 0);
            root.fallback(root.lines.length == 0);
            root.measuring = false;
        }
    }
    changed source => { root.reflow(); }
    changed width => { root.reflow(); }
    changed text-size => { root.reflow(); }
    init => { root.reflow(); }
    property <length> natural-height: root.lines.length == 0 ? 0px : root.lines[root.lines.length - 1].y * 1px + root.lines[root.lines.length - 1].measured-height * 1px;
    height: root.max-lines > 0 && root.lines.length > 0 ? min(root.natural-height, root.lines[0].measured-height * root.max-lines * 1px) : root.natural-height;
    for run in root.lines: Rectangle {
        x: run.x * 1px + (root.centered ? max(0px, (root.width - run.line-width * 1px) / 2) : 0px); y: run.y * 1px;
        width: run.measured-width * 1px;
        height: run.measured-height * 1px;
        background: transparent;
        Text { x: 0px; y: 0px; width: parent.width; height: parent.height; min-width: 0px; min-height: 0px; preferred-width: parent.width; preferred-height: parent.height; accessible-role: none; wrap: no-wrap; visible: !run.emoji || !run.has-picture; text: run.text; font-size: run.emoji ? max(11px,root.text-size - 2px) : root.text-size; color: run.url != "" ? Tokens.accent-strong : root.text-color; vertical-alignment: center; overflow: clip; }
        if run.emoji && run.has-picture: Image { width: parent.width; height: parent.height; source: run.picture; image-fit: contain; accessible-role: image; accessible-label: run.text; }
        if run.link-start: ContextMenuArea {
            x: 0px; y: 0px;
            width: min(run.link-width * 1px, root.width - run.x * 1px);
            height: parent.height;
            Menu {
                MenuItem { title: run.url; enabled: false; }
                MenuItem { title: "Open link"; activated => { State.open-link(run.url); } }
                MenuItem { title: "Copy link"; activated => { State.copy-text(run.url); } }
            }
            Rectangle { y: parent.height - 2px; height: 1px; background: Tokens.accent-strong; }
            link-focus := Pressable {
                visible: run.link-first;
                accessible-label: "Open link " + run.url; accessible-description: run.url;
                activated => { State.open-link(run.url); }
            }
            TouchArea {
                mouse-cursor: pointer;
                property <bool> dragged;
                property <length> start-x;
                property <length> start-y;
                moved => { if self.pressed && (abs(self.mouse-x - self.start-x) > 4px || abs(self.mouse-y - self.start-y) > 4px) { self.dragged = true; } }
                pointer-event(event) => {
                    if event.kind == PointerEventKind.up && self.dragged { root.select-text(); }
                    else if event.kind == PointerEventKind.down && event.button == PointerEventButton.right { parent.show({ x: self.mouse-x, y: self.mouse-y }); }
                    else if event.kind == PointerEventKind.down && event.button == PointerEventButton.left { self.dragged = false; self.start-x = self.mouse-x; self.start-y = self.mouse-y; }
                }
                clicked => { if !self.dragged { if run.link-first { link-focus.focus(); } State.open-link(run.url); } }
                Tooltip { Text { text: run.url; font-size: Tokens.small; color: Tokens.foreground; } }
            }
        }
    }
    if root.elide-overflow && root.natural-height > root.height: Rectangle {
        x: max(0px, root.width - root.text-size * 1.5); y: max(0px, root.height - root.text-size * 1.4);
        width: root.text-size * 1.5; height: root.text-size * 1.4; background: Tokens.bg;
        Text { text: "…"; font-size: root.text-size; color: root.text-color; horizontal-alignment: right; vertical-alignment: center; }
    }

}
