export enum DemoAutomation { reset }
export global ExtensionState {
    in-out property <bool> demo;
    out property <bool> modal-open: self.demo-scenarios-open;
    // Slint MCP has no focus property and omits embedded popup offsets.
    // Geometry identifies repeated labels and checks popup bounds against the window.
    pure callback focused-control() -> string;
    in-out property <string> internal-error;
    in-out property <bool> internal-error-seen;
    in-out property <string> attachment-injection-paths;
    callback inject-attachments(string);
    in-out property <string> demo-instance;
    in-out property <int> demo-reset-generation;
    in-out property <bool> demo-reset-enabled;
    callback demo-automation(DemoAutomation);
    in-out property <string> title-override;
    in-out property <bool> demo-scenarios-open: false;
    callback remember-demo-focus();
    callback restore-demo-focus();
    in-out property <bool> automation-background;
    in-out property <string> last-opened-link;
    callback demo-event(int);
}
