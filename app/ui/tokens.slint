import { Palette } from "std-widgets.slint";
export global Tokens {
    in-out property <length> base: 15px;
    out property <length> small: max(11px, base - 2px);
    out property <length> heading: base + 6px;
    out property <length> preview: base - 1px;
    out property <length> time: max(10px, base - 3px);
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-6: 24px;
    out property <length> bubble-min: 72px;
    out property <length> bubble-max: 480px;
    out property <length> message-avatar: 32px;
    out property <length> message-gap: 5px;
    in-out property <bool> dark: Palette.color-scheme == ColorScheme.dark || (Palette.color-scheme == ColorScheme.unknown && Palette.background == #1C1C1C);
    public function preview-dark(value: bool) { Palette.color-scheme = value ? ColorScheme.dark : ColorScheme.light; }
    out property <color> bg: dark ? #1E1F22 : #FFFFFF;
    out property <color> surface: dark ? #26272B : #F5F6F7;
    out property <color> surface-2: dark ? #32343A : #EDEEF0;
    out property <color> surface-hover: dark ? #2E3035 : #E9EAEC;
    out property <color> surface-selected: dark ? #383A40 : #E2E4E7;
    out property <color> divider: dark ? #3A3C42 : #E1E3E6;
    out property <color> text: dark ? #ECECEC : #111111;
    out property <color> text-secondary: dark ? #A3A7AE : #6B6F76;
    out property <color> accent: dark ? #06C755 : #06C755;
    out property <color> accent-strong: dark ? #3DDC84 : #00873C;
    out property <color> on-accent: dark ? #0B2614 : #FFFFFF;
    out property <color> bubble-out: dark ? #2F5D3A : #C7F2A4;
    out property <color> danger: dark ? #FF6B5E : #D93025;
    out property <color> warning-surface: dark ? #3A3220 : #FFF4D6;
    out property <color> scrim: dark ? #00000099 : #00000066;
    out property <color> viewer-bg: dark ? #0E0E10 : #0E0E10;
    out property <color> background: bg;
    out property <color> alternate-background: surface;
    out property <color> foreground: text;
    out property <color> secondary: text-secondary;
    out property <color> placeholder: text-secondary;
    out property <color> selection: surface-selected;
    out property <color> selection-foreground: text;
    out property <color> border: divider;
    out property <color> chat-hover: surface-hover;
    out property <color> action-border: divider;
    out property <color> outgoing-bubble: bubble-out;
    out property <color> outgoing-foreground: text;
    out property <color> message-selection: accent-strong;
    out property <color> message-selection-foreground: on-accent;
    out property <color> bubble-selection: surface-selected;
    out property <color> bubble-selection-border: accent-strong;
}
