import { Button, LineEdit, TextEdit, ScrollView, ComboBox } from "std-widgets.slint";
import { State } from "state.slint";
import { Tokens } from "tokens.slint";
import { ChatRow, FriendRow, MessageRow, ReactionRow } from "types.slint";
import { Pane } from "scrollpane.slint";
import { DraftEditor } from "draft-editor.slint";

export component Composer inherits Rectangle {
    property <length> footer-height: max(36px, max(send-caption.visible ? send-caption.preferred-height : 0px, send-button.preferred-height));
    property <length> editor-minimum-height: Tokens.base * 2.8 + 8px + root.footer-height + 32px;
    height: max(root.editor-minimum-height, min(State.conversation-height / 3, draft-measure.preferred-height + root.footer-height + 40px));
    vertical-stretch: 0;
draft-measure := Text {
        visible: false; text: State.draft + "\n";
        width: max(100px, root.width - 56px);
        wrap: word-wrap; font-size: Tokens.base;
    }
            FocusScope {
                focus-on-tab-navigation: false;
                key-pressed(event) => {
                    if State.ime-active { return reject; }
                    if event.text == Key.Tab {
                        if event.modifiers.shift { composer.focus-editor(); }
                        else if composer.has-focus && State.can-send { send-button.focus(); }
                        else { State.focus-after-conversation(); }
                        return accept;
                    }
                    reject
                }
                height: root.height;
                Rectangle { background: Tokens.surface; }
                VerticalLayout {
                    padding: 12px; spacing: 8px;
                    composer := DraftEditor { }
                    HorizontalLayout {
                        height: root.footer-height; spacing: 8px; alignment: end;
                        send-caption := Text { visible: State.send-reason != ""; max-width: self.visible ? max(0px, root.width - 112px) : 0px; height: self.visible ? self.preferred-height : 0px; horizontal-stretch: self.visible ? 1 : 0; text: State.send-reason; color: Tokens.secondary; font-size: Tokens.time; wrap: word-wrap; vertical-alignment: center; }
                        send-button := Button { text: "Send"; accessible-description: self.has-focus ? "Focused" : ""; enabled: State.can-send; width: 80px; horizontal-stretch: 0; clicked => { State.send(); State.focus-composer(); } }
                    }
                }
            }
    public function focus-last() { if State.can-send { send-button.focus(); } else { composer.focus-editor(); } }
    public function focus-editor() { composer.focus-editor(); }
    public function restore-editor(anchor: int, caret: int) { composer.restore(anchor, caret); }
}
