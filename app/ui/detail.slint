import { DetailAction, DetailPageMode, ContentState, DetailState, ShellState } from "globals.slint";
import { Pressable, FocusRing, Button } from "button.slint";
import { FocusOpener } from "types.slint";
import { RowText } from "list-row.slint";
import { Tokens } from "tokens.slint";
import { IconButton } from "icon-button.slint";
import { Avatar } from "avatar.slint";
import { RichFlow } from "rich-flow.slint";
import { Members } from "members.slint";
import { ScrollView } from "std-widgets.slint";
component DetailRow inherits Pressable {
    in property <string> label;
    in property <bool> danger;
    in property <bool> toggle;
    in property <bool> checked;
    height: 52px; border-radius: 8px;
    private property <brush> fill: root.has-hover ? Tokens.surface-hover : transparent;
    animate fill { duration: 100ms; }
    background: root.fill;
    accessible-label: root.label; accessible-enabled: root.enabled; accessible-checked: root.checked; accessible-value: root.toggle ? (root.checked ? "On" : "Off") : "";
    RowText { x: 12px; width: parent.width - 72px; height: parent.height; text: root.label; color: (root.danger ? Tokens.danger : Tokens.text).transparentize(root.dimming); vertical-alignment: center; }
    Image { visible: !root.toggle && !root.danger; x: parent.width - 28px; y: 16px; width: 20px; height: 20px; source: @image-url("../assets/icons/next.svg"); colorize: Tokens.secondary.transparentize(root.dimming); }
    Rectangle { visible: root.toggle; x: parent.width - 52px; y: 14px; width: 40px; height: 24px; border-radius: 12px; background: Tokens.surface-2.transparentize(root.dimming);
        states [ checked when root.checked: { background: Tokens.accent.transparentize(root.dimming); knob.x: 18px; in-out { animate background, knob.x { duration: 120ms; } } } ]
        knob := Rectangle { x: 2px; y: 2px; width: 20px; height: 20px; border-radius: 10px; background: Tokens.bg.transparentize(root.dimming); }
    }
    FocusRing { focused: root.has-focus; outset: -2px; border-radius: 8px; }
}
component ProfileActionButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> enabled: true;
    out property <bool> has-focus: button.has-focus;
    callback activated();
    forward-focus: button;
    width: 72px; height: 72px;
    button := IconButton { x: (parent.width - 40px) / 2; width: 40px; height: 40px; border-radius: 20px; background: Tokens.surface-2; label: root.label; icon: root.icon; enabled: root.enabled; activated => { root.activated(); } }
    Text { y: 48px; width: parent.width; text: root.label; horizontal-alignment: center; font-size: Tokens.small; color: Tokens.text.transparentize(root.enabled ? 0 : 0.6); }
}
export component Detail inherits FocusScope {
    public pure function focus-opener() -> FocusOpener {
        if avatar-focus.has-focus { return FocusOpener.profile-photo; }
        if members.contains-focus { return FocusOpener.member-list; }
        if member-row.has-focus { return FocusOpener.group-members; }
        return FocusOpener.none;
    }
    public function restore-opener(opener: FocusOpener) {
        if opener == FocusOpener.member-list { members.focus-list(); }
        else if opener == FocusOpener.group-members { member-row.focus(); }
        else { avatar-focus.focus(); }
    }
    out property <bool> editing: members.visible && members.editing;
    property <length> name-width: 288px;
    focus-on-tab-navigation: false;
    public function focus-first() {
        // Header controls are conditional; enter the first available stop.
        header-start.focus(); ShellState.tab-focus(false);
    }
    public function focus-open() {
        // Profile more is conditional; Close details is the fixed header stop.
        close.focus(); if DetailState.detail-page == DetailPageMode.profile { ShellState.tab-focus(true); }
    }
    public function focus-action() {
        // Profile and group actions vary with availability and busy state.
        action-end.focus(); ShellState.tab-focus(true);
    }
    capture-key-pressed(event) => { if ShellState.profile-sheet && event.text == Key.Return && event.modifiers.control { return accept; } reject }
    key-pressed(event) => {
        if ShellState.ime-active { return reject; }
        if event.text == Key.Escape { DetailState.pop-detail(false); return accept; }
        reject
    }
    Rectangle {
        header-start := FocusScope { width: 0px; height: 0px; focus-on-click: false; focus-on-tab-navigation: false; }
        HorizontalLayout { y: 0px; width: parent.width; height: 56px; padding: 12px; spacing: 8px;
            if DetailState.detail-depth > 1: back := IconButton { label: "Back"; icon: @image-url("../assets/icons/back.svg"); activated => { DetailState.pop-detail(false); } }
            heading := Text { text: "Profile"; font-size: Tokens.heading; font-weight: 600; vertical-alignment: center; }
            if DetailState.detail-page == DetailPageMode.profile: more := IconButton { label: "Profile more"; icon: @image-url("../assets/icons/more.svg"); activated => { menu.show({x: root.width - 176px, y: 48px}); } }
            close := IconButton { label: "Close details"; icon: @image-url("../assets/icons/close.svg"); activated => { DetailState.pop-detail(true); } }
        }
        cover := Rectangle { y: 56px; width: parent.width; height: 96px; background: Tokens.accent.with-alpha(0.25); }
        info := ScrollView { y: 88px; width: parent.width; height: parent.height - self.y; horizontal-scrollbar-policy: always-off; content-width: self.width;
            VerticalLayout { padding: 16px; spacing: 12px; alignment: start;
                HorizontalLayout { alignment: center;
                    Rectangle { width: 96px; height: 96px;
                        Avatar { width: 96px; height: 96px; identity: DetailState.profile-id; initial: DetailState.profile-initial; picture: DetailState.profile-avatar; }
                        avatar-focus := Pressable { accessible-label: "Open profile photo";
                            activated => { DetailState.profile-photo(); }
                            FocusRing { focused: avatar-focus.has-focus; border-radius: 48px; }
                        }
                    }
                }
                HorizontalLayout { alignment: center; spacing: 8px;
                    RichFlow { width: min(root.name-width, root.width - 32px - (DetailState.profile-favourite ? 28px : 0px)); runs: DetailState.profile-name-runs; text-size: Tokens.heading; max-lines: 2; elide-overflow: true; accessible-role: text; accessible-label: DetailState.profile-name; natural-width(value) => { root.name-width = max(24px,value * 1px); } }
                    if DetailState.profile-favourite: Image { height: 20px; width: 20px; source: @image-url("../assets/icons/star.svg"); colorize: Tokens.secondary; accessible-role: image; accessible-label: "Favourite"; }
                }
                if DetailState.profile-original != "": Text { text: DetailState.profile-original; color: Tokens.secondary; wrap: word-wrap; horizontal-alignment: center; }
                if DetailState.detail-page == DetailPageMode.profile && DetailState.profile-status != "": RichFlow { runs: DetailState.profile-status-runs; centered: true; text-color: Tokens.secondary; max-lines: 4; accessible-role: text; accessible-label: DetailState.profile-status; }
                if DetailState.detail-page == DetailPageMode.profile && DetailState.profile-notice != "": Text { text: DetailState.profile-notice; color: Tokens.secondary; wrap: word-wrap; }
                if DetailState.detail-page == DetailPageMode.profile && (DetailState.profile-own || DetailState.profile-available || DetailState.profile-friend || DetailState.profile-addable): profile-actions := HorizontalLayout { height: 72px; alignment: center; spacing: 8px;
                    if DetailState.profile-available: chat := ProfileActionButton { enabled: true; label: "Chat"; icon: @image-url("../assets/icons/chats.svg"); activated => { DetailState.start-friend-chat(); } }
                    if DetailState.profile-own: ProfileActionButton { enabled: !DetailState.detail-busy; label: "Edit name"; icon: @image-url("../assets/icons/rename.svg"); activated => { DetailState.open-detail-dialog(DetailAction.edit-name); } }
                    if DetailState.profile-own: ProfileActionButton { width: 136px; enabled: !DetailState.detail-busy; label: "Edit status message"; icon: @image-url("../assets/icons/rename.svg"); activated => { DetailState.open-detail-dialog(DetailAction.edit-status); } }
                    if DetailState.profile-friend: rename := ProfileActionButton { enabled: !DetailState.detail-busy; label: DetailState.action-text(DetailAction.rename, DetailState.detail-running); icon: @image-url("../assets/icons/rename.svg"); activated => { DetailState.open-detail-dialog(DetailAction.rename); } }
                    if DetailState.profile-addable: add := ProfileActionButton { enabled: !DetailState.detail-busy; label: DetailState.action-text(DetailAction.add, DetailState.detail-running); icon: @image-url("../assets/icons/add-friend.svg"); activated => { DetailState.detail-action(DetailAction.add, ""); } }
                }
                if DetailState.detail-page == DetailPageMode.group: Text { text: DetailState.group-count >= 0 ? DetailState.group-count + " members" : ""; color: Tokens.secondary; horizontal-alignment: center; }
                member-row := DetailRow { visible: DetailState.detail-page == DetailPageMode.group; height: self.visible ? 52px : 0px; label: "Members" + (DetailState.group-count >= 0 ? " (" + DetailState.group-count + ")" : ""); activated => { DetailState.open-members(); } }
                if DetailState.detail-page == DetailPageMode.group && !DetailState.group-room && !DetailState.group-left: mute := DetailRow { accessible-role: checkbox; enabled: DetailState.group-writable && !DetailState.detail-busy; label: DetailState.action-text(DetailAction.mute, DetailState.detail-running); toggle: true; checked: !DetailState.group-muted; activated => { DetailState.detail-action(DetailAction.mute, ""); } }
                if DetailState.detail-page == DetailPageMode.group && !DetailState.group-room && !DetailState.group-left: leave := DetailRow { enabled: !DetailState.detail-busy; label: DetailState.action-text(DetailAction.leave, DetailState.detail-running); danger: true; activated => { DetailState.open-detail-dialog(DetailAction.leave); } }
                if DetailState.detail-error != "": Text { text: DetailState.detail-error; color: Tokens.danger; wrap: word-wrap; }
            }
            action-end := FocusScope { width: 0px; height: 0px; focus-on-click: false; focus-on-tab-navigation: false; }
        }
        members := Members { visible: DetailState.detail-page == DetailPageMode.members; y: 56px; width: parent.width; height: parent.height - 56px; }
    }
    states [
        group when DetailState.detail-page == DetailPageMode.group: {
            heading.text: "Group info"; cover.visible: false; info.y: 56px;
        }
        members when DetailState.detail-page == DetailPageMode.members: {
            heading.text: "Members" + (DetailState.group-count >= 0 ? " (" + DetailState.group-count + ")" : "");
            cover.visible: false; info.visible: false;
        }
    ]
    menu := ContextMenuArea {
        enabled: false;
        Menu { MenuItem { title: "Copy name"; activated => { ContentState.copy-text(DetailState.profile-name); } } }
    }
}
