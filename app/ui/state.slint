    out property <length> rail-width: 56px;
    out property <length> browser-width: 286px;
    out property <length> panel-width: 320px;
    out property <length> narrow-width: 740px;
    out property <length> conversation-min-width: self.narrow-width - self.rail-width - self.browser-width;
    out property <bool> profile-sheet: self.window-width < self.rail-width + self.browser-width + self.conversation-min-width + self.panel-width;
    property <int> covered-content: self.window-modal-open || (self.detail-open && self.narrow) ? 2 : self.detail-open && self.profile-sheet ? 1 : self.narrow && self.show-conversation ? 3 : 0;
    in-out property <bool> browser-focus-hidden;
    property <int> previous-covered-content;
    changed covered-content => {
        let previous = self.previous-covered-content;
        let browser-hidden = self.covered-content == 3 && self.previous-covered-content == 0 && self.browser-focus-hidden;
        self.browser-focus-hidden = false;
        self.previous-covered-content = self.covered-content;
        if self.recovery-kind != "" || self.demo-scenarios-open || self.detail-dialog != "" { return; }
        // Closing a modal back to the stack restores its recorded opener.
        if previous == 2 && self.detail-open && !self.window-modal-open { return; }
        if self.auth-open { self.focus-auth-start(); }
        else if self.viewer-open { self.focus-viewer-close(); }
        else if self.settings-open { self.focus-settings-close(); }
        else if self.detail-open && self.profile-sheet { self.focus-profile-close(); }
        else if browser-hidden { self.focus-composer(); }
    }
