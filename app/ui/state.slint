import { ChatRow, FriendRow, MessageRow, RichRun } from "types.slint";
// Shared presentation state. AppWindow preserves the public Rust binding API.
export global State {
    in-out property <bool> window-active: false;
    in-out property <int> unread-conversations;
    in-out property <bool> unread-stale;
    in-out property <string> unread-divider;
    in-out property <bool> unread-locating;
    in-out property <bool> unread-boundary-unknown;
    callback read-state-changed();
    changed window-active => { self.read-state-changed(); }
    changed modal-open => { self.read-state-changed(); }
    changed loading-history => { self.read-state-changed(); }
    changed unread-locating => { self.read-state-changed(); }
    changed show-conversation => { self.read-state-changed(); }

    in-out property <int> section: 0;
    changed settings-open => { if self.settings-open { self.profile-open = false; } }
    in-out property <int> category: 0;
    callback filter-category();
    callback switch-chat(int);
    callback focus-chat-list();
    callback focus-friend-list();
    public function browser-key(event: KeyEvent) -> EventResult {
        if self.ime-active { return reject; }
        if event.text == Key.Escape && self.profile-open && self.profile-sheet && !self.window-modal-open { self.close-profile(); return accept; }
        if !self.window-modal-open && !(self.profile-open && self.profile-sheet) && self.connection-failed && event.text == Key.F6 { self.focus-sign-in-opener(); return accept; }
        if self.window-modal-open || (self.narrow && self.profile-open) { return reject; }
        if event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta {
            if event.text == "f" || event.text == "F" { self.show-conversation = false; if self.section == 1 { self.focus-friend-search(); } else { self.focus-search(); } return accept; }
            if event.text == "1" || event.text == "2" { self.browse(event.text == "1" ? 1 : 0); if self.section == 1 { self.focus-friend-search(); } else { self.focus-search(); } return accept; }
            if event.text == "q" || event.text == "Q" { if !event.repeat { self.quit(); } return accept; }
        }
        if event.modifiers.alt && event.text == Key.LeftArrow && self.narrow && self.show-conversation {
            self.show-conversation = false;
            if self.section == 1 { self.focus-friend-search(); } else { self.focus-search(); }
            return accept;
        }
        if event.modifiers.alt && (event.text == Key.UpArrow || event.text == Key.DownArrow) {
            self.switch-chat(event.text == Key.DownArrow ? 1 : -1);
            return accept;
        }
        return reject;
    }
    in-out property <[FriendRow]> friends;
    in-out property <int> friend-result: -1;
    in-out property <length> friend-row-height: max(70px, self.text-size * 3px + 16px);
    in-out property <string> friend-query;
    in-out property <bool> groups-expanded: true;
    in-out property <bool> friends-expanded: true;
    in-out property <length> friends-y;
    in-out property <bool> loading-friends;
    in-out property <string> friends-error;
    in-out property <bool> profile-open;
    out property <length> rail-width: 56px;
    out property <length> browser-width: 286px;
    out property <length> panel-width: 320px;
    out property <length> narrow-width: 740px;
    out property <length> conversation-min-width: self.narrow-width - self.rail-width - self.browser-width;
    out property <bool> profile-sheet: self.window-width < self.rail-width + self.browser-width + self.conversation-min-width + self.panel-width;
    changed profile-sheet => { if self.profile-open && self.profile-sheet { self.focus-profile-close(); } }
    in-out property <string> profile-name;
    in-out property <string> profile-id;
    in-out property <string> profile-status;
    in-out property <bool> profile-group;
    in-out property <image> profile-avatar;
    in-out property <bool> profile-available;
    in-out property <bool> ime-active: false;
    in-out property <int> text-size: 15;
    in-out property <[ChatRow]> chats;
    in-out property <[MessageRow]> messages;
    in-out property <int> selected-chat: -1;
    in-out property <string> chat-title;
    in-out property <string> chat-subtitle;
    in-out property <string> draft;
    in-out property <bool> enter-sends: false;
    in-out property <int> editor-caret;
    in-out property <int> editor-anchor;
    in-out property <bool> composer-focused;
    in-out property <string> recovery-kind;
    in-out property <string> recovery-id;
    in-out property <string> recovery-focus-id;
    in-out property <string> recovery-focus-action;
    callback restore-editor(int, int);
    callback retry-message(string);
    callback resolve-recovery(string);
    callback quit();
    in-out property <bool> can-send;
    in-out property <string> send-reason;
    in-out property <bool> list-pressed;
    in-out property <bool> list-release-pending;
    in-out property <length> chat-row-height: max(82px, self.text-size * 3.2px + 20px);
    in-out property <bool> background-mode;
    in-out property <bool> tray-available;
    in-out property <bool> autostart;
    in-out property <string> background-status;
    in-out property <string> autostart-status;
    in-out property <bool> notifications-paused;
    in-out property <bool> notifications-enabled;
    in-out property <int> notification-preview: 1;
    in-out property <bool> notification-sound;
    in-out property <bool> notification-mention-exception;
    in-out property <bool> notification-group-events;
    in-out property <bool> notification-available;
    in-out property <string> notification-status;
    in-out property <bool> demo-notifications;
    in-out property <string> transient-notice;
    callback test-notification();
    callback demo-notification(int);
    in-out property <bool> settings-open;
    in-out property <bool> viewer-open;
    in-out property <image> viewer-image;
    in-out property <string> viewer-status;
    in-out property <string> viewer-error;
    in-out property <bool> viewer-loading;
    in-out property <string> viewer-key;
    in-out property <float> viewer-zoom: 1;
    in-out property <bool> viewer-has-previous;
    in-out property <bool> viewer-has-next;
    in-out property <string> viewer-save-status;
    in-out property <bool> viewer-saving;
    in-out property <string> viewer-return-key;
    in-out property <int> viewer-return-serial;
    out property <bool> window-modal-open: self.auth-open || self.viewer-open || self.settings-open || (self.demo && self.demo-scenarios-open) || self.recovery-kind != "";
    in-out property <bool> modal-open: self.window-modal-open || (self.profile-sheet && self.profile-open);
    callback viewer-step(int);
    callback save-photo();
    callback close-settings();
    in-out property <bool> connected;
    in-out property <bool> connection-failed;
    in-out property <bool> auth-expired;
    in-out property <bool> session-unavailable;
    out property <bool> sign-in-available: self.auth-expired || self.session-unavailable;
    in-out property <bool> reconnected-notice;
    out property <bool> connection-feedback-visible: (self.connection-failed || self.reconnected-notice) && !self.window-modal-open && !(self.profile-open && self.profile-sheet);
    out property <length> connection-notice-height: max(40px, self.text-size * 1.4px + 16px);
    in-out property <length> connection-area-x;
    in-out property <length> connection-area-y;
    in-out property <length> connection-area-width;
    in-out property <length> connection-area-height;
    in-out property <bool> retrying-connection;
    in-out property <bool> auth-open;
    in-out property <bool> auth-busy;
    in-out property <bool> auth-cancel-confirm;
    in-out property <bool> auth-cancelling;
    in-out property <image> auth-qr;
    in-out property <string> auth-pin;
    in-out property <string> auth-stage;
    in-out property <string> auth-error;
    in-out property <bool> demo;
    in-out property <bool> demo-scenarios-open: false;
    in-out property <bool> automation-background;
    in-out property <bool> more-chats;
    in-out property <bool> has-chat;
    in-out property <bool> loading-chats;
    in-out property <bool> loading-history;
    in-out property <string> history-error;
    in-out property <string> list-error;
    in-out property <string> storage-error;
    in-out property <bool> storage-retryable;
    in-out property <string> desktop-warning;
    in-out property <string> connection-status;
    in-out property <string> account-name;
    in-out property <bool> show-conversation: false;
    in-out property <bool> following: true;
    in-out property <int> new-count;
    in-out property <length> history-y;
    in-out property <bool> history-dragging;
    in-out property <string> query;
    in-out property <length> list-y;
    in-out property <length> editor-y;
    in-out property <length> search-list-y;
    in-out property <bool> searching;
    in-out property <int> result-focus: -1;
    in-out property <bool> narrow: self.window-width < self.narrow-width;
    in-out property <length> window-width;
    in-out property <length> conversation-height;
    in-out property <length> history-width;
    in-out property <length> history-extent;
    callback browse(int);
    callback refresh-friends();
    callback filter-friends();
    callback open-profile(string);
    callback start-friend-chat();
    callback open-photo(string);
    callback open-link(string);
    pure callback rich-source([RichRun]) -> [RichRun];
    callback rich-layout([RichRun], float, float, [RichRun]) -> [RichRun];
    callback save-file(string);
    in-out property <string> file-save-id;
    in-out property <string> file-save-status;
    in-out property <bool> file-saving;
    in-out property <string> last-opened-link;
    callback photo-closed();
    callback reconnect();
    callback start-sign-in();
    callback cancel-sign-in();
    callback select-chat(int);
    callback search-changed(string);
    callback draft-edited();
    callback refresh();
    callback retry-list();
    callback retry-history();
    callback more();
    callback send();
    callback settings-changed();
    callback retry-storage();
    callback recover-message(string);
    callback demo-event(int);
    callback release-deferred();
    callback show-profile();
    callback close-profile();
    callback focus-composer();
    callback focus-reading-before-editor();
    callback show-viewer(string);
    callback close-viewer();
    callback account-ready();
    callback close-sign-in();
    callback open-sign-in();
    callback show-history(length, bool);
    callback latest();
    callback focus-search();
    callback focus-friend-search();
    callback focus-settings-opener();
    callback focus-settings-close();
    callback focus-profile-close();
    callback focus-auth-start();
    callback focus-connection-first();
    callback focus-sign-in-opener();
    callback focus-viewer-close();
    public function reading-key(event: KeyEvent) -> EventResult {
        if self.ime-active { return reject; }
        if self.browser-key(event) == accept { return accept; }
        if self.recovery-kind != "" { return reject; }
        if event.text == Key.End { self.latest(); self.focus-history(); return accept; }
        if event.text == Key.UpArrow { self.history-scroll(self.text-size * 1.4px); }
        else if event.text == Key.DownArrow { self.history-scroll(-self.text-size * 1.4px); }
        else if event.text == Key.PageUp { self.history-scroll(self.history-viewport-height * 0.9); }
        else if event.text == Key.PageDown { self.history-scroll(-self.history-viewport-height * 0.9); }
        else if event.text == Key.Home { self.history-jump(0px); }
        else { return reject; }
        if event.text == Key.Home {
            self.following = self.history-can-follow && !self.history-dragging && self.history-extent + self.history-y <= self.text-size * 1px;
            if self.following { self.new-count = 0; }
            self.history-scrolled();
        }
        self.focus-history();
        return accept;
    }
    callback focus-history();
    callback reset-viewer();
    in-out property <length> history-viewport-height;
    changed history-viewport-height => { self.read-state-changed(); }
    in-out property <string> older-status;
    in-out property <bool> older-failed;
    in-out property <bool> paging-demo;
    in-out property <int> history-retained;
    in-out property <int> history-pages;
    in-out property <string> highlight-message;
    in-out property <bool> return-visible;
    in-out property <string> jump-error;
    in-out property <bool> history-needs-refresh;
    in-out property <bool> history-budget-warning;
    in-out property <bool> history-can-follow: true;
    in-out property <bool> history-interacting;
    callback row-geometry(string, length, length);
    callback history-scrolled();
    callback latest-request();
    callback older-retry();
    callback jump-message(string);
    callback return-to-message();
    callback history-scroll(length);
    callback history-jump(length);
}
