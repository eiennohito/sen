import { ChatRow, FriendRow, MessageRow } from "types.slint";
// Shared presentation state. AppWindow preserves the public Rust binding API.
export global State {
    in-out property <int> section: 0;
    in-out property <[FriendRow]> friends;
    in-out property <int> friend-result: -1;
    in-out property <length> friend-row-height: max(70px, self.text-size * 3px + 16px);
    in-out property <string> friend-query;
    in-out property <bool> groups-expanded: true;
    in-out property <bool> friends-expanded: true;
    in-out property <length> friends-y;
    in-out property <bool> loading-friends;
    in-out property <string> friends-error;
    in-out property <bool> profile-open;
    in-out property <string> profile-name;
    in-out property <string> profile-id;
    in-out property <string> profile-status;
    in-out property <bool> profile-group;
    in-out property <image> profile-avatar;
    in-out property <bool> profile-available;
    in-out property <bool> ime-active: false;
    in-out property <int> text-size: 15;
    in-out property <[ChatRow]> chats;
    in-out property <[MessageRow]> messages;
    in-out property <int> selected-chat: -1;
    in-out property <string> chat-title;
    in-out property <string> chat-subtitle;
    in-out property <string> draft;
    in-out property <bool> can-send;
    in-out property <string> send-reason;
    in-out property <bool> list-pressed;
    in-out property <bool> list-release-pending;
    in-out property <length> chat-row-height: max(82px, self.text-size * 3.2px + 20px);
    in-out property <bool> settings-open;
    in-out property <bool> viewer-open;
    in-out property <image> viewer-image;
    in-out property <string> viewer-status;
    in-out property <string> viewer-error;
    in-out property <bool> viewer-loading;
    in-out property <string> viewer-key;
    in-out property <float> viewer-zoom: 1;
    in-out property <bool> connected;
    in-out property <bool> connection-failed;
    in-out property <bool> retrying-connection;
    in-out property <bool> auth-open;
    in-out property <bool> auth-busy;
    in-out property <bool> auth-cancelling;
    in-out property <image> auth-qr;
    in-out property <string> auth-pin;
    in-out property <string> auth-stage;
    in-out property <string> auth-error;
    in-out property <bool> sending;
    in-out property <bool> demo;
    in-out property <bool> more-chats;
    in-out property <bool> has-chat;
    in-out property <bool> loading-chats;
    in-out property <bool> loading-history;
    in-out property <string> history-error;
    in-out property <string> list-error;
    in-out property <string> storage-error;
    in-out property <bool> storage-retryable;
    in-out property <string> desktop-warning;
    in-out property <string> connection-status;
    in-out property <string> account-name;
    in-out property <bool> show-conversation: false;
    in-out property <bool> following: true;
    in-out property <int> new-count;
    in-out property <length> history-y;
    in-out property <bool> history-dragging;
    in-out property <string> query;
    in-out property <length> list-y;
    in-out property <length> editor-y;
    in-out property <length> search-list-y;
    in-out property <bool> searching;
    in-out property <int> result-focus: -1;
    in-out property <bool> narrow: self.window-width < 740px;
    in-out property <string> anchor-id;
    in-out property <length> anchor-screen-y;
    in-out property <bool> capture-anchor;
    in-out property <length> restore-y;
    in-out property <bool> restore-pending;
    in-out property <length> window-width;
    in-out property <length> conversation-height;
    in-out property <length> history-width;
    in-out property <length> history-extent;
    callback browse(int);
    callback refresh-friends();
    callback filter-friends();
    callback open-profile(string);
    callback start-friend-chat();
    callback open-photo(string);
    callback photo-closed();
    callback reconnect();
    callback start-sign-in();
    callback cancel-sign-in();
    callback select-chat(int);
    callback search-changed(string);
    callback draft-edited();
    callback refresh();
    callback retry-history();
    callback more();
    callback send();
    callback settings-changed();
    callback retry-storage();
    callback recover-message(string);
    callback demo-event(int);
    callback release-deferred();
    callback show-profile();
    callback close-profile();
    callback focus-composer();
    callback show-viewer(string);
    callback close-viewer();
    callback account-ready();
    callback close-sign-in();
    callback open-sign-in();
    callback show-history(length, bool);
    callback latest();
    callback focus-search();
    callback focus-friend-search();
    callback focus-settings-opener();
    callback focus-settings-close();
    callback focus-profile-close();
    callback focus-auth-start();
    callback focus-sign-in-opener();
    callback focus-viewer-close();
    callback focus-history();
    callback reset-viewer();
    callback history-jump(length);
}
