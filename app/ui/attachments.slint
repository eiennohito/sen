import { AttachmentState, ComposerState } from "globals.slint";
import { Dialog, Button } from "button.slint";
import { Tokens } from "tokens.slint";
import { IconButton } from "icon-button.slint";
import { Pane } from "scrollpane.slint";
export component Attachments inherits Dialog {
    visible: AttachmentState.attachments-open;
    changed visible => { if self.visible { cancel.focus(); } }

    panel-width: min(480px, root.width - 32px);
    panel-height: min(root.height - 32px, 148px + max(1, AttachmentState.attachment-items.length) * 64px);
    panel-border: Tokens.border;
    dismissed => { AttachmentState.cancel-attachments(); }

    GridLayout { padding: 24px; spacing: 16px;
        HorizontalLayout { row: 0; spacing: 8px;
            Text { text: "Send to " + AttachmentState.attachments-chat; color: Tokens.text; font-size: Tokens.heading; font-weight: 600; overflow: elide; }
            close := IconButton { label: "Close attachments"; icon: @image-url("../assets/icons/close.svg"); activated => { AttachmentState.cancel-attachments(); } }
        }
        Pane { row: 1; full-height: AttachmentState.attachment-items.length * 64px;
            VerticalLayout { spacing: 0px; alignment: start;
                for item[index] in AttachmentState.attachment-items: HorizontalLayout { height: 64px; spacing: 12px;
                    Rectangle { width: 56px; height: 56px; background: Tokens.surface-2; border-radius: 8px;
                        if item.photo: Image { source: item.picture; image-fit: contain; width: 100%; height: 100%; }
                        if !item.photo: Image { source: @image-url("../assets/icons/file.svg"); colorize: Tokens.secondary; width: 24px; height: 24px; x: 16px; y: 16px; }
                    }
                    VerticalLayout { alignment: center; spacing: 2px;
                        Text { text: item.name; font-size: Tokens.base; color: Tokens.text; overflow: elide; }
                        Text { text: item.size; color: Tokens.secondary; font-size: Tokens.small; }
                        if item.error != "": Text { text: item.error; color: Tokens.danger; font-size: Tokens.small; }
                    }
                    IconButton { label: "Remove " + item.name;
                        icon: @image-url("../assets/icons/close.svg"); activated => { AttachmentState.remove-attachment(index); cancel.focus(); } }
                }
            }
        }
        if AttachmentState.attachments-error != "": Text { row: 2; text: AttachmentState.attachments-error; font-size: Tokens.small; color: Tokens.danger; wrap: word-wrap; }
        HorizontalLayout { row: 3; alignment: end; spacing: 8px;
            cancel := Button { text: "Cancel"; clicked => { AttachmentState.cancel-attachments(); } }
            submit := Button { text: "Send " + AttachmentState.attachments-count; primary: true; enabled: AttachmentState.attachments-count > 0; clicked => { AttachmentState.send-attachments(); } }
        }
    }
}
