import { ShellState } from "globals.slint";
import { Tokens } from "tokens.slint";

export component Pressable inherits FocusScope {
    in property <bool> focus-on-activation: true;
    in property <brush> background;
    in property <length> border-radius;
    in property <length> border-width;
    in property <color> border-color;
    out property <bool> has-hover: touch.has-hover;
    out property <bool> pressed: touch.pressed;
    callback activated();
    focus-on-tab-navigation: root.enabled && root.visible;
    focus-on-click: root.enabled && root.visible && root.focus-on-activation;
    opacity: root.enabled ? 1 : 0.4;
    accessible-role: button; accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.activated(); } }
    callback key-event(KeyEvent) -> EventResult;
    key-event(event) => { reject }
    key-pressed(event) => {
        if !root.enabled || ShellState.ime-active { return reject; }
        if root.key-event(event) == accept { return accept; }
        if event.text == Key.Return || event.text == " " { root.activated(); return accept; }
        reject
    }
    Rectangle {
        background: root.background; border-radius: root.border-radius;
        border-width: root.border-width; border-color: root.border-color;
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { if root.focus-on-activation { root.focus(); } root.activated(); } }
    @children
}

export component FocusRing inherits Rectangle {
    in property <bool> focused;
    in property <bool> text-entry;
    in property <length> outset: 0px;
    in property <length> thickness: 2px;
    border-radius: 12px; border-color: Tokens.accent-strong;
    Rectangle {
        x: -root.outset; y: -root.outset;
        width: root.width + 2 * root.outset; height: root.height + 2 * root.outset;
        border-radius: root.border-radius; border-color: root.border-color;
        border-width: root.focused && (root.text-entry || ShellState.keyboard-navigation) ? root.thickness : 0px;
    }
}

export component Dialog inherits Rectangle {
    in property <length> panel-width: min(400px, root.width - 32px);
    in property <length> panel-height: content.preferred-height;
    in property <color> panel-border: Tokens.divider;
    in property <bool> shadow;
    callback dismissed();
    callback key-pressed(KeyEvent) -> EventResult;
    key-pressed(event) => { reject }
    in property <bool> full-window;
    // Boundary scopes participate only while native Tab traversal runs.
    out property <bool> traversing;
    background: Tokens.scrim;
    TouchArea { scroll-event => { accept } }
    panel := Rectangle {
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        width: root.panel-width; height: root.panel-height;
        background: Tokens.bg; border-radius: 12px; border-width: 1px; border-color: root.panel-border;
        drop-shadow-color: root.shadow ? #00000033 : transparent;
        drop-shadow-blur: root.shadow ? 16px : 0px; drop-shadow-offset-y: root.shadow ? 4px : 0px;
        content := FocusScope {
            focus-on-tab-navigation: root.traversing;
            capture-key-pressed(event) => {
                if ShellState.ime-active || event.text != Key.Tab { return reject; }
                root.traversing = true;
                ShellState.tab-focus(event.modifiers.shift);
                if content.has-focus { end.focus(); ShellState.tab-focus(true); }
                else if end.has-focus { content.focus(); ShellState.tab-focus(false); }
                root.traversing = false;
                accept
            }
            key-pressed(event) => { if root.key-pressed(event) == accept { return accept; } if !ShellState.ime-active && event.text == Key.Escape { root.dismissed(); return accept; } reject }
            @children
            end := FocusScope { width: 0px; height: 0px; focus-on-tab-navigation: root.traversing; }
        }
    }
    states [ full-window when root.full-window: {
        panel.width: root.width; panel.height: root.height; panel.border-radius: 0px; panel.border-width: 0px;
    } ]
}
export component Button inherits Pressable {
    in property <string> text;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> text-button;
    callback clicked();
    accessible-label: root.text; accessible-enabled: root.enabled;
    activated => { root.clicked(); }
    horizontal-stretch: 0;
    preferred-width: label.preferred-width + 32px;
    min-width: self.preferred-width;
    height: 32px; border-radius: 8px;
    background: root.primary ? (root.danger ? Tokens.danger : Tokens.accent-strong) : root.has-hover ? Tokens.surface-hover : root.text-button ? transparent : Tokens.surface-2;
    label := Text { text: root.text; font-size: Tokens.base; font-weight: 600; color: root.primary ? Tokens.on-accent : root.danger ? Tokens.danger : root.text-button ? Tokens.accent-strong : Tokens.text; horizontal-alignment: center; vertical-alignment: center; }
    FocusRing { outset: 4px; focused: root.has-focus; }
}
