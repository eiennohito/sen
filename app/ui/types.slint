export enum PanelState { none, settings, detail, viewer, sign-in }
export enum ConnectionState { local, connecting, online, offline, signed-out, fatal, signing-in }
export struct RichRun { text: string, break-before: bool, url: string, link-start: bool, link-first: bool, link-id: int, link-width: float, positioned: bool, natural-width: float, line-width: float, image-key: string, picture: image, has-picture: bool, emoji: bool, thumbnail: bool, contain: bool, thumbnail-text: string, newline: bool, x: float, y: float, measured-width: float, measured-height: float, available: float }
export enum RunPosition { single, first, middle, last }
export enum MessageKind { text, photo, sticker, video, voice, file, location, contact, system, withdrawn, undecryptable, unknown }
export struct LinkRow { label: string, url: string }
export struct ChatRow { unread: int, unread-unknown: bool, member-count: int, draft: bool, draft-preview: string, failed: bool, muted: bool, outgoing-preview: bool, group: bool, id: string, index: int, title: string, preview: string, preview-runs: [RichRun], initial: string, activity: string, time: string, avatar: image, avatar-key: string }
export struct FriendRow { count: int, header: bool, id: string, name: string, initial: string, status: string, status-runs: [RichRun], group: bool, avatar: image, avatar-key: string }
export struct ReactionRow { label: string, image-key: string, picture: image, has-picture: bool }
export struct MessageRow {
    uploading: bool, upload-progress: float, file-missing: bool, local-media: bool,
    own-reaction: int, can-react: bool, reaction-count: int,
    can-unsend: bool,
    file-failed: bool, file-failure: string, file-error: string, file-retryable: bool,
    skip-badge: bool, has-inline-emoji: bool, rich-fallback: bool,
    rich-runs: [RichRun], reply-id: string, reply-sender: string, reply-preview: string, reply-sender-id: string, reply-image-key: string, reply-picture: image, reply-has-picture: bool, detail: string,
    kind: MessageKind, links: [LinkRow], accessible-label: string,
    id: string, delivered-time: string, sticker: bool, photo: bool, sort-key: string, body: string, time: string, outgoing: bool,
    sender-id: string, sender-name: string, sender-initial: string, sender-key: string, sender-avatar: image, has-sender-avatar: bool,
    run-position: RunPosition, day-label: string, clock: string,
    image-key: string, picture: image, has-picture: bool, image-failed: bool, image-failure: string, image-error: string, image-retryable: bool,
    delivery: string, delivery-detail: string, recoverable: bool, reactions: [ReactionRow],
}

// Fixed gutter and a wide pointer target. Content changes during a thumb drag

export struct MemberRow { id: string, name: string, initial: string, status: string, avatar: image, avatar-key: string, is-self: bool, friend: bool, invited: bool }

export struct StickerTab { name: string, picture: image }
export struct StickerItem { index: int, picture: image }
export struct ComposeFriend { id: string, name: string, initial: string, avatar: image, selected: bool }

export struct AttachmentItem { name: string, size: string, photo: bool, picture: image, error: string }
