import { PanelState, Section, DetailState, ShellState } from "globals.slint";
enum RailCursor { chats, friends, settings, profile }
import { FocusRing } from "button.slint";
import { Avatar } from "avatar.slint";

import { Tokens } from "tokens.slint";

component RailButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> selected;
    in property <bool> focused;
    in property <bool> selectable;
    in property <string> badge;
    in property <bool> stale;
    callback activated();
    width: 44px; height: 44px;
    border-radius: 8px;
    background: root.selected ? Tokens.surface-selected : touch.pressed || touch.has-hover ? Tokens.surface-hover : transparent;
    Image { x: (parent.width - 24px) / 2; y: (parent.height - 24px) / 2; width: 24px; height: 24px; source: root.icon; colorize: root.selected ? Tokens.accent : Tokens.foreground; }
    Rectangle { visible: root.badge != "" || root.stale; x: parent.width - 22px; y: 0px; width: root.stale ? 8px : 22px; height: root.stale ? 8px : 20px; border-radius: 10px; background: Tokens.accent; Text { visible: !root.stale; text: root.badge; color: Tokens.on-accent; font-size: Tokens.time; horizontal-alignment: center; vertical-alignment: center; } }
    FocusRing { focused: root.focused; border-radius: root.border-radius; }
    touch := TouchArea { width: root.width; height: root.height; accessible-role: button; accessible-label: root.label; accessible-item-selectable: root.selectable; accessible-item-selected: root.selected; clicked => { root.activated(); } Tooltip { Text { text: root.label; color: Tokens.text; font-size: Tokens.small; } } }
}

export component Rail inherits Rectangle {
    background: Tokens.surface;
    out property <bool> has-focus: rail-focus.has-focus;
    public function focus-navigation() { rail-focus.focus(); }
    property <RailCursor> cursor: ShellState.section == Section.chats ? RailCursor.chats : RailCursor.friends;
    pure function index(cursor: RailCursor) -> int { return cursor == RailCursor.chats ? 0 : cursor == RailCursor.friends ? 1 : cursor == RailCursor.settings ? 2 : 3; }
    pure function at(index: int) -> RailCursor { return index == 0 ? RailCursor.chats : index == 1 ? RailCursor.friends : index == 2 ? RailCursor.settings : RailCursor.profile; }
    public function activate(cursor: RailCursor) {
        if cursor == RailCursor.chats || cursor == RailCursor.friends { ShellState.browse(cursor == RailCursor.chats ? Section.chats : Section.friends); }
        else if cursor == RailCursor.settings { ShellState.request-panel(PanelState.settings); }
        else if cursor == RailCursor.profile && (ShellState.account-mid != "") { DetailState.open-profile(ShellState.account-mid); }
    }
    rail-focus := FocusScope {
        accessible-role: button; accessible-label: "Navigation";
        key-pressed(event) => {
            if ShellState.ime-active { return reject; }
            if event.text == Key.UpArrow || event.text == Key.LeftArrow { root.cursor = root.at(max(0, root.index(root.cursor) - 1)); return accept; }
            if event.text == Key.DownArrow || event.text == Key.RightArrow { root.cursor = root.at(min(ShellState.narrow || (ShellState.account-mid == "") ? 2 : 3, root.index(root.cursor) + 1)); return accept; }
            if event.text == Key.Return || event.text == " " { root.activate(root.cursor); return accept; }
            reject
        }
        FlexboxLayout {
            flex-direction: ShellState.narrow ? row : column; flex-wrap: no-wrap; alignment: stretch;
            padding-left: ShellState.narrow ? 0px : 4px; padding-right: ShellState.narrow ? 0px : 8px;
            padding-top: ShellState.narrow ? 2px : 4px; padding-bottom: ShellState.narrow ? 2px : 8px;
            spacing: ShellState.narrow ? 0px : 4px;
            Rectangle { horizontal-stretch: 1; vertical-stretch: 0; height: 44px; RailButton { x: (parent.width - self.width) / 2; label: "Chats"; selectable: true; focused: rail-focus.has-focus && root.cursor == RailCursor.chats; stale: ShellState.unread-stale && ShellState.unread-conversations > 0; badge: ShellState.unread-conversations > 0 && !ShellState.unread-stale ? ShellState.unread-badge : ""; icon: @image-url("../assets/icons/chats.svg"); selected: ShellState.section == Section.chats; activated => { rail-focus.focus(); root.cursor = RailCursor.chats; root.activate(RailCursor.chats); } } }
            Rectangle { horizontal-stretch: 1; vertical-stretch: 0; height: 44px; RailButton { x: (parent.width - self.width) / 2; label: "Friends"; selectable: true; focused: rail-focus.has-focus && root.cursor == RailCursor.friends; icon: @image-url("../assets/icons/friends.svg"); selected: ShellState.section == Section.friends; activated => { rail-focus.focus(); root.cursor = RailCursor.friends; root.activate(RailCursor.friends); } } }
            if !ShellState.narrow: Rectangle { vertical-stretch: 1; }
            if !ShellState.narrow && ShellState.account-mid != "": Rectangle { height: 44px; vertical-stretch: 0; FocusRing { focused: rail-focus.has-focus && root.cursor == RailCursor.profile; border-radius: 8px; }
                Avatar { x: 8px; y: 4px; width: 32px; height: 32px; identity: ShellState.account-name; initial: ShellState.account-initial; picture: ShellState.account-avatar; label: "Your avatar"; TouchArea { accessible-role: button; accessible-label: "Your profile"; clicked => { DetailState.open-profile(ShellState.account-mid); } } } }
            Rectangle { horizontal-stretch: 1; vertical-stretch: 0; height: 44px; RailButton { x: (parent.width - self.width) / 2; label: "Settings"; focused: rail-focus.has-focus && root.cursor == RailCursor.settings; icon: @image-url("../assets/icons/settings.svg"); activated => { root.cursor = RailCursor.settings; root.activate(RailCursor.settings); } } }
        }
    }
}
