import { PanelState, Section } from "globals.slint";
enum RailCursor { chats, friends, settings, profile }
import { DetailState, ShellState } from "globals.slint";
import { FocusRing } from "button.slint";
import { Avatar } from "avatar.slint";

import { Tokens } from "tokens.slint";

component RailButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> selected;
    in property <bool> selectable;
    in property <string> badge;
    in property <bool> stale;
    callback activated();
    width: 44px; height: 44px;
    border-radius: 8px;
    background: root.selected ? Tokens.surface-selected : touch.pressed || touch.has-hover ? Tokens.surface-hover : transparent;
    Image { x: (parent.width - 24px) / 2; y: (parent.height - 24px) / 2; width: 24px; height: 24px; source: root.icon; colorize: root.selected ? Tokens.accent : Tokens.foreground; }
    if root.badge != "" || root.stale: Rectangle { x: parent.width - 22px; y: 0px; width: root.stale ? 8px : 22px; height: root.stale ? 8px : 20px; border-radius: 10px; background: Tokens.accent; Text { visible: !root.stale; text: root.badge; color: Tokens.on-accent; font-size: Tokens.time; horizontal-alignment: center; vertical-alignment: center; } }
    touch := TouchArea { accessible-role: button; accessible-label: root.label; accessible-item-selectable: root.selectable; accessible-item-selected: root.selected; clicked => { root.activated(); } Tooltip { Text { text: root.label; color: Tokens.text; font-size: Tokens.small; } } }
}

export component Rail inherits Rectangle {
    background: Tokens.surface;
    out property <bool> has-focus: rail-focus.has-focus;
    public function focus-navigation() { rail-focus.focus(); }
    property <RailCursor> cursor: ShellState.section == Section.chats ? RailCursor.chats : RailCursor.friends;
    pure function index(cursor: RailCursor) -> int { return cursor == RailCursor.chats ? 0 : cursor == RailCursor.friends ? 1 : cursor == RailCursor.settings ? 2 : 3; }
    pure function at(index: int) -> RailCursor { return index == 0 ? RailCursor.chats : index == 1 ? RailCursor.friends : index == 2 ? RailCursor.settings : RailCursor.profile; }
    public function activate(cursor: RailCursor) {
        if cursor == RailCursor.chats || cursor == RailCursor.friends { ShellState.browse(cursor == RailCursor.chats ? Section.chats : Section.friends); }
        else if cursor == RailCursor.settings { ShellState.request-panel(PanelState.settings); }
        else if cursor == RailCursor.profile && (ShellState.account-mid != "") { DetailState.open-profile(ShellState.account-mid); }
    }
    rail-focus := FocusScope {
        accessible-role: button; accessible-label: "Navigation";
        key-pressed(event) => {
            if ShellState.ime-active { return reject; }
            if event.text == Key.UpArrow || event.text == Key.LeftArrow { root.cursor = root.at(max(0, root.index(root.cursor) - 1)); return accept; }
            if event.text == Key.DownArrow || event.text == Key.RightArrow { root.cursor = root.at(min(ShellState.narrow || (ShellState.account-mid == "") ? 2 : 3, root.index(root.cursor) + 1)); return accept; }
            if event.text == Key.Return || event.text == " " { root.activate(root.cursor); return accept; }
            reject
        }
        FocusRing { x: ShellState.narrow ? parent.width * root.index(root.cursor) / 3 + (parent.width / 3 - 44px) / 2 : 4px; y: ShellState.narrow ? 2px : root.index(root.cursor) < 2 ? 4px + root.index(root.cursor) * 48px : root.cursor == RailCursor.profile ? parent.height - 100px : parent.height - 52px; width: 44px; height: 44px; focused: rail-focus.has-focus; border-radius: 8px; }
        RailButton { x: ShellState.narrow ? (parent.width / 3 - self.width) / 2 : 4px; y: ShellState.narrow ? 2px : 4px; label: "Chats"; selectable: true; stale: ShellState.unread-stale && ShellState.unread-conversations > 0; badge: ShellState.unread-conversations > 0 && !ShellState.unread-stale ? ShellState.unread-badge : ""; icon: @image-url("../assets/icons/chats.svg"); selected: ShellState.section == Section.chats; activated => { rail-focus.focus(); root.cursor = RailCursor.chats; root.activate(RailCursor.chats); } }
        RailButton { x: ShellState.narrow ? parent.width / 3 + (parent.width / 3 - self.width) / 2 : 4px; y: ShellState.narrow ? 2px : 52px; label: "Friends"; selectable: true; icon: @image-url("../assets/icons/friends.svg"); selected: ShellState.section == Section.friends; activated => { rail-focus.focus(); root.cursor = RailCursor.friends; root.activate(RailCursor.friends); } }
        if !ShellState.narrow && (ShellState.account-mid != ""): Avatar { x: 12px; y: parent.height - 96px; width: 32px; height: 32px; identity: ShellState.account-name; initial: ShellState.account-initial; label: "Your avatar"; TouchArea { accessible-role: button; accessible-label: "Your profile"; clicked => { DetailState.open-profile(ShellState.account-mid); } } }
        RailButton { x: ShellState.narrow ? parent.width * 2 / 3 + (parent.width / 3 - self.width) / 2 : 4px; y: ShellState.narrow ? 2px : parent.height - 52px; label: "Settings"; icon: @image-url("../assets/icons/settings.svg"); activated => { root.cursor = RailCursor.settings; root.activate(RailCursor.settings); } }
    }
}
