import { Avatar } from "avatar.slint";
import { PanelState } from "types.slint";
import { State } from "state.slint";
import { Tokens } from "tokens.slint";

component RailButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> selected;
    in property <bool> selectable;
    in property <string> badge;
    in property <bool> stale;
    callback activated();
    width: 44px; height: 44px;
    border-radius: 8px;
    background: root.selected ? Tokens.surface-selected : touch.pressed || touch.has-hover ? Tokens.surface-hover : transparent;
    Image { x: (parent.width - 24px) / 2; y: (parent.height - 24px) / 2; width: 24px; height: 24px; source: root.icon; colorize: root.selected ? Tokens.accent : Tokens.foreground; }
    if root.badge != "" || root.stale: Rectangle { x: parent.width - 22px; y: 0px; width: root.stale ? 8px : 22px; height: root.stale ? 8px : 20px; border-radius: 10px; background: Tokens.accent; Text { visible: !root.stale; text: root.badge; color: Tokens.on-accent; font-size: Tokens.time; horizontal-alignment: center; vertical-alignment: center; } }
    touch := TouchArea { accessible-role: button; accessible-label: root.label; accessible-item-selectable: root.selectable; accessible-item-selected: root.selected; clicked => { root.activated(); } Tooltip { Text { text: root.label; color: Tokens.text; font-size: Tokens.small; } } }
}

export component Rail inherits Rectangle {
    background: Tokens.surface;
    out property <bool> has-focus: rail-focus.has-focus;
    public function focus-navigation() { rail-focus.focus(); }
    property <int> cursor: State.section;
    public function activate(index: int) {
        if index < 2 { State.browse(index); }
        else if index == 2 { State.request-panel(PanelState.settings); State.focus-settings-close(); }
        else if index == 3 && State.has-account { State.open-profile("self"); }
    }
    rail-focus := FocusScope {
        accessible-role: button; accessible-label: "Navigation"; accessible-description: self.has-focus ? "Focused navigation" : "";
        key-pressed(event) => {
            if State.browser-key(event) == accept { return accept; }
            if State.ime-active { return reject; }
            if event.text == Key.Tab { if event.modifiers.shift { State.focus-cycle-end(); } else if State.section == 1 { State.focus-friend-search(); } else { State.focus-search(); } return accept; }
            if event.text == Key.UpArrow || event.text == Key.LeftArrow { root.cursor = max(0, root.cursor - 1); return accept; }
            if event.text == Key.DownArrow || event.text == Key.RightArrow { root.cursor = min(State.narrow || !State.has-account ? 2 : 3, root.cursor + 1); return accept; }
            if event.text == Key.Return || event.text == " " { root.activate(root.cursor); return accept; }
            reject
        }
        Rectangle { x: State.narrow ? parent.width * root.cursor / 3 + (parent.width / 3 - 44px) / 2 : 4px; y: State.narrow ? 2px : root.cursor < 2 ? 4px + root.cursor * 48px : root.cursor == 3 ? parent.height - 100px : parent.height - 52px; width: 44px; height: 44px; background: transparent; border-color: Tokens.accent-strong; border-width: rail-focus.has-focus ? 2px : 0px; border-radius: 8px; }
        RailButton { x: State.narrow ? (parent.width / 3 - self.width) / 2 : 4px; y: State.narrow ? 2px : 4px; label: "Chats"; selectable: true; stale: State.unread-stale && State.unread-conversations > 0; badge: State.unread-conversations > 0 && !State.unread-stale ? State.unread-conversations > 999 ? "999+" : "" + State.unread-conversations : ""; icon: @image-url("../assets/icons/chats.svg"); selected: State.section == 0; activated => { rail-focus.focus(); root.cursor = 0; root.activate(0); } }
        RailButton { x: State.narrow ? parent.width / 3 + (parent.width / 3 - self.width) / 2 : 4px; y: State.narrow ? 2px : 52px; label: "Friends"; selectable: true; icon: @image-url("../assets/icons/friends.svg"); selected: State.section == 1; activated => { rail-focus.focus(); root.cursor = 1; root.activate(1); } }
        if !State.narrow && State.has-account: Avatar { x: 12px; y: parent.height - 96px; width: 32px; height: 32px; identity: State.account-name; initial: State.account-initial; label: "Your avatar"; TouchArea { accessible-role: button; accessible-label: "Your profile"; clicked => { State.open-profile("self"); } } }
        RailButton { x: State.narrow ? parent.width * 2 / 3 + (parent.width / 3 - self.width) / 2 : 4px; y: State.narrow ? 2px : parent.height - 52px; label: "Settings"; icon: @image-url("../assets/icons/settings.svg"); activated => { root.cursor = 2; root.activate(2); } }
    }
}
