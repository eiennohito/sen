import { Tokens } from "tokens.slint";
import { Avatar } from "avatar.slint";
import { PreviewLine } from "preview-line.slint";
import { PreviewMode, RichRun } from "types.slint";
export component RowText inherits Text {
    wrap: no-wrap; overflow: elide; min-width: 0px;
}
export component ListRow inherits Rectangle {
    out property <length> row-height: max(68px, name.preferred-height + subtitle.preferred-height + 20px);
    preferred-height: root.row-height;
    in property <string> identity;
    in property <string> initial;
    in property <image> avatar;
    in property <string> title;
    in property <string> title-note;
    in property <string> subtitle;
    in property <[RichRun]> subtitle-runs;
    in property <PreviewMode> preview-mode;
    in property <string> draft-preview;
    in property <string> time;
    in property <bool> muted;
    in property <bool> show-preview: true;
    in property <length> trailing-width;
    in property <length> avatar-size: 44px; out property <string> preview: content.prefix + content.text;
    Avatar { x: Tokens.space-2; y: (parent.height - root.avatar-size) / 2; width: root.avatar-size; height: root.avatar-size; identity: root.identity; initial: root.initial; picture: root.avatar; label: root.title + " avatar"; }
    content := Rectangle {
        property <string> prefix;
        property <string> text: root.subtitle; property <[RichRun]> runs: root.subtitle-runs;
        x: Tokens.space-2 + root.avatar-size + Tokens.space-3; y: Tokens.space-2;
        width: max(0px, parent.width - self.x - Tokens.space-3); height: max(0px, parent.height - Tokens.space-4);
        title-line := Rectangle {
            x: 0px; width: parent.width;
            y: content.text == "" && content.runs.length == 0 ? (content.height - self.height) / 2 : 0px; height: Tokens.base * 1.5;
            time := Text { x: parent.width - self.width; y: 3px; text: root.time; color: Tokens.secondary; font-size: Tokens.time; }
            note := RowText { x: parent.width - self.width - root.trailing-width; width: min(self.preferred-width, parent.width * 0.4); height: parent.height; text: root.title-note; color: Tokens.secondary; font-size: Tokens.small; vertical-alignment: center; }
            name := RowText { x: 0px; y: 0px; width: max(0px, parent.width - time.width - note.width - (root.muted ? Tokens.space-6 : Tokens.space-2) - (root.time == "" ? root.trailing-width : 0px)); height: parent.height; text: root.title; accessible-description: self.width < self.preferred-width ? "Truncated" : ""; color: Tokens.text; font-weight: 600; vertical-alignment: center; }
            if root.muted: Image { x: name.width + Tokens.space-1; y: 3px; width: 16px; height: 16px; source: @image-url("../assets/icons/muted.svg"); colorize: Tokens.secondary; accessible-role: image; accessible-label: "Muted"; }
        }
        Rectangle {
            x: 0px; y: title-line.height + 2px; width: max(0px, parent.width - root.trailing-width); height: max(0px, parent.height - self.y); clip: true;
            subtitle := RowText { visible: content.runs.length == 0; width: parent.width; height: parent.height; text: content.prefix + content.text; font-size: Tokens.preview; color: Tokens.secondary; }
            if content.runs.length > 0 && root.show-preview: PreviewLine { width: parent.width; height: parent.height; runs: content.runs; prefix: content.prefix; text-color: Tokens.secondary; }
        }
    }
    states [
        draft when root.preview-mode == PreviewMode.draft: { content.text: "Draft: " + root.draft-preview; content.runs: []; }
        outgoing when root.preview-mode == PreviewMode.outgoing: { content.prefix: "You: "; }
    ]
    @children
}
