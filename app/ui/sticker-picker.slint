import { Pressable, FocusRing } from "button.slint";
import { State } from "state.slint";
import { Tokens } from "tokens.slint";
import { Pane } from "scrollpane.slint";
import { Button } from "std-widgets.slint";
export component StickerPicker inherits Rectangle {
    callback close();
    property <length> pack-stride: 40px;
    property <length> pack-size: 36px;
    property <bool> keyboard-selection;
    background: Tokens.bg; border-radius: 12px; border-width: 1px; border-color: Tokens.border;
    FocusScope {
        key-pressed(event) => { if State.ime-active { return reject; } if event.text == Key.Escape { root.close(); return accept; } reject }
        VerticalLayout { padding: 12px; spacing: 8px;
            strip := Flickable {
                height: root.pack-stride; vertical-stretch: 0;
                content-width: max(self.width, (State.sticker-tabs.length - 1) * root.pack-stride + root.pack-size);
                content-height: self.height;
                function scroll-to(position: length) {
                    self.content-x = max(self.width - self.content-width, min(0px, position));
                }
                function reveal(index: int) {
                    self.scroll-to(max(-index * root.pack-stride, min(self.content-x, self.width - index * root.pack-stride - root.pack-size)));
                }
                TouchArea {
                    width: strip.content-width; height: root.pack-stride;
                    scroll-event(event) => { strip.scroll-to(strip.content-x + (event.delta-x != 0px ? event.delta-x : event.delta-y)); accept }
                }
                for package-tab[i] in State.sticker-tabs: Rectangle {
                    x: i * root.pack-stride; width: root.pack-size; height: root.pack-size; border-radius: 8px;
                    background: i == State.sticker-package ? Tokens.surface-selected : transparent;
                    Image { source: package-tab.picture; width: parent.width; height: parent.height; image-fit: contain; }
                    pack-focus := Pressable {
                        property <bool> selected: i == State.sticker-package;
                        changed selected => { if self.selected && root.keyboard-selection { self.focus(); root.keyboard-selection = false; } }

                        FocusRing { focused: parent.has-focus; border-radius: 8px; }
                        accessible-role: tab; accessible-label: package-tab.name; accessible-item-selected: i == State.sticker-package;
                        activated => { self.focus(); root.keyboard-selection = false; State.select-sticker-package(i); strip.reveal(i); }
                        key-event(event) => {
                            if event.text == Key.LeftArrow || event.text == Key.RightArrow {
                                let next = max(0, min(State.sticker-tabs.length - 1, State.sticker-package + (event.text == Key.RightArrow ? 1 : -1)));
                                root.keyboard-selection = next != State.sticker-package; State.select-sticker-package(next); strip.reveal(next); return accept;
                            }
                            reject
                        }
                    }
                }
            }
            if State.stickers-failed: HorizontalLayout {
                Text { text: "Couldn't load stickers"; color: Tokens.secondary; vertical-alignment: center; }
                Button { text: "Retry"; clicked => { State.load-stickers(); } }
            }
            if State.sticker-tabs.length == 0 && !State.stickers-failed: Text { text: "No stickers"; color: Tokens.secondary; horizontal-alignment: center; vertical-alignment: center; }
            Pane { accessible-role: list; accessible-label: State.sticker-tabs[State.sticker-package].name + " stickers"; full-height: ceil(State.sticker-items.length / 4) * 76px;
                for sticker[i] in State.sticker-items: Rectangle {
                    x: mod(i, 4) * (parent.width / 4); y: floor(i / 4) * 76px; width: 72px; height: 72px; border-radius: 8px;
                    background: touch.has-hover ? Tokens.surface-hover : transparent;
                    Image { source: sticker.picture; width: parent.width; height: parent.height; image-fit: contain; accessible-role: image; accessible-label: "Sticker preview " + (i + 1); accessible-description: sticker.picture.width > 0 ? "Loaded" : "Loading"; }
                    touch := Pressable {
                        FocusRing { focused: parent.has-focus; border-radius: 8px; }
                        accessible-label: "Send sticker " + (i + 1);
                        activated => { State.send-sticker(sticker.index); root.close(); }
                    }
                }
            }
        }
    }
}
