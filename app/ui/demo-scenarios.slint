import { Button, ScrollView } from "std-widgets.slint";
import { DemoAutomation } from "types.slint";
import { State } from "state.slint";
import { Tokens } from "tokens.slint";

struct Scenario { text: string, label: string, kind: int }

export component DemoScenarios inherits Rectangle {
    // Keep the scenario surface in the main window on every backend.
    callback scenario-selected();
    property <bool> media-menu;
    property <int> first-focus-request;
    property <bool> first-scenario-focused;
    property <int> media-focus-last;
    property <bool> media-last-focused;
    function reset-focus() { root.first-scenario-focused = false; root.last-focus-request = 0; root.last-scenario-focused = false; root.media-focus-last = 0; root.media-last-focused = false; }
    public function handle-key(event: KeyEvent) -> EventResult {
        if event.text == Key.F12 && root.open() { return accept; }
        return reject;
    }
    // Keyboard navigation can scroll to the final scenario. Reopen at the first row.
    public function open() -> bool {
        if State.demo && !State.modal-open { root.reset-focus(); root.media-menu = false; State.remember-demo-focus(); State.demo-scenarios-open = true; scenario-scroll.content-y = 0px; close.focus(); return true; }
        return false;
    }
    public function dismiss() { root.reset-focus(); State.demo-scenarios-open = false; root.media-menu = false; State.restore-demo-focus(); }
    // A fixture may replace the previously focused message or button.
    callback run(int);
    run(kind) => { root.dismiss(); root.scenario-selected(); State.demo-event(kind); }
    property <[[Scenario]]> scenarios: [
        [{text:"History",label:"Long history",kind:0},{text:"Arrivals",label:"Receive 3",kind:1}],
        [{text:"Media",label:"Media failures",kind:-1}],
        [{text:"Rejected",label:"Rejected send",kind:10},{text:"Reject next send",label:"Reject next send",kind:31}],
        [{text:"Send state",label:"Unanswered send",kind:3}],
        [{text:"Reading fixtures",label:"Reading fixtures",kind:8},{text:"Rich content",label:"Rich content",kind:12}],
        [{text:"Photo preview",label:"Photo preview",kind:5},{text:"Sticker preview",label:"Sticker preview",kind:6}],
        [{text:"Long chat list",label:"Long chat list",kind:15}],
        [{text:"Group preview",label:"Group preview",kind:7},{text:"Unread scenario",label:"Unread scenario",kind:14}],
        [{text:"Message actions",label:"Message actions",kind:47}],
        [{text:"Attachments",label:"Synthetic attachments",kind:34}],
        [{text:"Protocol fixtures",label:"Protocol fixtures",kind:32},{text:"Live reaction",label:"Live reaction",kind:33}],
        [{text:"Crypto",label:"Sign-in crypto failure",kind:40},{text:"State",label:"Sign-in state failure",kind:41},{text:"Keyring",label:"Sign-in keyring failure",kind:42}],
        [{text:"Network",label:"Sign-in network failure",kind:43},{text:"Server",label:"Sign-in server failure",kind:44},{text:"Phone",label:"Sign-in phone failure",kind:45},{text:"Cancelled",label:"Sign-in cancelled",kind:46}],
        [{text:"Expired sign-in",label:"Expired sign-in",kind:19}],
        [{text:"Reconnect",label:"Reconnect blip",kind:16},{text:"Offline",label:"Offline",kind:17}],
    ];
    property <int> last-focus-request;
    property <bool> last-scenario-focused;
    dialog := Rectangle {
        visible: State.demo-scenarios-open;
        width: root.width; height: root.height;
        Rectangle {
            background: Tokens.foreground.with-alpha(0.32);
            TouchArea { scroll-event(event) => { accept } }
        }
        scenario-panel := Rectangle {
            x: State.narrow ? 0px : (parent.width - self.width) / 2;
            y: State.narrow ? 0px : (parent.height - self.height) / 2;
            width: State.narrow ? parent.width : min(560px, parent.width - 48px);
            height: State.narrow ? parent.height : min(640px, parent.height - 48px);
            background: Tokens.background; border-width: 1px; border-color: Tokens.border;
            FocusScope {
                key-pressed(event) => {
                    if event.text == Key.Escape { root.dismiss(); return accept; }
                    if event.text == Key.Tab {
                        if !root.media-menu && !event.modifiers.shift && close.has-focus { root.first-focus-request += 1; return accept; }
                        if !root.media-menu && event.modifiers.shift && root.first-scenario-focused { close.focus(); return accept; }
                        if event.modifiers.shift && close.has-focus { if root.media-menu { root.media-focus-last += 1; } else { root.last-focus-request += 1; } return accept; }
                        if !event.modifiers.shift && ((root.media-menu && root.media-last-focused) || (!root.media-menu && root.last-scenario-focused)) { close.focus(); return accept; }
                    }
                    reject
                }
                VerticalLayout {
                    padding: 16px; spacing: 12px;
                    Text { text: "Demo scenarios"; font-size: Tokens.heading; color: Tokens.foreground; }
                    close := Button { text: "Close demo scenarios"; accessible-description: self.has-focus ? "Focused" : ""; clicked => { root.dismiss(); } }
                    scenario-scroll := ScrollView {
                        horizontal-scrollbar-policy: always-off;
                        VerticalLayout {
                            padding-right: 12px; spacing: 8px; alignment: start;
                            if State.automation-background && !root.media-menu: HorizontalLayout { spacing: 8px;
                                Rectangle { height: 32px; background: Tokens.surface-2;
                                    TextInput { text <=> State.attachment-injection-paths; accessible-label: "Attachment paths"; single-line: true; color: Tokens.text; font-size: Tokens.small; }
                                }
                                Rectangle { width: 140px; height: 32px; background: Tokens.surface-2;
                                    Text { text: "Preview attachments"; color: Tokens.text; font-size: Tokens.small; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { accessible-role: button; accessible-label: "Preview attachments"; clicked => { root.dismiss(); State.inject-attachments(State.attachment-injection-paths); } }
                                }
                            }
                            if State.demo-reset-enabled && !root.media-menu: Button { text: "Reset demo"; clicked => { root.dismiss(); State.demo-automation(DemoAutomation.reset); } }
                            demo-marker := Text { text: "Synthetic interaction scenarios"; accessible-value: State.demo-instance; accessible-description: "Reset generation " + State.demo-reset-generation; color: Tokens.secondary; font-size: Tokens.small; }
                            VerticalLayout {
                                visible: !root.media-menu; height: self.visible ? self.preferred-height : 0px;
                                spacing: 8px; alignment: start;
                                for row in root.scenarios: VerticalLayout {
                                    spacing: 8px;
                                    HorizontalLayout {
                                        for scenario in row: Button {
                                            text: scenario.text; accessible-label: scenario.label;
                                            accessible-description: self.has-focus ? "Focused" : "";
                                            horizontal-stretch: row.length == 1 ? 1 : 0;
                                            property <int> first-request: root.first-focus-request;
                                            changed first-request => { if scenario.kind == 0 && State.demo-scenarios-open && !root.media-menu { self.focus(); } }
                                            property <int> focus-request: root.last-focus-request;
                                            changed focus-request => { if self.focus-request > 0 && State.demo-scenarios-open && scenario.kind == 17 { self.focus(); } }
                                            changed has-focus => { if scenario.kind == 0 { root.first-scenario-focused = self.has-focus; } if scenario.kind == 17 { root.last-scenario-focused = self.has-focus; } }
                                            clicked => { if scenario.kind == -1 { root.media-focus-last = 0; root.media-last-focused = false; root.media-menu = true; close.focus(); } else { root.run(scenario.kind); } }
                                        }
                                    }
                                }
                            }
                            if root.media-menu: Rectangle {
                                height: media-options.preferred-height;
                                property <int> focus-last: root.media-focus-last;
                                changed focus-last => { if self.focus-last > 0 && State.demo-scenarios-open && root.media-menu { media-last.focus(); } }
                                media-options := VerticalLayout {
                                    spacing: 8px; alignment: start;
                                    Button { text: "Back to scenarios"; clicked => { root.media-menu = false; close.focus(); } }
                                    for label[index] in ["Media timeout", "Media network", "Media 404", "Media 403", "Media 500", "Media unsupported sender", "Media rejected path", "Media too large", "Media decode failure"]: Button { text: label; clicked => { root.run(20 + index); } }
                                    media-last := Button {
                                        text: "Media cancelled"; accessible-description: self.has-focus ? "Focused" : "";
                                        changed has-focus => { root.media-last-focused = self.has-focus; }
                                        clicked => { root.run(29); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
