import { Button, ScrollView } from "std-widgets.slint";
import { State } from "state.slint";
import { Tokens } from "tokens.slint";

struct Scenario { text: string, label: string, kind: int }

export component DemoScenarios inherits Rectangle {
    // PopupWindow preserves the exact focused item, including selections in the shell.
    callback scenario-selected();
    property <bool> media-menu;
    property <int> media-focus-last;
    property <bool> media-last-focused;
    function reset-focus() { root.last-focus-request = 0; root.last-scenario-focused = false; root.last-notification-focused = false; root.media-focus-last = 0; root.media-last-focused = false; }
    public function open() {
        if State.demo && !State.modal-open { root.reset-focus(); root.media-menu = false; dialog.show(); State.demo-scenarios-open = true; }
    }
    public function dismiss() { root.reset-focus(); dialog.close(); State.demo-scenarios-open = false; root.media-menu = false; }
    // A fixture may replace the previously focused message or button.
    callback run(int);
    run(kind) => { root.dismiss(); root.scenario-selected(); State.demo-event(kind); }
    public function notify(kind: int) { root.dismiss(); State.demo-notification(kind); }
    property <[[Scenario]]> scenarios: [
        [{ text: "History", label: "Long history", kind: 0 }, { text: "Arrivals", label: "Receive 3", kind: 1 }],
        [{ text: "Media", label: "Media failures", kind: -1 }, { text: "Rejected", label: "Rejected send", kind: 10 }],
        [{ text: "Fail next send", label: "Fail next send", kind: 30 }],
        [{ text: "Reject next send", label: "Reject next send", kind: 31 }],
        [{ text: "Send state", label: "Uncertain send", kind: 3 }],
        [{ text: "Paged history", label: "Paged history", kind: 11 }],
        [{ text: "Photo preview", label: "Photo preview", kind: 5 }],
        [{ text: "Sticker preview", label: "Sticker preview", kind: 6 }],
        [{ text: "Group preview", label: "Group preview", kind: 7 }],
        [{ text: "Reading fixtures", label: "Reading fixtures", kind: 8 }, { text: "History load", label: "History load", kind: 9 }],
        [{ text: "Unread scenario", label: "Unread scenario", kind: 14 }],
        [{ text: "Rich content", label: "Rich content", kind: 12 }],
        [{ text: "Long chat list", label: "Long chat list", kind: 15 }],
        [{ text: "Login recovery", label: "Login recovery", kind: 4 }],
        [{ text: "Reconnect blip", label: "Reconnect blip", kind: 16 }],
        [{ text: "Offline", label: "Offline", kind: 17 }],
        [{ text: "Expired sign-in", label: "Expired sign-in", kind: 19 }],
        [{ text: "Group members", label: "Group members", kind: 32 }],
        [{ text: "List load failure", label: "List load failure", kind: 18 }],
    ];
    property <[string]> notifications: ["Demo inactive", "Demo muted", "Demo replay", "Demo mention", "Demo exposed"];
    property <int> last-focus-request;
    property <bool> last-scenario-focused;
    property <bool> last-notification-focused;
    dialog := PopupWindow {
        width: root.width; height: root.height;
        close-policy: no-auto-close;
        property <bool> opened: State.demo-scenarios-open;
        changed opened => { if self.opened { close.focus(); } }
        Rectangle {
            background: Tokens.foreground.with-alpha(0.32);
            TouchArea { scroll-event(event) => { accept } }
        }
        scenario-panel := Rectangle {
            x: State.narrow ? 0px : (parent.width - self.width) / 2;
            y: State.narrow ? 0px : (parent.height - self.height) / 2;
            width: State.narrow ? parent.width : min(560px, parent.width - 48px);
            height: State.narrow ? parent.height : min(640px, parent.height - 48px);
            background: Tokens.background; border-width: 1px; border-color: Tokens.border;
            FocusScope {
                key-pressed(event) => {
                    if event.text == Key.Escape { root.dismiss(); return accept; }
                    if event.text == Key.Tab {
                        if event.modifiers.shift && close.has-focus { if root.media-menu { root.media-focus-last += 1; } else { root.last-focus-request += 1; } return accept; }
                        if !event.modifiers.shift && ((root.media-menu && root.media-last-focused) || (!root.media-menu && ((!State.demo-notifications && root.last-scenario-focused) || root.last-notification-focused))) { close.focus(); return accept; }
                    }
                    reject
                }
                VerticalLayout {
                    padding: 16px; spacing: 12px;
                    Text { text: "Demo scenarios"; font-size: Tokens.heading; color: Tokens.foreground; }
                    close := Button { text: "Close demo scenarios"; accessible-description: self.has-focus ? "Focused" : ""; clicked => { root.dismiss(); } }
                    ScrollView {
                        horizontal-scrollbar-policy: always-off;
                        VerticalLayout {
                            padding-right: 12px; spacing: 8px; alignment: start;
                            demo-marker := Text { text: "Synthetic interaction scenarios"; color: Tokens.secondary; font-size: Tokens.small; }
                            if State.preview-demo: HorizontalLayout {
                                Button { text: "Preview loading"; clicked => { root.run(32); } }
                                Button { text: "Preview loaded"; clicked => { root.run(33); } }
                            }
                            VerticalLayout {
                                visible: !root.media-menu; height: self.visible ? self.preferred-height : 0px;
                                spacing: 8px; alignment: start;
                                for row in root.scenarios: VerticalLayout {
                                    spacing: 8px;
                                    HorizontalLayout {
                                        for scenario in row: Button {
                                            text: scenario.text; accessible-label: scenario.label;
                                            accessible-description: self.has-focus ? "Focused" : "";
                                            horizontal-stretch: row.length == 1 ? 1 : 0;
                                            property <int> focus-request: root.last-focus-request;
                                            changed focus-request => { if self.focus-request > 0 && State.demo-scenarios-open && scenario.kind == 18 && !State.demo-notifications { self.focus(); } }
                                            changed has-focus => { if scenario.kind == 18 { root.last-scenario-focused = self.has-focus; } }
                                            clicked => { if scenario.kind == -1 { root.media-focus-last = 0; root.media-last-focused = false; root.media-menu = true; close.focus(); } else { root.run(scenario.kind); } }
                                        }
                                    }
                                    if row[0].kind == 11 && State.paging-demo: Text { text: "History window " + State.messages.length + " · retained " + State.history-retained + " · pages " + State.history-pages; font-size: Tokens.small; color: Tokens.secondary; wrap: word-wrap; }
                                }
                                VerticalLayout {
                                    visible: State.demo-notifications; height: self.visible ? self.preferred-height : 0px;
                                    spacing: 8px;
                                    Text { text: "Notification preview scenarios"; color: Tokens.secondary; wrap: word-wrap; }
                                    for label[i] in root.notifications: Button {
                                        text: label; accessible-description: self.has-focus ? "Focused" : "";
                                        property <int> focus-request: root.last-focus-request;
                                        changed focus-request => { if self.focus-request > 0 && State.demo-scenarios-open && i == 4 && State.demo-notifications { self.focus(); } }
                                        changed has-focus => { if i == 4 { root.last-notification-focused = self.has-focus; } }
                                        clicked => { root.notify(i); }
                                    }
                                }
                            }
                            if root.media-menu: Rectangle {
                                height: media-options.preferred-height;
                                property <int> focus-last: root.media-focus-last;
                                changed focus-last => { if self.focus-last > 0 && State.demo-scenarios-open && root.media-menu { media-last.focus(); } }
                                media-options := VerticalLayout {
                                    spacing: 8px; alignment: start;
                                    Button { text: "Back to scenarios"; clicked => { root.media-menu = false; close.focus(); } }
                                    Button { text: "Load media"; clicked => { root.run(2); } }
                                    for label[index] in ["Media timeout", "Media network", "Media 404", "Media 403", "Media 500", "Media unsupported sender", "Media rejected path", "Media too large", "Media decode failure"]: Button { text: label; clicked => { root.run(20 + index); } }
                                    media-last := Button {
                                        text: "Media cancelled"; accessible-description: self.has-focus ? "Focused" : "";
                                        changed has-focus => { root.media-last-focused = self.has-focus; }
                                        clicked => { root.run(29); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
