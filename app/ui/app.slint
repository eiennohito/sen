import { DemoExtension } from "@demo/demo-app.slint";
import { ExtensionState } from "@demo/demo-state.slint";
export * from "@demo/demo-api.slint";
import { Attachments } from "attachments.slint";
import { NewChat } from "new-chat.slint";
export { State } from "state.slint";
export { Palette } from "std-widgets.slint";
import { State } from "state.slint";
import { Tokens } from "tokens.slint";
import { TextMetrics, RichMetric } from "text-metrics.slint";
export { RichMetric } from "text-metrics.slint";

export { DeliveryState, RecoveryKind, RecoveryAction, DetailAction, ChatCategory, HistoryRowKind, PanelState, ConnectionState, ChatRow, MemberRow, FriendRow, MessageRow, ReactionRow, ReactorRow, MessageKind, LinkRow, RichRun } from "types.slint";
import { Rail } from "rail.slint";
import { Friends } from "friends.slint";
import { Chats } from "chats.slint";
import { Conversation } from "conversation.slint";
import { Layers } from "layers.slint";
import { RecoveryDialog } from "recovery-dialog.slint";
import { ConnectionNotice } from "connection-notice.slint";

export component AppWindow inherits Window {

    public function measure-rich(content: string, size: float) -> RichMetric { return rich-metrics.measure(content, size); }
    public function go-back() { if State.narrow && State.show-conversation && !State.modal-open { State.show-conversation = false; if State.section == 1 { State.focus-friend-search(); } else { State.focus-search(); } } }
    public function back-to-members() { layers.back-to-members(); }

    public function focus-composer() { if State.detail-open && State.profile-sheet { State.focus-profile-close(); } else { conversation.focus-editor(); } }
    public function focus-reading-before-editor() { conversation.focus-reading-before-editor(); }
    title: ExtensionState.title-override != "" ? ExtensionState.title-override : State.unread-conversations > 0 && !State.unread-stale ? "LINE (" + State.unread-conversations + ")" : "LINE";
    icon: @image-url("../assets/icon.svg");
    forward-focus: shell;
    preferred-width: 980px; preferred-height: 720px;
    min-width: 360px; min-height: 520px;
    background: Tokens.background;
    default-font-size: Tokens.base;
    public function restore-editor(anchor: int, caret: int) { conversation.restore-editor(anchor, caret); }

    property <length> token-base: State.text-size * 1px;
    changed token-base => { Tokens.base = root.token-base; }
    property <length> state-window-width: root.width;
    changed state-window-width => {
        State.browser-focus-hidden = State.window-width >= State.narrow-width && root.width < State.narrow-width && State.show-conversation && (rail.has-focus || (State.section == 1 ? friends-surface.has-focus : chats-surface.has-focus));
        State.window-width = root.width; State.window-height = root.height;
    }
    changed height => { State.window-height = root.height; }
    init => { State.window-width = root.width; State.window-height = root.height; Tokens.base = State.text-size * 1px; }
    public function reveal-chat(index: int) { chats-surface.reveal(index); }
    public function focus-cycle-end() {
        if State.detail-open { layers.focus-profile-last(); }
        else if !State.narrow || State.show-conversation { conversation.focus-last(); }
        else if State.section == 1 { friends-surface.focus-list(); }
        else { chats-surface.focus-list(); }
    }
    public function focus-after-browser() {
        if State.detail-open && State.profile-sheet { if State.connection-actions-enabled { auth-notice.focus-first(); } else { layers.focus-profile(); } }
        else if State.narrow && !State.show-conversation { rail.focus-navigation(); }
        else { conversation.focus-first(); }
    }
    public function focus-after-conversation() {
        if State.detail-open { layers.focus-profile(); }
        else if State.narrow { conversation.focus-first(); }
        else { rail.focus-navigation(); }
    }
    public function focus-before-layer() {
        if State.profile-sheet && State.connection-actions-enabled { auth-notice.focus-action(); }
        else if State.narrow { layers.focus-profile-last(); }
        else if !State.profile-sheet { conversation.focus-last(); }
        else if State.section == 1 { friends-surface.focus-list(); }
        else { chats-surface.focus-list(); }
    }
    public function focus-after-layer() {
        if State.narrow { if State.connection-actions-enabled { auth-notice.focus-first(); } else { layers.focus-profile(); } }
        else { rail.focus-navigation(); }
    }
    public function focus-search() { chats-surface.focus-search(); }
    public function focus-chat-list() { chats-surface.focus-list(); }
    public function focus-friend-list() { friends-surface.focus-list(); }
    public function focus-friend-search() { friends-surface.focus-search(); }
    public function focus-settings-opener() { rail.focus-navigation(); }
    public function focus-settings-close() { layers.focus-settings(); }
    public function focus-profile-close() { layers.focus-profile-close(); }
    public function focus-auth-start() { layers.focus-auth(); }
    public function focus-viewer-close() { layers.focus-viewer(); }
    public function focus-history() { if State.detail-open && State.profile-sheet { State.focus-profile-close(); } else { conversation.focus-history(); } }
    public function focus-connection-first() { auth-notice.focus-first(); }
    public function focus-sign-in-opener() { auth-notice.focus-action(); }
    public function reset-viewer() { layers.reset-viewer(); }
    public function history-scroll(delta: length) { conversation.scroll(delta); }
    public function history-jump(y: length) { conversation.jump(y); }

    extension := DemoExtension {
        width: root.width; height: root.height;
        shell := FocusScope {
            enabled: !State.new-chat-open && !State.attachments-open;
            focus-on-tab-navigation: false;
            key-pressed(event) => { if State.browser-key(event) == accept { return accept; } if !State.ime-active && event.modifiers.alt && event.text == Key.LeftArrow { root.go-back(); return accept; } reject }
            y: 0px;
            width: 100%; height: root.height;
            visible: !State.auth-open && !State.viewer-open && !(State.narrow && State.detail-open);
            rail := Rail { x: 0px; y: State.narrow ? parent.height - 48px : 0px; width: State.narrow ? parent.width : State.rail-width; height: State.narrow ? 48px : parent.height; visible: !State.narrow || !State.show-conversation; }
            browser := Rectangle {
                x: State.narrow ? 0px : State.rail-width; y: 0px;
                height: parent.height - (State.narrow ? 48px : 0px);
                visible: (!State.narrow || !State.show-conversation);
                width: !self.visible ? 0px : State.narrow ? State.window-width : State.browser-width;
                horizontal-stretch: 0;
                background: Tokens.alternate-background; clip: true;
                friends-surface := Friends {}
                chats-surface := Chats {}
            }

            conversation := Conversation { x: State.narrow ? 0px : browser.x + browser.width; width: max(0px, parent.width - self.x - (!State.profile-sheet && State.detail-open ? State.panel-width : 0px)); height: parent.height; visible: (State.has-account || State.has-chat) && (!State.narrow || State.show-conversation) && !(State.detail-open && State.profile-sheet); }
        }
        layers := Layers {}
        NewChat { width: parent.width; height: parent.height; }
        auth-notice := ConnectionNotice {
            x: State.connection-area-x; y: State.connection-area-y;
            width: State.connection-area-width;
            visible: State.connection-feedback-visible;
            leave(back) => {
                if State.detail-open && State.profile-sheet {
                    if !back { layers.focus-profile(); }
                    else if State.narrow { layers.focus-profile-last(); }
                    else if State.section == 1 { friends-surface.focus-list(); }
                    else { chats-surface.focus-list(); }
                } else if !State.narrow || State.show-conversation {
                    if back { conversation.focus-header(); } else { conversation.focus-history(); }
                } else if State.section == 1 {
                    if back { friends-surface.focus-search-last(); } else { friends-surface.focus-list(); }
                } else {
                    if back { chats-surface.focus-search-last(); } else { chats-surface.focus-list(); }
                }
            }
        }
        Attachments { }
        RecoveryDialog { }
    }
    rich-metrics := TextMetrics {}
}
