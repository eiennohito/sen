import { NewChatState, AttachmentState, Section, DetailPageMode, PanelState, AuthState, ComposerState, ConversationState, DetailState, ShellState, ViewerState } from "globals.slint";
export { AuthPhase, NotificationPreview } from "globals.slint";
export { ChatCategory, ComposerMode, ConnectionState, DetailAction, DetailPageMode, PanelState, RecoveryAction, RecoveryKind, Section } from "globals.slint";
export { NewChatState, AttachmentState, ShellState, ChatsState, FriendsState, ConversationState, ComposerState, DetailState, ViewerState, SettingsState, AuthState, ContentState } from "globals.slint";
import { DemoExtension } from "@demo/demo-app.slint";
export * from "@demo/demo-api.slint";
import { Attachments } from "attachments.slint";
import { NewChat } from "new-chat.slint";
export { Palette } from "std-widgets.slint";
import { Tokens } from "tokens.slint";
import { TextMetrics, RichMetric } from "text-metrics.slint";
export { RichMetric } from "text-metrics.slint";

export { FocusOpener, PreviewMode, DeliveryState, HistoryRowKind, ChatRow, MemberRow, FriendRow, MessageRow, ReactionRow, ReactorRow, MessageKind, LinkRow, RichRun } from "types.slint";
import { Rail } from "rail.slint";
import { Friends } from "friends.slint";
import { Chats } from "chats.slint";
import { Conversation } from "conversation.slint";
import { Layers } from "layers.slint";
import { RecoveryDialog } from "recovery-dialog.slint";

import { FocusOpener } from "types.slint";

enum Cover { none, sheet, conversation }

export component AppWindow inherits Window {
    public function focus-opener() -> FocusOpener {
        if rail.has-focus { return FocusOpener.navigation; }
        if chats-surface.has-focus { return chats-surface.search-focused ? FocusOpener.search : FocusOpener.chats; }
        if friends-surface.has-focus { return friends-surface.search-focused ? FocusOpener.friend-search : FocusOpener.friends; }
        let opener = conversation.focus-opener();
        if opener != FocusOpener.none { return opener; }
        if layers.detail-focused { return layers.focus-opener(); }
        return FocusOpener.none;
    }
    public function restore-opener(opener: FocusOpener) {
        if ((opener == FocusOpener.search || opener == FocusOpener.chats) && (!shell.visible || !browser.visible || !chats-host.visible))
            || ((opener == FocusOpener.friend-search || opener == FocusOpener.friends) && (!shell.visible || !browser.visible || !friends-host.visible))
            || (opener == FocusOpener.navigation && (!shell.visible || !rail.visible))
            || (opener == FocusOpener.member-list && (!DetailState.detail-open || DetailState.detail-page != DetailPageMode.members))
            || (opener == FocusOpener.group-members && (!DetailState.detail-open || DetailState.detail-page != DetailPageMode.group))
            || (opener == FocusOpener.profile-photo && (!DetailState.detail-open || DetailState.detail-page == DetailPageMode.members))
            || ((opener == FocusOpener.title || opener == FocusOpener.more || opener == FocusOpener.history || opener == FocusOpener.composer || opener == FocusOpener.members-button) && (!shell.visible || !conversation-host.visible))
            || (opener == FocusOpener.members-button && !ConversationState.chat-group)
            || opener == FocusOpener.none { root.focus-composer(); return; }
        if opener == FocusOpener.search { chats-surface.focus-search(); }
        else if opener == FocusOpener.chats { chats-surface.focus-list(); }
        else if opener == FocusOpener.friend-search { friends-surface.focus-search(); }
        else if opener == FocusOpener.friends { friends-surface.focus-list(); }
        else if opener == FocusOpener.navigation { rail.focus-navigation(); }
        else if opener == FocusOpener.member-list || opener == FocusOpener.group-members || opener == FocusOpener.profile-photo { layers.restore-opener(opener); }
        else { conversation.restore-opener(opener); }
    }
    public function paste-text() { conversation.paste-text(); }

    public function measure-rich(content: string, size: float) -> RichMetric { return rich-metrics.measure(content, size); }

    public function focus-composer() { if DetailState.detail-open && ShellState.profile-sheet { root.focus-profile-close(); } else { conversation.focus-editor(); } }

    title: ShellState.title-override != "" ? ShellState.title-override : ShellState.unread-conversations > 0 && !ShellState.unread-stale ? "閃 (" + ShellState.unread-conversations + ")" : "閃";
    icon: @image-url("../assets/icon.svg");
    forward-focus: shell;
    preferred-width: 980px; preferred-height: 720px;
    min-width: 360px; min-height: 520px;
    background: Tokens.background;
    default-font-size: Tokens.base;
    public function restore-editor(anchor: int, caret: int) { conversation.restore-editor(anchor, caret); }

    property <bool> browser-had-focus: rail.has-focus || (ShellState.section == Section.friends ? friends-surface.has-focus : chats-surface.has-focus);
    property <Cover> cover: ShellState.narrow ? Cover.conversation : ShellState.profile-sheet ? Cover.sheet : Cover.none;
    changed cover => {
        if ShellState.window-modal-open { return; }
        if DetailState.detail-open { root.focus-profile-close(); }
        else if root.cover == Cover.conversation && ShellState.show-conversation && root.browser-had-focus { root.focus-composer(); }
    }
    property <{ width: length, height: length }> window-size: { width: root.width, height: root.height };
    changed window-size => { ShellState.window-width = root.window-size.width; ShellState.window-height = root.window-size.height; }
    init => { ShellState.window-width = root.width; ShellState.window-height = root.height; }
    public function reveal-chat(index: int) { chats-surface.reveal(index); }

    public function focus-search() { chats-surface.focus-search(); }
    public function focus-friend-search() { friends-surface.focus-search(); }
    public function focus-settings-opener() { rail.focus-navigation(); }
    public function focus-settings-close() { layers.focus-settings(); }
    public function focus-profile-close() { layers.focus-profile-close(); }
    public function focus-auth-start() { layers.focus-auth(); }
    public function focus-history() { if DetailState.detail-open && ShellState.profile-sheet { root.focus-profile-close(); } else { conversation.focus-history(); } }
    public function focus-connection-first() { if !ShellState.narrow || ShellState.show-conversation { conversation.focus-connection(); } else if ShellState.section == Section.friends { friends-surface.focus-connection(); } else { chats-surface.focus-connection(); } }
    public function show-viewer(key: string) { ShellState.request-panel(PanelState.viewer); ViewerState.viewer-key = key; layers.reset-viewer(); }
    public function reset-viewer() { layers.reset-viewer(); }
    public function history-scroll(delta: length) { conversation.scroll(delta); }
    public function history-jump(y: length) { conversation.jump(y); }

    extension := DemoExtension {
        capture-key-pressed(event) => {
            if event.text == Key.F6 && (chats-surface.connection-focused || friends-surface.connection-focused || conversation.connection-focused) { return reject; }
            if event.modifiers.alt && (event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.LeftArrow || event.text == Key.RightArrow) && (ShellState.window-modal-open || chats-surface.editing || friends-surface.editing || conversation.editing || layers.editing) { return reject; }
            ShellState.browser-key(event)
        }
        width: root.width; height: root.height;
        shell := FocusScope {
            enabled: !NewChatState.new-chat-open && !AttachmentState.attachments-open;
            focus-on-tab-navigation: false;
            y: 0px;
            width: 100%; height: root.height;
            visible: !AuthState.auth-open && !ViewerState.viewer-open && !(ShellState.narrow && DetailState.detail-open);
            rail := Rail { x: 0px; y: ShellState.narrow ? parent.height - 48px : 0px; width: ShellState.narrow ? parent.width : ShellState.rail-width; height: ShellState.narrow ? 48px : parent.height; visible: !ShellState.narrow || !ShellState.show-conversation; }
            browser := Rectangle {
                x: ShellState.narrow ? 0px : ShellState.rail-width; y: 0px;
                height: parent.height - (ShellState.narrow ? 48px : 0px);
                visible: (!ShellState.narrow || !ShellState.show-conversation);
                width: ShellState.narrow ? ShellState.window-width : ShellState.browser-width;
                horizontal-stretch: 0;
                background: Tokens.alternate-background; clip: true;
                friends-host := Rectangle { visible: ShellState.section == Section.friends; friends-surface := Friends {} }
                chats-host := Rectangle { visible: ShellState.section == Section.chats; chats-surface := Chats {} }
            }

            conversation-host := Rectangle { x: ShellState.narrow ? 0px : browser.x + browser.width; width: max(0px, parent.width - self.x - (!ShellState.profile-sheet && DetailState.detail-open ? ShellState.panel-width : 0px)); height: parent.height; visible: ((ShellState.account-mid != "") || ConversationState.has-chat) && (!ShellState.narrow || ShellState.show-conversation) && !(DetailState.detail-open && ShellState.profile-sheet); conversation := Conversation {} }
        }
        layers := Layers {}
        NewChat { width: parent.width; height: parent.height; }

        Attachments { }
        RecoveryDialog { }
    }
    rich-metrics := TextMetrics {}
}
