export { State } from "state.slint";
import { Button, LineEdit, TextEdit, ScrollView, ComboBox } from "std-widgets.slint";
import { State } from "state.slint";
import { Tokens } from "tokens.slint";
import { ChatRow, FriendRow, MessageRow, ReactionRow } from "types.slint";
import { Pane } from "scrollpane.slint";
export { ChatRow, FriendRow, MessageRow, ReactionRow, MessageKind, LinkRow } from "types.slint";
import { Rail } from "rail.slint";
import { Friends } from "friends.slint";
import { Chats } from "chats.slint";
import { Conversation } from "conversation.slint";
import { Sheets } from "sheets.slint";

export component AppWindow inherits Window {
    in property <bool> migration-needed;
    in property <string> migration-error;
    in-out property <string> desktop-warning <=> State.desktop-warning;
    in-out property <string> connection-status <=> State.connection-status;
    callback migration-choice(bool);
    public function go-back() { if root.narrow && root.show-conversation && !root.auth-open && !root.settings-open && !root.viewer-open && !root.profile-open && !root.migration-needed { root.show-conversation = false; if root.section == 1 { root.focus-friend-search(); } else { root.focus-search(); } } }
    in-out property <int> section <=> State.section;
    in-out property <[FriendRow]> friends <=> State.friends;
    in-out property <int> friend-result <=> State.friend-result;
    out property <length> friend-row-height <=> State.friend-row-height;
    in-out property <string> friend-query <=> State.friend-query;
    in-out property <bool> groups-expanded <=> State.groups-expanded;
    in-out property <bool> friends-expanded <=> State.friends-expanded;
    in-out property <length> friends-y <=> State.friends-y;
    in-out property <bool> loading-friends <=> State.loading-friends;
    in-out property <string> friends-error <=> State.friends-error;
    in-out property <bool> profile-open <=> State.profile-open;
    in-out property <string> profile-name <=> State.profile-name;
    in-out property <string> profile-id <=> State.profile-id;
    in-out property <string> profile-status <=> State.profile-status;
    in-out property <bool> profile-group <=> State.profile-group;
    in-out property <image> profile-avatar <=> State.profile-avatar;
    in-out property <bool> profile-available <=> State.profile-available;
    callback browse(int); callback refresh-friends(); callback filter-friends();
    callback open-profile(string); callback start-friend-chat();
    public function show-profile() { root.profile-open = true; State.focus-profile-close(); }
    public function close-profile() { root.profile-open = false; State.focus-friend-search(); }
    in-out property <bool> ime-active <=> State.ime-active;
    public function focus-composer() { conversation.focus-editor(); }
    title: root.demo ? "LINE (preview)" : "LINE";
    icon: @image-url("../assets/icon.svg");
    preferred-width: 980px; preferred-height: 720px;
    min-width: 360px; min-height: 520px;
    background: Tokens.background;
    default-font-size: Tokens.base;
    in-out property <int> text-size <=> State.text-size;
    in-out property <[ChatRow]> chats <=> State.chats;
    in-out property <[MessageRow]> messages <=> State.messages;
    in-out property <int> selected-chat <=> State.selected-chat;
    in-out property <string> chat-title <=> State.chat-title;
    in-out property <string> chat-subtitle <=> State.chat-subtitle;
    in-out property <string> draft <=> State.draft;
    in-out property <bool> can-send <=> State.can-send;
    in-out property <string> send-reason <=> State.send-reason;
    in-out property <bool> list-pressed <=> State.list-pressed;
    property <bool> list-release-pending <=> State.list-release-pending;
    out property <length> chat-row-height <=> State.chat-row-height;
    Timer { interval: 1ms; running: root.list-release-pending; triggered => { root.list-release-pending = false; root.release-deferred(); } }
    in-out property <bool> settings-open <=> State.settings-open;
    in-out property <bool> viewer-open <=> State.viewer-open;
    in-out property <image> viewer-image <=> State.viewer-image;
    in-out property <string> viewer-status <=> State.viewer-status;
    in-out property <string> viewer-error <=> State.viewer-error;
    in-out property <bool> viewer-loading <=> State.viewer-loading;
    in-out property <string> viewer-key <=> State.viewer-key;
    property <float> viewer-zoom <=> State.viewer-zoom;
    callback open-photo(string); callback photo-closed();
    public function show-viewer(key: string) { root.viewer-open = true; root.viewer-key = key; root.viewer-zoom = 1; State.reset-viewer(); State.focus-viewer-close(); }
    public function close-viewer() { root.viewer-open = false; State.focus-history(); root.photo-closed(); }
    in-out property <bool> connected <=> State.connected;
    in-out property <bool> connection-failed <=> State.connection-failed;
    in-out property <bool> retrying-connection <=> State.retrying-connection;
    in-out property <bool> auth-open <=> State.auth-open;
    in-out property <bool> auth-busy <=> State.auth-busy;
    in-out property <bool> auth-cancelling <=> State.auth-cancelling;
    in-out property <image> auth-qr <=> State.auth-qr;
    in-out property <string> auth-pin <=> State.auth-pin;
    in-out property <string> auth-stage <=> State.auth-stage;
    in-out property <string> auth-error <=> State.auth-error;
    callback reconnect(); callback start-sign-in(); callback cancel-sign-in();
    public function account-ready() { root.auth-open = false; root.show-conversation = false; State.focus-search(); }
    public function close-sign-in() { root.auth-open = false; State.focus-sign-in-opener(); }
    public function open-sign-in() { root.auth-open = true; State.focus-auth-start(); }

    in-out property <bool> sending <=> State.sending;
    in-out property <bool> demo <=> State.demo;
    in-out property <bool> more-chats <=> State.more-chats;
    in-out property <bool> has-chat <=> State.has-chat;
    in-out property <bool> loading-chats <=> State.loading-chats;
    in-out property <bool> loading-history <=> State.loading-history;
    in-out property <string> history-error <=> State.history-error;
    in-out property <string> list-error <=> State.list-error;
    in-out property <string> storage-error <=> State.storage-error;
    in-out property <bool> storage-retryable <=> State.storage-retryable;
    in-out property <string> account-name <=> State.account-name;
    in-out property <bool> show-conversation <=> State.show-conversation;
    in-out property <bool> following <=> State.following;
    in-out property <int> new-count <=> State.new-count;
    in-out property <length> history-y <=> State.history-y;
    out property <bool> history-dragging <=> State.history-dragging;
    changed history-dragging => { if !root.history-dragging { root.release-deferred(); } }
    in-out property <string> query <=> State.query;
    in-out property <length> list-y <=> State.list-y;
    in-out property <length> editor-y <=> State.editor-y;
    property <length> search-list-y <=> State.search-list-y;
    property <bool> searching <=> State.searching;
    property <int> result-focus <=> State.result-focus;
    property <bool> narrow <=> State.narrow;
    property <string> anchor-id <=> State.anchor-id;
    property <length> anchor-screen-y <=> State.anchor-screen-y;
    property <bool> capture-anchor <=> State.capture-anchor;
    property <length> restore-y <=> State.restore-y;
    property <bool> restore-pending <=> State.restore-pending;
    callback select-chat(int);
    callback search-changed(string);
    callback draft-edited();
    callback refresh(); callback retry-history(); callback more(); callback send();
    callback settings-changed(); callback retry-storage(); callback recover-message(string); callback demo-event(int); callback release-deferred();
    public function show-history(y: length, latest: bool) {
        root.anchor-id = "";
        root.following = latest;
        root.restore-y = y;
        root.restore-pending = true;
    }
    public function latest() { root.following = true; root.new-count = 0; conversation.jump(-State.history-extent); root.capture-anchor = true; }
    Timer { interval: 16ms; running: root.capture-anchor; triggered => { root.capture-anchor = false; } }
    Timer {
        interval: 1ms; running: root.restore-pending;
        triggered => {
            root.capture-anchor = true;
            conversation.jump(root.following ? -State.history-extent : root.restore-y);
            root.restore-pending = false;
        }
    }
    auth-notice := Rectangle {
        x: 0px; y: 0px; width: root.width;
        height: root.connection-failed && !root.auth-open ? 116px : 0px;
        visible: root.connection-failed && !root.auth-open;
        background: Tokens.alternate-background;
        VerticalLayout {
            padding: 12px; spacing: 8px;
            Text { text: root.connection-status != "" ? root.connection-status : root.retrying-connection ? "Reconnecting to your saved account…" : "Connection needs attention. Retry, or sign in again if your login has expired."; font-size: Tokens.small; color: Tokens.foreground; wrap: word-wrap; }
            HorizontalLayout {
                Button { text: "Retry"; accessible-label: "Retry connection"; enabled: !root.retrying-connection && !root.auth-busy; clicked => { root.reconnect(); } }
                sign-in-opener := Button { text: "Sign in again"; enabled: !root.retrying-connection && !root.auth-busy; clicked => { root.open-sign-in(); } }
            }
        }
    }
    FocusScope {
        key-pressed(event) => { if !root.ime-active && event.modifiers.alt && event.text == Key.LeftArrow { root.go-back(); return accept; } reject }
        y: auth-notice.height;
        width: 100%; height: root.height - auth-notice.height;
        visible: !root.auth-open && !root.settings-open && !root.viewer-open && !root.profile-open && !root.migration-needed;
        rail := Rail { x: 0px; y: root.narrow ? parent.height - 48px : 0px; width: root.narrow ? parent.width : 56px; height: root.narrow ? 48px : parent.height; visible: !root.narrow || !root.show-conversation; }
        browser := Rectangle {
            x: root.narrow ? 0px : 56px; y: 0px;
            height: parent.height - (root.narrow ? 48px : 0px);
            visible: !State.narrow || !State.show-conversation;
            width: !self.visible ? 0px : State.narrow ? State.window-width : 286px;
            horizontal-stretch: 0;
            background: Tokens.alternate-background; clip: true;
 friends-surface := Friends {}
 chats-surface := Chats {}
}

        conversation := Conversation { x: root.narrow ? 0px : browser.x + browser.width; width: parent.width - self.x; height: parent.height; visible: !root.narrow || root.show-conversation; }
    }
    property <length> token-base: root.text-size * 1px;
    changed token-base => { Tokens.base = root.token-base; }
    property <length> state-window-width: root.width;
    changed state-window-width => { State.window-width = root.width; }
    init => { State.window-width = root.width; Tokens.base = root.text-size * 1px; }
    public function focus-search() { chats-surface.focus-search(); }
    public function focus-friend-search() { friends-surface.focus-search(); }
    public function focus-settings-opener() { rail.focus-navigation(); }
    public function focus-settings-close() { sheets.focus-settings(); }
    public function focus-profile-close() { sheets.focus-profile(); }
    public function focus-auth-start() { sheets.focus-auth(); }
    public function focus-viewer-close() { sheets.focus-viewer(); }
    public function focus-history() { conversation.focus-history(); }
    public function focus-sign-in-opener() { sign-in-opener.focus(); }
    public function reset-viewer() { sheets.reset-viewer(); }
    public function history-jump(y: length) { conversation.jump(y); }
    sheets := Sheets {}
    Rectangle {
        width: 100%; height: 100%; visible: root.migration-needed; background: Tokens.background;
        VerticalLayout {
            padding: 24px; spacing: 16px; alignment: center;
            Text { text: "Existing local files"; font-size: Tokens.heading; wrap: word-wrap; }
            Text { text: "Use the session and local drafts already on this device, or start with new app folders. Existing files stay in place."; wrap: word-wrap; }
            Button { text: "Use existing files"; clicked => { root.migration-choice(true); } }
            Button { text: "Start fresh"; clicked => { root.migration-choice(false); } }
            if root.migration-error != "": Text { text: root.migration-error; color: Tokens.danger; wrap: word-wrap; }
        }
    }
}
