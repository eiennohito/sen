export { State } from "state.slint";
export { Palette } from "std-widgets.slint";
import { Button, LineEdit, TextEdit, ScrollView, ComboBox, Palette } from "std-widgets.slint";
import { State } from "state.slint";
import { Tokens } from "tokens.slint";
import { TextMetrics, RichMetric } from "text-metrics.slint";
export { RichMetric } from "text-metrics.slint";
import { ChatRow, MemberRow, FriendRow, MessageRow, ReactionRow } from "types.slint";
import { Pane } from "scrollpane.slint";
export { ChatRow, MemberRow, FriendRow, MessageRow, ReactionRow, MessageKind, LinkRow, RichRun } from "types.slint";
import { Rail } from "rail.slint";
import { Friends } from "friends.slint";
import { Chats } from "chats.slint";
import { Conversation } from "conversation.slint";
import { Layers } from "layers.slint";
import { RecoveryDialog } from "recovery-dialog.slint";
export { FeedbackRect } from "connection-notice.slint";
import { ConnectionNotice, FeedbackRect } from "connection-notice.slint";
import { DemoScenarios } from "demo-scenarios.slint";

export component AppWindow inherits Window {
    public function connection-status-text() -> string { return auth-notice.compact-status; }
    public function connection-actions-fit() -> bool { return auth-notice.actions-fit(); }
    public function connection-obstacles() -> [FeedbackRect] {
        return [
            { x: rail.absolute-position.x, y: rail.absolute-position.y, width: rail.visible && shell.visible ? rail.width : 0px, height: rail.height },
            { x: browser.absolute-position.x, y: browser.absolute-position.y, width: browser.visible && shell.visible ? browser.width : 0px, height: root.narrow ? State.connection-area-y : browser.height },
            conversation.header-bounds, conversation.composer-bounds, layers.profile-bounds, conversation.feedback-bounds, conversation.older-retry-bounds, chats-surface.visible-first-row-bounds
        ];
    }
    public function connection-first-row() -> FeedbackRect { return chats-surface.first-row-bounds; }
    public function list-scroll(delta: length) { chats-surface.scroll(delta); }
    public function list-jump(y: length) { chats-surface.jump(y); }
    public function preview-dark(dark: bool) { if State.demo { Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light; } }
    rich-metrics := TextMetrics {}
    public function measure-rich(content: string, size: float) -> RichMetric { return rich-metrics.measure(content, size); }
    in property <bool> migration-needed;
    in property <string> migration-error;
    in-out property <string> desktop-warning <=> State.desktop-warning;
    in-out property <string> connection-status <=> State.connection-status;
    callback migration-choice(bool);
    public function go-back() { if root.narrow && root.show-conversation && !State.modal-open && !root.migration-needed { root.show-conversation = false; if root.section == 1 { root.focus-friend-search(); } else { root.focus-search(); } } }
    in-out property <int> section <=> State.section;
    in-out property <[FriendRow]> friends <=> State.friends;
    in-out property <int> friend-result <=> State.friend-result;
    out property <length> friend-row-height <=> State.friend-row-height;
    in-out property <string> friend-query <=> State.friend-query;
    in-out property <bool> groups-expanded <=> State.groups-expanded;
    in-out property <bool> friends-expanded <=> State.friends-expanded;
    in-out property <length> friends-y <=> State.friends-y;
    in-out property <bool> loading-friends <=> State.loading-friends;
    in-out property <string> friends-error <=> State.friends-error;
    in-out property <bool> members-open <=> State.members-open;
    in-out property <bool> member-profile <=> State.member-profile;
    in-out property <[MemberRow]> members <=> State.members;
    in-out property <string> member-query <=> State.member-query;
    in-out property <bool> members-loading <=> State.members-loading;
    in-out property <bool> members-failed <=> State.members-failed;
    in-out property <bool> chat-group <=> State.chat-group;
    in-out property <int> member-count <=> State.member-count;
    callback open-members(); callback filter-members(); callback open-member(string);
    public function back-to-members() { layers.back-to-members(); }
    public function focus-chat-header() { conversation.focus-header(); }
    public function focus-members-header() { conversation.focus-members(); }
    in-out property <bool> profile-open <=> State.profile-open;
    in-out property <string> profile-name <=> State.profile-name;
    in-out property <string> profile-id <=> State.profile-id;
    in-out property <string> profile-status <=> State.profile-status;
    in-out property <bool> profile-group <=> State.profile-group;
    in-out property <image> profile-avatar <=> State.profile-avatar;
    in-out property <bool> profile-available <=> State.profile-available;
    in-out property <int> category <=> State.category;
    callback filter-category(); callback switch-chat(int);
    callback browse(int); callback refresh-friends(); callback filter-friends();
    callback open-profile(string); callback start-friend-chat();
    public function show-profile() { root.profile-open = true; State.focus-profile-close(); }
    public function close-profile() { if root.members-open { root.profile-open = false; conversation.focus-members(); } else { root.profile-open = false; State.focus-friend-list(); } }
    in-out property <bool> ime-active <=> State.ime-active;
    public function focus-composer() { if root.profile-open && State.profile-sheet { State.focus-profile-close(); } else { conversation.focus-editor(); } }
    public function focus-reading-before-editor() { conversation.focus-reading-before-editor(); }
    title: root.demo ? "LINE (preview · F12: scenarios)" : State.unread-conversations > 0 && !State.unread-stale ? "LINE (" + State.unread-conversations + ")" : "LINE";
    icon: @image-url("../assets/icon.svg");
    forward-focus: shell;
    preferred-width: 980px; preferred-height: 720px;
    min-width: 360px; min-height: 520px;
    background: Tokens.background;
    default-font-size: Tokens.base;
    in-out property <int> text-size <=> State.text-size;
    in-out property <[ChatRow]> chats <=> State.chats;
    in-out property <[MessageRow]> messages <=> State.messages;
    in-out property <int> selected-chat <=> State.selected-chat;
    in-out property <string> chat-title <=> State.chat-title;
    in-out property <string> chat-subtitle <=> State.chat-subtitle;
    in-out property <string> draft <=> State.draft;
    in-out property <bool> enter-sends <=> State.enter-sends;
    in-out property <int> editor-caret <=> State.editor-caret;
    in-out property <int> editor-anchor <=> State.editor-anchor;
    in-out property <bool> composer-focused <=> State.composer-focused;
    in-out property <string> recovery-kind <=> State.recovery-kind;
    in-out property <string> recovery-id <=> State.recovery-id;
    in-out property <string> recovery-focus-id <=> State.recovery-focus-id;
    in-out property <string> recovery-focus-action <=> State.recovery-focus-action;
    callback retry-message(string);
    callback resolve-recovery(string);
    callback quit();
    public function restore-editor(anchor: int, caret: int) { conversation.restore-editor(anchor, caret); }
    in-out property <bool> can-send <=> State.can-send;
    in-out property <string> send-reason <=> State.send-reason;
    in-out property <bool> list-pressed <=> State.list-pressed;
    property <bool> list-release-pending <=> State.list-release-pending;
    out property <length> chat-row-height <=> State.chat-row-height;
    Timer { interval: 1ms; running: root.list-release-pending; triggered => { root.list-release-pending = false; root.release-deferred(); } }
    in-out property <bool> settings-open <=> State.settings-open;
    in-out property <bool> viewer-open <=> State.viewer-open;
    in-out property <image> viewer-image <=> State.viewer-image;
    in-out property <string> viewer-status <=> State.viewer-status;
    in-out property <string> viewer-error <=> State.viewer-error;
    in-out property <bool> viewer-loading <=> State.viewer-loading;
    in-out property <string> viewer-key <=> State.viewer-key;
    property <float> viewer-zoom <=> State.viewer-zoom;
    callback open-photo(string); callback photo-closed();
    public function show-viewer(key: string) { root.viewer-open = true; root.viewer-key = key; root.viewer-zoom = 1; State.reset-viewer(); State.focus-viewer-close(); }
    public function close-viewer() { root.viewer-open = false; State.focus-history(); State.viewer-return-key = root.viewer-key; State.viewer-return-serial += 1; root.viewer-key = ""; root.photo-closed(); }
    in-out property <bool> connected <=> State.connected;
    in-out property <bool> connection-failed <=> State.connection-failed;
    in-out property <bool> auth-expired <=> State.auth-expired;
    in-out property <bool> session-unavailable <=> State.session-unavailable;
    in-out property <bool> retrying-connection <=> State.retrying-connection;
    in-out property <bool> auth-open <=> State.auth-open;
    in-out property <bool> auth-busy <=> State.auth-busy;
    in-out property <bool> auth-cancelling <=> State.auth-cancelling;
    in-out property <image> auth-qr <=> State.auth-qr;
    in-out property <string> auth-pin <=> State.auth-pin;
    in-out property <string> auth-stage <=> State.auth-stage;
    in-out property <string> auth-error <=> State.auth-error;
    callback reconnect(); callback start-sign-in(); callback cancel-sign-in();
    public function account-ready() { root.auth-open = false; root.show-conversation = false; State.focus-search(); }
    public function close-settings() { root.settings-open = false; State.focus-settings-opener(); }
    public function close-sign-in() { root.auth-open = false; State.focus-sign-in-opener(); }
    public function open-sign-in() { if State.sign-in-available { root.auth-open = true; State.focus-auth-start(); } }

    in-out property <bool> demo <=> State.demo;
    in-out property <bool> more-chats <=> State.more-chats;
    in-out property <bool> has-chat <=> State.has-chat;
    in-out property <bool> loading-chats <=> State.loading-chats;
    in-out property <bool> loading-history <=> State.loading-history;
    in-out property <string> history-error <=> State.history-error;
    in-out property <string> list-error <=> State.list-error;
    in-out property <string> storage-error <=> State.storage-error;
    in-out property <bool> storage-retryable <=> State.storage-retryable;
    in-out property <string> account-name <=> State.account-name;
    in-out property <bool> show-conversation <=> State.show-conversation;
    in-out property <bool> following <=> State.following;
    in-out property <int> new-count <=> State.new-count;
    in-out property <length> history-y <=> State.history-y;
    out property <bool> history-dragging <=> State.history-dragging;
    changed history-dragging => { if !root.history-dragging { State.release-deferred(); } }
    in-out property <string> query <=> State.query;
    in-out property <length> list-y <=> State.list-y;
    in-out property <length> editor-y <=> State.editor-y;
    property <length> search-list-y <=> State.search-list-y;
    property <bool> searching <=> State.searching;
    in-out property <int> result-focus <=> State.result-focus;
    property <bool> narrow <=> State.narrow;
    callback select-chat(int);
    callback search-changed(string);
    callback draft-edited();
    callback retry-image(string); callback retry-list(); callback retry-history(); callback more(); callback send();
    callback settings-changed(); callback retry-storage(); callback recover-message(string); callback demo-event(int); callback release-deferred();
    public function show-history(y: length, latest: bool) {
        root.following = latest;
        root.history-y = y;
        if latest { conversation.jump(-State.history-extent); }
    }
    public function latest() {
        State.latest-request();
        root.following = true;
        root.new-count = 0;
        conversation.jump(-State.history-extent);
    }
    shell := FocusScope {
        focus-on-tab-navigation: false;
        key-pressed(event) => { if root.demo && !State.modal-open && event.text == Key.F12 { scenarios.open(); return accept; } if State.browser-key(event) == accept { return accept; } if !root.ime-active && event.modifiers.alt && event.text == Key.LeftArrow { root.go-back(); return accept; } reject }
        y: 0px;
        width: 100%; height: root.height;
        visible: !root.auth-open && !root.viewer-open && !(root.narrow && root.profile-open) && !root.migration-needed;
        rail := Rail { x: 0px; y: root.narrow ? parent.height - 48px : 0px; width: root.narrow ? parent.width : State.rail-width; height: root.narrow ? 48px : parent.height; visible: !root.narrow || !root.show-conversation; }
        browser := Rectangle {
            x: root.narrow ? 0px : State.rail-width; y: 0px;
            height: parent.height - (root.narrow ? 48px : 0px);
            visible: (!State.narrow || !State.show-conversation);
            width: !self.visible ? 0px : State.narrow ? State.window-width : State.browser-width;
            horizontal-stretch: 0;
            background: Tokens.alternate-background; clip: true;
 friends-surface := Friends {}
 chats-surface := Chats {}
}

        conversation := Conversation { x: root.narrow ? 0px : browser.x + browser.width; width: max(0px, parent.width - self.x - (!State.profile-sheet && root.profile-open ? State.panel-width : 0px)); height: parent.height; visible: (!root.narrow || root.show-conversation) && !(root.profile-open && State.profile-sheet); }
    }
    property <length> token-base: root.text-size * 1px;
    changed token-base => { Tokens.base = root.token-base; }
    property <length> state-window-width: root.width;
    changed state-window-width => {
        State.browser-focus-hidden = State.window-width >= State.narrow-width && root.width < State.narrow-width && root.show-conversation && (rail.has-focus || (root.section == 1 ? friends-surface.has-focus : chats-surface.has-focus));
        State.window-width = root.width;
    }
    init => { State.window-width = root.width; Tokens.base = root.text-size * 1px; }
    out property <length> chat-list-height: chats-surface.viewport-height;
    public function reveal-chat(index: int) { chats-surface.reveal(index); }
    public function focus-cycle-end() {
        if root.profile-open { layers.focus-profile-last(); }
        else if !root.narrow || root.show-conversation { conversation.focus-last(); }
        else if root.section == 1 { friends-surface.focus-list(); }
        else { chats-surface.focus-list(); }
    }
    public function focus-after-browser() {
        if root.profile-open && State.profile-sheet { if root.members-open && State.connection-actions-enabled { auth-notice.focus-first(); } else { layers.focus-profile(); } }
        else if root.narrow && !root.show-conversation { rail.focus-navigation(); }
        else { conversation.focus-first(); }
    }
    public function focus-after-conversation() {
        if root.profile-open { layers.focus-profile(); }
        else if root.narrow { conversation.focus-first(); }
        else { rail.focus-navigation(); }
    }
    public function focus-before-layer() {
        if State.profile-sheet && root.members-open && State.connection-actions-enabled { auth-notice.focus-action(); }
        else if State.narrow { layers.focus-profile-last(); }
        else if !State.profile-sheet { conversation.focus-last(); }
        else if root.section == 1 { friends-surface.focus-list(); }
        else { chats-surface.focus-list(); }
    }
    public function focus-after-layer() {
        if State.narrow { if root.members-open && State.connection-actions-enabled { auth-notice.focus-first(); } else { layers.focus-profile(); } }
        else { rail.focus-navigation(); }
    }
    public function focus-search() { chats-surface.focus-search(); }
    public function focus-chat-list() { chats-surface.focus-list(); }
    public function focus-friend-list() { friends-surface.focus-list(); }
    public function focus-friend-search() { friends-surface.focus-search(); }
    public function focus-settings-opener() { rail.focus-navigation(); }
    public function focus-settings-close() { layers.focus-settings(); }
    public function focus-profile-close() { layers.focus-profile(); }
    public function focus-auth-start() { layers.focus-auth(); }
    public function focus-viewer-close() { layers.focus-viewer(); }
    public function focus-history() { if root.profile-open && State.profile-sheet { State.focus-profile-close(); } else { conversation.focus-history(); } }
    public function focus-connection-first() { auth-notice.focus-first(); }
    public function focus-sign-in-opener() { auth-notice.focus-action(); }
    public function reset-viewer() { layers.reset-viewer(); }
    public function history-scroll(delta: length) { conversation.scroll(delta); }
    public function history-jump(y: length) { conversation.jump(y); }
    layers := Layers {}
    auth-notice := ConnectionNotice {
        x: State.connection-area-x; y: State.connection-area-y;
        width: State.connection-area-width;
        visible: State.connection-feedback-visible && !root.migration-needed;
        scenarios-requested => { scenarios.open(); }
        leave(back) => {
            if root.profile-open && State.profile-sheet && root.members-open {
                if !back { layers.focus-profile(); }
                else if root.narrow { layers.focus-profile-last(); }
                else if root.section == 1 { friends-surface.focus-list(); }
                else { chats-surface.focus-list(); }
            } else if !root.narrow || root.show-conversation {
                if back { conversation.focus-header(); } else { conversation.focus-history(); }
            } else if root.section == 1 {
                if back { friends-surface.focus-search-last(); } else { friends-surface.focus-list(); }
            } else {
                if back { chats-surface.focus-search-last(); } else { chats-surface.focus-list(); }
            }
        }
    }
    Rectangle {
        width: 100%; height: 100%; visible: root.migration-needed; background: Tokens.background;
        VerticalLayout {
            padding: 24px; spacing: 16px; alignment: center;
            Text { text: "Existing local files"; font-size: Tokens.heading; wrap: word-wrap; }
            Text { text: "Use the session and local drafts already on this device, or start with new app folders. Existing files stay in place."; wrap: word-wrap; }
            Button { text: "Use existing files"; clicked => { root.migration-choice(true); } }
            Button { text: "Start fresh"; clicked => { root.migration-choice(false); } }
            if root.migration-error != "": Text { text: root.migration-error; color: Tokens.danger; wrap: word-wrap; }
        }
    }
    RecoveryDialog { }
    scenarios := DemoScenarios { scenario-selected => { shell.focus(); } }
}
