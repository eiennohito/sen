import { ShellState } from "globals.slint";
import { ConnectionNotice } from "connection-notice.slint";
import { Tokens } from "tokens.slint";
export component Pane inherits Rectangle {
    in property <bool> virtual: false;
    in property <length> virtual-height;
    in property <length> full-height: -1px;
    in property <bool> connection-feedback: false;
    out property <length> inset <=> root.cover-height;
    property <length> cover-height: root.connection-feedback && ShellState.connection-feedback-visible ? ShellState.connection-notice-height : 0px;
    property <length> residual;
    out property <length> visible-top: root.cover-height + root.residual;
    out property <length> visible-height: max(0px, root.height - root.visible-top);
    property <length> previous-cover;
    changed cover-height => {
        let anchored = root.offset + root.residual + root.previous-cover - root.cover-height;
        root.offset = max(-root.extent, min(0px, anchored));
        root.residual = max(0px, anchored - root.offset);
        root.previous-cover = root.cover-height;
    }
    in-out property <length> offset: 0px;
    out property <length> extent: max(0px, (root.virtual ? root.virtual-height : content.height) - root.height) + root.cover-height;
    out property <bool> dragging: thumb-touch.pressed;
    callback scrolled();
    callback focus-requested();
    in-out property <length> content-y <=> root.offset;
    out property <length> visible-width: max(0px, root.width - 12px);
    property <bool> scrolling;
    changed offset => { root.scrolling = true; hide.restart(); if root.virtual && !root.seek-pending { root.scrolled(); } }
    hide := Timer { interval: 1s; running: root.scrolling; triggered => { root.scrolling = false; } }
    clip: true;
    property <length> seek-y;
    property <bool> seek-pending;
    seek-settle := Timer {
        interval: 0ms;
        running: root.seek-pending;
        triggered => { root.offset = max(-root.extent, min(0px, root.seek-y)); root.seek-pending = false; }
    }
    public function user-scroll() { root.seek-pending = false; root.scrolled(); }
    public function jump(y: length) {
        root.residual = 0px;
        root.seek-y = max(-root.extent, min(0px, y));
        if root.virtual { root.seek-pending = true; }
        root.offset = root.seek-y;
    }
    public function centre(top: length) { root.jump(-max(0px, top - root.visible-height / 2)); }
    public function reveal(index: int, row-height: length) {
        root.jump(root.offset);
        let top = index * row-height;
        let bottom = top + row-height;
        root.jump(top + root.offset < 0px ? -top : bottom + root.offset > root.visible-height ? root.visible-height - bottom : root.offset);
    }
    public function scroll(delta: length) {
        if root.residual > 0px {
            if delta < 0px {
                let remaining = root.residual + delta;
                root.residual = max(0px, remaining);
                root.offset = max(-root.extent, min(0px, root.offset + min(0px, remaining)));
            } else { root.offset = max(-root.extent, min(0px, root.offset + delta)); }
        } else { root.jump(root.offset + delta); }
    }
    TouchArea {
        clicked => { root.focus-requested(); }
        scroll-event(event) => {
            root.scroll(event.delta-y);
            root.scrolled();
            return accept;
        }
    }
    callback connection-dismissed();
    public function focus-connection() { notice-host.focus(); ShellState.tab-focus(false); }
    out property <bool> connection-focused;
    notice-host := FocusScope {
        x: 0px; y: 0px;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        height: root.cover-height;
        if root.connection-feedback: ConnectionNotice {
            x: 0px; y: 0px;
            changed has-focus => { root.connection-focused = self.has-focus; }
            dismissed => { root.connection-dismissed(); }
            visible: ShellState.connection-feedback-visible;
        }
    }
    viewport := Rectangle {
        y: root.visible-top; width: root.visible-width; height: root.visible-height;
        clip: root.visible-top > 0px;
        content := Rectangle {
            x: 0px; y: root.virtual ? 0px : root.offset;
            width: max(0px, root.width - 12px);
            height: root.virtual ? root.visible-height : root.full-height >= 0px ? root.full-height : self.preferred-height;
            @children
        }
    }
    track := Rectangle {
        x: parent.width - 12px; y: root.visible-top; width: 12px; height: root.visible-height;
        background: transparent;
        visible: root.extent > 0px;
        thumb := Rectangle {
            x: (parent.width - self.width) / 2; width: 6px; opacity: 0;
            animate width { duration: 120ms; easing: ease-out; }
            states [ shown when root.scrolling || thumb-touch.has-hover || thumb-touch.pressed: {
                opacity: 1; width: thumb-touch.has-hover || thumb-touch.pressed ? 10px : 6px;
                in-out { animate opacity { duration: 120ms; easing: ease-out; } }
            } ]
            height: min(track.height, max(32px, track.height * track.height / max(1px, root.height + root.extent)));
            y: (track.height - self.height) * (max(0px, min(root.extent, -root.offset)) / max(1px, root.extent));
            border-radius: 5px;
            background: Tokens.text-secondary.with-alpha(0.45);
        }
        thumb-touch := TouchArea {
            property <length> start-offset;
            property <length> start-y;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    if self.mouse-y < thumb.y || self.mouse-y > thumb.y + thumb.height {
                        root.jump(-root.extent * (self.mouse-y / track.height));
                        root.scrolled();
                    }
                    self.start-offset = root.offset;
                    self.start-y = self.mouse-y;
                }
            }
            moved => {
                if self.pressed {
                    root.jump(self.start-offset - (self.mouse-y - self.start-y) * root.extent / max(1px, track.height - thumb.height));
                    root.scrolled();
                }
            }
            scroll-event(event) => { root.scroll(event.delta-y); root.scrolled(); accept }
        }
    }
}
